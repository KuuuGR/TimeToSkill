/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Ĉi tiu ekrano listigas la kapablojn liveritajn kun la apo: la originalan aron plus erojn akceptitajn el la ellaborita kolekto. Dosieroj de pilotaj proponoj ne estas mem la katalogo.";
"theory_compendium_intro" = "Ĉiu langeto estas hora marko jam uzata de la progreso-strio. La kristalo estas la koloro de tiu marko. La teksto klarigas, kion la marko signifas kaj kion ĝi ne signifas.";
"theory_hour_unit" = "horoj";
"theory_callout_example" = "Ekzemplo";
"theory_callout_caveat" = "Averto";
"theory_callout_takeaway" = "Konkludo";
"theory_chapter_21_title" = "Transpasi la komencon";
"theory_chapter_21_lead" = "Dudek unu horoj ŝanĝas la koloron de la progreso-strio. Tio ne estas esplora trovaĵo. La plej proksima publikigita metodo estas la kadro de 20 horoj de Josh Kaufman por travivi la mallertan komencon, kaj tiuj du nombroj ne estas la sama aserto.";
"theory_chapter_21_mechanism_title" = "Metodo por la komenco";
"theory_chapter_21_mechanism" = "Kaufman traktas la komencon kiel praktikan problemon. Dividu la kapablon en pli malgrandajn partojn, lernu sufiĉe por rimarki viajn proprajn erarojn, forigu barojn, kiuj malfaciligas ekzercadon, kaj pasigu koncentritan tempon por unu rezulto. La libro prezentas tion kiel metodon de la aŭtoro por ekkomenci.";
"theory_chapter_21_example" = "Homo, kiu volas, ke tri akordoj sonu pure, povas ekzerci tiun rezulton. «Lerni la gitaron» estas pli granda celo, kaj la unuaj horoj ne decidas ĝin.";
"theory_chapter_100_title" = "Cent horoj, kiel marko de la apo";
"theory_chapter_100_lead" = "Cent horoj estas mejloŝtono de Time4Skill por jam registrita tempo. Neniu el la studoj kolektitaj en ĉi tiu kompendio difinas 100 horojn kiel la momenton, kiam iu fariĝas kompetenta.";
"theory_chapter_100_mechanism_title" = "Kion la proksima esploro fakte mezuris";
"theory_chapter_100_mechanism" = "Du linioj de laboro estas proksime de tiu periodo, sed ne mezuras ĝin en horoj. Cepeda, Pashler, Vul, Wixted kaj Rohrer trarigardis 317 eksperimentojn pri parola rememoro. En tiu literaturo, disigitaj seancoj venkis amasan lernadon, kaj la utila interspaco dependis de tio, kiom longe la materialo devis esti memorata. Lally, van Jaarsveld, Potts kaj Wardle petis volontulojn ripeti konduton de manĝado, trinkado aŭ aktiveco en la sama kunteksto. La modelita tempo por atingi 95 procentojn de la propra altebenaĵo de ĉiu persono vaste variis. Manki unu tagon ne forviŝis la kurbon.";
"theory_chapter_100_example" = "Ludi mallongan pecon en tri malsamaj tagoj montras, kiu takto vere restis en memoro. Unu longa vespero de ripetado ne respondas tiun demandon.";
"theory_chapter_100_caveat" = "La trarigardo pri interspacigo temas pri parola rememoro. La studo pri kutimoj temas pri aŭtomateco de elektita konduto, kaj ĝia intervalo estis 18 ĝis 254 tagoj en la modelo raportita kun la artikolo, ne linio de kompetento je 100 horoj. Neniu el la rezultoj diras, ke 100 horoj faras iun kompetenta pri fotografio, stirado aŭ iu alia kapablo.";
"theory_chapter_100_takeaway" = "Uzu la markon por rimarki, ĉu vi revenas. Ne traktu ĝin kiel nivelon, kiun vi gajnis.";
"theory_chapter_1000_title" = "Ekzercado celita al unu manko";
"theory_chapter_1000_lead" = "La kristalo de 1 000 horoj registras pasigitan tempon. Ĝi ne signifas, ke la persono nun estas profesiulo, instruisto aŭ iu, kiu povas vivi de la kapablo.";
"theory_chapter_1000_mechanism_title" = "Intenca ekzercado, kaj kiom ĝi klarigis";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe kaj Tesch-Römer priskribis intencan ekzercadon kiel agadon aranĝitan por plibonigi konkretan aspekton, kun retrokuplo kaj korekto, anstataŭ simple ripeti tion, kio jam estas komforta. Ilia artikolo de 1993 ellaboris tiun kadron per studoj pri muzikistoj. Ĝi ne publikigis unu nombron da horoj, kiu kreas fakulojn en ĉiu fako. Macnamara, Hambrick kaj Oswald poste taksis, kiom de la diferenco de agado rilatis al intenca ekzercado. La partoj diferencis laŭ fako: pli altaj en ludoj, muziko kaj sporto ol en edukado kaj profesioj.";
"theory_chapter_1000_example" = "Horo pasigita por la peco, kiu daŭre rompiĝas, estas alia agado ol horo da ludado de pecoj, kiuj jam iras bone. La progreso-strio registras la tempon ambaŭkaze.";
"theory_chapter_1000_caveat" = "La procentoj laŭ fako estas partoj de varianco en tiu metaanalizo de 2014. Ili ne estas la parto de kapablo, kiun homo povas lerni, nek la ŝanco de sukceso de iu. La artikolo ne starigas 1 000 horojn kiel profesian sojlon. Pli malnova vortumo en la apo, kiu traktis 1 000 horojn kiel la momenton fariĝi profesiulo, troigis la pruvojn.";
"theory_chapter_10000_title" = "Fama nombro, ne leĝo";
"theory_chapter_10000_lead" = "Dek mil horoj famiĝis kiel regulo de majstreco. La esploro, el kiu oni ĉerpis tion, ne starigis leĝon, kaj la kristalo sur ĉi tiu langeto nur identigas la plej altan horan markon montratan de la apo.";
"theory_chapter_10000_mechanism_title" = "Kiel la nombro vojaĝis";
"theory_chapter_10000_mechanism" = "Outliers (2008) de Malcolm Gladwell faris la rondan nombron vaste konata. Ĝi apogiĝis sur esploro pri eksperta agado, inkluzive de la artikolo de 1993 de Ericsson, Krampe kaj Tesch-Römer pri intenca ekzercado ĉe muzikistoj. Macnamara kaj Maitra (2019) pridiskutas, kiel tiu populara regulo diferencas de la esploro. La populara versio kunpremis komplikan argumenton en unu sojlon, kiu garantius majstrecon.";
"theory_chapter_10000_example" = "Du homoj povas registri la saman sumon kaj tamen pasigi la tempon malsame. Unu eble havis instruiston, kiu korektis konkretan mankon. La alia eble ripetis pecon, kiun li jam ludas. La sumo de horoj ne registras tiun diferencon.";
