"theory_topic_first20_title" = "La unuaj 20 horoj: transpasi la komencon";
"theory_topic_first20_summary" = "Komenci kapablon ofte frustras, ĉar ĉio estas nekonata. Josh Kaufman proponas praktikan vojon: dividi kapablon en pli malgrandajn partojn, koncentriĝi pri tio, kio gravas, forigi barojn al ekzercado kaj pasigi koncentritan tempon por pliboniĝi. Lia kadro de 20 horoj estas metoda komenco, ne scienca garantio, ke oni majstras ĉian kapablon en 20 horoj.";
"theory_topic_first20_takeaway" = "Elektu unu konkretan aferon, kiun vi volas fari pli bone post la unuaj 20 horoj.";
"theory_topic_first20_citation" = "Josh Kaufman. The First 20 Hours: How to Learn Anything… Fast! Cifereca eldono en 2013; papera eldono en 2014.";
"theory_topic_first20_context" = "Praktika kadro kaj libro de la aŭtoro, ne kontrolita scienca studo.";
"theory_topic_first20_limitation" = "La kadro de 20 horoj estas metoda komenco. Ĝi ne estas science fiksita tempo por majstri kapablon.";

"theory_topic_deliberate_title" = "Ekzerci kun celo";
"theory_topic_deliberate_summary" = "Ripeti agadon ne estas la samo kiel intence plibonigi ĝin. Elektu konkretan aspekton, ekzerciĝu kun klara celo, rimarku erarojn kaj ĝustigu la sekvan provon. Tempon indas registri, sed ankaŭ la maniero de ekzercado gravas.";
"theory_topic_deliberate_takeaway" = "Antaŭ seanco decidu, kion unu vi volas plibonigi.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe kaj Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "La artikolo ellaboris kadron de eksperta agado kaj raportis studojn pri muzikistoj, inkluzive de violonistoj kaj pianistoj.";
"theory_topic_deliberate_limitation" = "La artikolo ne fiksas unu nombron da horoj, kiu garantius majstrecon en ĉiuj kapabloj.";

"theory_topic_10k_title" = "10 000 horoj: populara regulo, ne leĝo";
"theory_topic_10k_summary" = "La regulo de 10 000 horoj populariĝis per Outliers (2008) de Malcolm Gladwell. Ĝi apogiĝis sur esploro pri eksperta agado, sed la populara versio simpligis la originalan argumenton. Ne ekzistas universala magia nombro da horoj, kiu garantius majstrecon.";
"theory_topic_10k_takeaway" = "Uzu longtempajn mejloŝtonojn por festi persiston, ne por antaŭdiri, kiam vi fariĝos fakulo.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe kaj Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara kaj Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "La regulo de 10 000 horoj populariĝis per Outliers (2008) de Malcolm Gladwell. La artikolo de 2019 pridiskutas, kiel tiu populara regulo diferencas de la esploro de 1993.";
"theory_topic_10k_limitation" = "Ericsson kaj kolegoj ne starigis universalan leĝon de majstreco je 10 000 horoj. Ne ekzistas universala nombro da horoj, kiu garantius majstrecon.";

"theory_topic_variance_title" = "Ekzercado gravas, sed ne estas ĉio";
"theory_topic_variance_summary" = "Metaanalizo de 2014 ekzamenis intencan ekzercadon en pluraj kampoj. Ĝi trovis, ke ekzercado rilatas al agado, sed ĝia kontribuo forte diferencas laŭ fako.";
"theory_topic_variance_takeaway" = "Ekzercado estas io, kion vi povas influi. La rezultoj dependas ankaŭ de aliaj faktoroj, kiuj diferencas inter agadoj.";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick kaj Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "Metaanalizo de 2014 ekzamenis intencan ekzercadon en pluraj kampoj. Ekzercado rilatis al agado, sed ĝia kontribuo forte diferencis laŭ fako.";
"theory_topic_variance_findings_intro" = "La taksita parto de diferencoj de agado, kiun klarigis intenca ekzercado en ĉi tiu analizo, estis:";
