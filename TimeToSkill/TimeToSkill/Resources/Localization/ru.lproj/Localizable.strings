"theory_topic_deliberate_context" = "Статья развила рамку экспертного исполнения и сообщила исследования музыкантов, включая скрипачей и пианистов.";
"theory_topic_deliberate_limitation" = "Статья не устанавливает одно фиксированное число часов практики, гарантирующее мастерство во всех навыках.";
"theory_topic_10k_title" = "10 000 часов: популярное правило, не закон";
"theory_topic_10k_summary" = "Правило 10 000 часов стало широко известным благодаря Outliers (2008) Малкольма Гладуэлла. Оно опиралось на исследования экспертного исполнения, но популярная версия упростила исходный аргумент. Универсального магического числа часов, гарантирующего мастерство, нет.";
"theory_topic_10k_takeaway" = "Используйте долгосрочные вехи, чтобы отмечать настойчивость, а не чтобы предсказывать, когда станете экспертом.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "Правило 10 000 часов стало широко известным благодаря Outliers (2008) Малкольма Гладуэлла. Статья 2019 года обсуждает, чем это популярное правило отличается от исследования 1993 года.";
"theory_topic_10k_limitation" = "Ericsson и коллеги не установили универсальный закон мастерства в 10 000 часов. Универсального числа часов, гарантирующего мастерство, нет.";
"theory_topic_variance_title" = "Практика важна, но это не всё";
"theory_topic_variance_summary" = "Метаанализ 2014 года изучал осознанную практику в нескольких областях. Практика была связана с результатами, но её вклад сильно различался по доменам.";
"theory_topic_variance_takeaway" = "На практику можно влиять. Результаты зависят и от других факторов, разных для разных занятий.";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick, and Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "Метаанализ 2014 года изучал осознанную практику в нескольких областях. Практика была связана с результатами, но её вклад сильно различался по доменам.";
"theory_topic_variance_findings_intro" = "Оценённая доля различий в результатах, объяснённая осознанной практикой в этом анализе:";
"theory_topic_variance_limitation" = "Эти проценты относятся к объяснённой дисперсии результатов в этом метаанализе. Это не процент навыка, который можно выучить, и не индивидуальная вероятность успеха.";
