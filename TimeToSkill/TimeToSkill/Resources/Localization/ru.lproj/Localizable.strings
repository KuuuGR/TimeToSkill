/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Этот экран показывает навыки, входящие в приложение: исходный набор и позиции из подготовленного каталога.";
"theory_compendium_intro" = "Каждая вкладка — часовая отметка, уже используемая шкалой прогресса. Кристалл — цвет этой отметки. Текст объясняет, что отметка значит и чего не значит.";
"theory_hour_unit" = "часов";
"theory_callout_example" = "Пример";
"theory_callout_caveat" = "Оговорка";
"theory_callout_takeaway" = "Вывод";
"theory_chapter_21_title" = "Пройти начало";
"theory_chapter_21_lead" = "Двадцать один час меняет цвет шкалы прогресса. Это не научный вывод. Ближайший опубликованный метод — рамка 20 часов Джоша Кауфмана, чтобы пережить неловкое начало, и эти два числа — не одно и то же утверждение.";
"theory_chapter_21_mechanism_title" = "Метод для старта";
"theory_chapter_21_mechanism" = "Кауфман рассматривает начало как практическую задачу. Разбейте навык на меньшие части, научитесь достаточно, чтобы замечать свои ошибки, уберите препятствия, мешающие практике, и уделите сосредоточенное время одному результату. Книга представляет это как метод автора для начала.";
"theory_chapter_21_example" = "Тот, кто хочет, чтобы три аккорда звучали чисто, может практиковать именно этот результат. «Выучить гитару» — более крупная цель, и первые часы её не решают.";
"theory_chapter_100_title" = "Сто часов как отметка приложения";
"theory_chapter_100_lead" = "Сто часов — веха Time4Skill для уже учтённого времени. Ни одно исследование в этом сборнике не определяет 100 часов как момент, когда человек становится компетентным.";
"theory_chapter_100_mechanism_title" = "Что на самом деле измеряли близкие исследования";
"theory_chapter_100_mechanism" = "Две линии работ близки к этому периоду, не измеряя его в часах. Cepeda, Pashler, Vul, Wixted и Rohrer рассмотрели 317 экспериментов по словесному припоминанию. Распределение сессий в той литературе побеждало зубрёжку, а полезный интервал зависел от того, как долго материал нужно помнить. Lally, van Jaarsveld, Potts и Wardle просили добровольцев повторять поведение еды, питья или активности в одном контексте. Моделируемое время до 95 процентов собственного плато каждого человека сильно различалось. Пропуск одного дня не обнулял кривую.";
"theory_chapter_100_example" = "Игра короткого фрагмента в три разных дня показывает, какой такт действительно остался в памяти. Один долгий вечер повторений на этот вопрос не отвечает.";
"theory_chapter_100_caveat" = "Обзор о распределении касается словесного припоминания. Исследование привычки — об автоматичности выбранного поведения, и диапазон в модели при статье был от 18 до 254 дней, а не линия компетентности на 100 часах. Ни один результат не говорит, что 100 часов делают кого-то компетентным в фотографии, вождении или другом навыке.";
"theory_chapter_100_takeaway" = "Используйте отметку, чтобы заметить, возвращаетесь ли вы. Не считайте её заслуженным уровнем.";
"theory_chapter_1000_title" = "Практика, нацеленная на один пробел";
"theory_chapter_1000_lead" = "Кристалл 1000 часов фиксирует потраченное время. Он не означает, что человек уже профессионал, учитель или тот, кто может зарабатывать навыком.";
"theory_chapter_1000_mechanism_title" = "Осознанная практика и сколько она объясняла";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe и Tesch-Römer описали осознанную практику как деятельность, устроенную для улучшения конкретного аспекта, с обратной связью и коррекцией, а не простое повторение уже удобного. Их статья 1993 года развивала эту рамку на исследованиях музыкантов. Она не опубликовала число часов, создающее экспертов в каждой области. Macnamara, Hambrick и Oswald позже оценили, какая доля различий в результатах связана с осознанной практикой. Доли различались по областям: выше в играх, музыке и спорте, чем в образовании и профессиях.";
"theory_chapter_1000_example" = "Час на пассаже, который всё ещё ломается, — иная деятельность, чем час игры уже хорошо получающихся пьес. Шкала прогресса записывает время в обоих случаях.";
"theory_chapter_1000_caveat" = "Проценты по областям — доли дисперсии в метаанализе 2014 года. Это не доля навыка, которую можно выучить, и не чей-то шанс успеха. Статья не устанавливает 1000 часов как профессиональный порог. Старая формулировка в приложении, где 1000 часов считались моментом становления профессионалом, преувеличивала данные.";
"theory_chapter_10000_title" = "Известное число, не закон";
"theory_chapter_10000_lead" = "Десять тысяч часов стали известны как правило мастерства. Исследования, из которых это вывели, не установили закон, а кристалл на этой вкладке лишь обозначает высшую отображаемую часовую отметку приложения.";
"theory_chapter_10000_mechanism_title" = "Как число путешествовало";
"theory_chapter_10000_mechanism" = "Outliers (2008) Малкольма Гладуэлла сделал круглое число широко известным. Оно опиралось на исследования экспертного исполнения, включая статью Ericsson, Krampe и Tesch-Römer 1993 года об осознанной практике музыкантов. Macnamara и Maitra (2019) обсуждают, чем популярное правило отличается от исследования. Популярная версия сжала сложный аргумент до одного порога, который якобы гарантирует мастерство.";
"theory_chapter_10000_example" = "Двое могут записать одну сумму и всё равно потратить время по-разному. У одного мог быть учитель, исправляющий конкретный недостаток. Другой мог повторять пьесу, которую уже играет. Сумма часов эту разницу не записывает.";
