/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Questa schermata elenca le abilità incluse nell’app: l’insieme originale più le voci del catalogo elaborato.";
"theory_compendium_intro" = "Ogni scheda è una soglia di ore già usata dalla barra di progresso. Il cristallo è il colore di quella soglia. Il testo spiega cosa significa la soglia — e cosa non significa.";
"theory_hour_unit" = "ore";
"theory_callout_example" = "Esempio";
"theory_callout_caveat" = "Avvertenza";
"theory_callout_takeaway" = "Conclusione";
"theory_chapter_21_title" = "Superare l'inizio";
"theory_chapter_21_lead" = "Ventuno ore cambiano il colore della barra di progresso. Non è un risultato di ricerca. Il metodo pubblicato più vicino è il quadro di 20 ore di Josh Kaufman per superare l'inizio scomodo, e quei due numeri non sono la stessa affermazione.";
"theory_chapter_21_mechanism_title" = "Un metodo per partire";
"theory_chapter_21_mechanism" = "Kaufman tratta l'inizio come un problema pratico. Suddividi l'abilità in parti più piccole, impara abbastanza da notare i tuoi errori, rimuovi gli ostacoli che rendono scomoda la pratica e dedica tempo concentrato a un risultato. Il libro lo presenta come metodo dell'autore per iniziare.";
"theory_chapter_21_example" = "Chi vuole che tre accordi suonino puliti può praticare proprio quel risultato. «Imparare la chitarra» è un obiettivo più ampio, e le prime ore non lo risolvono.";
"theory_chapter_100_title" = "Cento ore come soglia dell'app";
"theory_chapter_100_lead" = "Cento ore sono una tappa Time4Skill per il tempo già registrato. Nessuno degli studi raccolti in questo compendio definisce 100 ore come il momento in cui qualcuno diventa competente.";
"theory_chapter_100_mechanism_title" = "Cosa ha davvero misurato la ricerca vicina";
"theory_chapter_100_mechanism" = "Due linee di lavoro stanno vicino a questo periodo senza misurarlo in ore. Cepeda, Pashler, Vul, Wixted e Rohrer hanno esaminato 317 esperimenti sul richiamo verbale. Distanziare le sessioni batteva il ripasso concentrato in quella letteratura, e l'intervallo utile dipendeva da quanto a lungo il materiale doveva essere ricordato. Lally, van Jaarsveld, Potts e Wardle hanno chiesto a volontari di ripetere un comportamento di mangiare, bere o attività nello stesso contesto. Il tempo modellato per raggiungere il 95 percento del plateau di ciascuna persona variava ampiamente. Saltare un giorno non cancellava la curva.";
"theory_chapter_100_example" = "Suonare un pezzo breve in tre giorni diversi mostra quale battuta è davvero rimasta in memoria. Una lunga serata di ripetizione non risponde a quella domanda.";
"theory_chapter_100_caveat" = "La rassegna sulla spaziatura riguarda il richiamo verbale. Lo studio sulle abitudini riguarda l'automaticità di un comportamento scelto, e l'intervallo nel modello riportato con l'articolo era da 18 a 254 giorni, non una linea di competenza a 100 ore. Nessun risultato dice che 100 ore rendano competenti in fotografia, guida o qualsiasi altra abilità.";
"theory_chapter_100_takeaway" = "Usa la soglia per notare se stai tornando. Non trattarla come un livello guadagnato.";
"theory_chapter_1000_title" = "Pratica mirata a una lacuna";
"theory_chapter_1000_lead" = "Il cristallo delle 1.000 ore registra il tempo trascorso. Non significa che la persona sia ora un professionista, un insegnante o qualcuno che può vivere di quell'abilità.";
"theory_chapter_1000_mechanism_title" = "La pratica deliberata e quanto spiegava";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe e Tesch-Römer hanno descritto la pratica deliberata come attività organizzata per migliorare un aspetto specifico, con feedback e correzione, invece di ripetere semplicemente ciò che è già comodo. Il loro articolo del 1993 ha sviluppato quel quadro con studi su musicisti. Non ha pubblicato un conteggio di ore che crea esperti in ogni campo. Macnamara, Hambrick e Oswald hanno poi stimato quanto della differenza di prestazione era associato alla pratica deliberata. Le quote differivano per dominio: più alte nei giochi, nella musica e nello sport che nell'istruzione e nelle professioni.";
"theory_chapter_1000_example" = "Un'ora sul passaggio che continua a rompersi è un'attività diversa da un'ora di pezzi che già vanno bene. La barra di progresso registra il tempo in entrambi i casi.";
"theory_chapter_1000_caveat" = "Le percentuali per dominio sono quote di varianza in quella meta-analisi del 2014. Non sono la porzione di abilità che una persona può imparare, né la probabilità di successo di qualcuno. L'articolo non fissa 1.000 ore come soglia professionale. Una vecchia formulazione dell'app che trattava 1.000 ore come il momento di diventare professionisti esagerava le prove.";
"theory_chapter_10000_title" = "Un numero famoso, non una legge";
"theory_chapter_10000_lead" = "Diecimila ore sono diventate famose come regola di maestria. La ricerca da cui furono tratte non ha stabilito una legge, e il cristallo di questa scheda identifica solo la soglia di ore più alta mostrata dall'app.";
"theory_chapter_10000_mechanism_title" = "Come il numero ha viaggiato";
"theory_chapter_10000_mechanism" = "Outliers (2008) di Malcolm Gladwell ha reso ampiamente noto il numero tondo. Si basava sulla ricerca sulla prestazione esperta, incluso l'articolo del 1993 di Ericsson, Krampe e Tesch-Römer sulla pratica deliberata tra i musicisti. Macnamara e Maitra (2019) discutono come quella regola popolare differisca dalla ricerca. La versione popolare ha compresso un argomento complesso in una soglia che avrebbe garantito la maestria.";
"theory_chapter_10000_example" = "Due persone possono registrare lo stesso totale e aver passato il tempo in modo diverso. Una può aver avuto un insegnante che correggeva un difetto specifico. L'altra può aver ripetuto un pezzo che già suona. Il totale di ore non registra quella differenza.";
