"theory_topic_first20_title" = "Le prime 20 ore: superare l'inizio";
"theory_topic_first20_summary" = "Iniziare un'abilità è spesso frustrante perché tutto è sconosciuto. Josh Kaufman propone un approccio pratico: spezzare l'abilità in parti più piccole, concentrarsi su ciò che conta, rimuovere gli ostacoli alla pratica e dedicare tempo concentrato a migliorare. Il suo quadro di 20 ore è un metodo di partenza, non una garanzia scientifica che qualsiasi abilità si padroneggi in 20 ore.";
"theory_topic_first20_takeaway" = "Scegli una cosa specifica che vuoi saper fare meglio dopo le tue prime 20 ore.";
"theory_topic_first20_citation" = "Josh Kaufman. The First 20 Hours: How to Learn Anything… Fast! Ebook published in 2013; paperback published in 2014.";
"theory_topic_first20_context" = "Quadro pratico e libro dell'autore, non uno studio scientifico controllato.";
"theory_topic_first20_limitation" = "Il quadro di 20 ore è un metodo di partenza. Non è un tempo scientificamente stabilito necessario per padroneggiare un'abilità.";
"theory_topic_deliberate_title" = "Praticare con uno scopo";
"theory_topic_deliberate_summary" = "Ripetere un'attività non è la stessa cosa che migliorarla deliberatamente. Scegli un aspetto specifico, pratica con un obiettivo chiaro, nota gli errori e regola il tentativo successivo. Tracciare il tempo è utile, ma conta anche il modo in cui pratichi.";
"theory_topic_deliberate_takeaway" = "Prima di una sessione, decidi una sola cosa che vuoi migliorare.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "L'articolo ha sviluppato un quadro per la prestazione esperta e ha riportato studi con musicisti, tra cui violinisti e pianisti.";
"theory_topic_deliberate_limitation" = "L'articolo non stabilisce un numero fisso di ore di pratica che garantisca la maestria in tutte le abilità.";
"theory_topic_10k_title" = "10.000 ore: una regola popolare, non una legge";
"theory_topic_10k_summary" = "La regola delle 10.000 ore è diventata ampiamente popolare tramite Outliers (2008) di Malcolm Gladwell. Attingeva alla ricerca sulla prestazione esperta, ma la versione popolare ha semplificato l'argomento originale. Non esiste un numero magico universale di ore che garantisca la maestria.";
"theory_topic_10k_takeaway" = "Usa i traguardi a lungo termine per celebrare la perseveranza, non per prevedere quando diventerai esperto.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "La regola delle 10.000 ore è diventata ampiamente popolare tramite Outliers (2008) di Malcolm Gladwell. L'articolo del 2019 discute come quella regola popolare differisca dalla ricerca del 1993.";
"theory_topic_10k_limitation" = "Ericsson e colleghi non hanno stabilito una legge universale di maestria a 10.000 ore. Non esiste un numero universale di ore che garantisca la maestria.";
"theory_topic_variance_title" = "La pratica conta, ma non è tutto";
"theory_topic_variance_summary" = "Una meta-analisi del 2014 ha esaminato la pratica deliberata in diversi campi. La pratica era associata alla prestazione, ma il suo contributo differiva sostanzialmente per dominio.";
"theory_topic_variance_takeaway" = "La pratica è qualcosa che puoi influenzare. I risultati dipendono anche da altri fattori, che differiscono tra attività.";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick, and Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "Una meta-analisi del 2014 ha esaminato la pratica deliberata in diversi campi. La pratica era associata alla prestazione, ma il suo contributo differiva sostanzialmente per dominio.";
