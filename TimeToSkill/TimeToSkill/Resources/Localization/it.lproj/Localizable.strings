"theory_topic_spacing_takeaway" = "Prova a tornare a un'abilità per diversi giorni e osserva cosa ricordi e cosa richiede più pratica.";
"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "La meta-analisi ha esaminato 317 esperimenti in 184 articoli, con 839 valutazioni di pratica distribuita.";
"theory_topic_spacing_limitation" = "Questi risultati riguardano compiti di apprendimento e richiamo. Non presentano un programma ottimale per ogni abilità fisica, sociale, artistica o professionale.";
"theory_topic_habit_title" = "Un'abitudine non ha una scadenza universale";
"theory_topic_habit_summary" = "Ripetere un'azione in un contesto coerente può renderla più automatica nel tempo. Tuttavia il tempo richiesto differisce tra persone e comportamenti. Saltare un giorno non significa che tutto il progresso sia perso.";
"theory_topic_habit_takeaway" = "Collega un'attività a una situazione che incontri regolarmente e riprendi senza sensi di colpa quando una sessione viene saltata.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "Novantasei volontari hanno scelto un comportamento alimentare, di bevanda o di attività da ripetere nello stesso contesto per 12 settimane. Ottantadue partecipanti hanno fornito dati sufficienti. Il tempo modellato per raggiungere il 95% della stima di automaticità asintotica variava da 18 a 254 giorni.";
"theory_topic_habit_limitation" = "Era uno studio sulla formazione di abitudini, non sullo studio di quante ore servano per padroneggiare un'abilità. Non sostiene una soglia di maestria a 21 ore né una regola universale di abitudine in 21 giorni.";
"theory_milestones_title" = "Traguardi di progresso";
"theory_milestones_note" = "The 100-hour, 1,000-hour, and 10,000-hour marks in Time4Skill record time you have spent. They are progress milestones, not scientifically validated stages, and they do not predict when you will become an expert.";
