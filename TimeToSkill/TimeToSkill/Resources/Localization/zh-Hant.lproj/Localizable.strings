/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "本屏幕列出应用附带的技能：原有集合以及来自已整理目录的条目。";
"theory_compendium_intro" = "每個標籤都是進度條已經使用的小時標記。水晶是該標記的顏色。文字說明這個標記意味著什麼——以及不意味著什麼。";
"theory_hour_unit" = "小時";
"theory_callout_example" = "例子";
"theory_callout_caveat" = "注意";
"theory_callout_takeaway" = "要點";
"theory_chapter_21_title" = "邁過開始階段";
"theory_chapter_21_lead" = "二十一小時會改變進度條的顏色。這不是研究發現。最接近的已發表方法是 Josh Kaufman 幫助度過尷尬開端的 20 小時框架，這兩個數字並不是同一主張。";
"theory_chapter_21_mechanism_title" = "起步方法";
"theory_chapter_21_mechanism" = "Kaufman 把開始當作實際問題。把技能拆成更小部分，學到足以察覺自己的錯誤，去掉妨礙練習的障礙，並把專注時間用在一個結果上。書中把它呈現為作者的起步方法。";
"theory_chapter_21_example" = "想讓三個和弦乾淨的人，可以專門練習這個結果。「學會吉他」是更大的目標，最初幾小時並不能決定它。";
"theory_chapter_100_title" = "作為應用標記的一百小時";
"theory_chapter_100_lead" = "一百小時是 Time4Skill 對已記錄時間的里程碑。本彙編中的研究都沒有把 100 小時定義為某人變得勝任的時刻。";
"theory_chapter_100_mechanism_title" = "相近研究實際測量了什麼";
"theory_chapter_100_mechanism" = "兩條研究線接近這段時期，但並不以小時計。Cepeda、Pashler、Vul、Wixted 與 Rohrer 回顧了 317 項言語回憶實驗。在該文獻中，分散練習優於突擊，有用的間隔取決於材料需要被記住多久。Lally、van Jaarsveld、Potts 與 Wardle 讓志願者在相同情境中重複飲食或活動行為。達到每人自身平台 95% 的建模時間差異很大。漏掉一天並不會抹掉曲線。";
"theory_chapter_100_example" = "在三個不同日子演奏一小段，能看出哪一小節真正留在記憶裡。一整晚的重複回答不了這個問題。";
"theory_chapter_100_caveat" = "關於間隔的綜述針對言語回憶。習慣研究針對所選行為的自動化，文中模型的範圍是 18 到 254 天，而不是 100 小時的勝任線。任何結果都沒有說 100 小時會讓人在攝影、駕駛或其他技能上變得勝任。";
"theory_chapter_100_takeaway" = "用這個標記留意自己是否回來練習。不要把它當成已經賺到的等級。";
"theory_chapter_1000_title" = "針對一個缺口的練習";
"theory_chapter_1000_lead" = "1000 小時水晶記錄花費的時間。它並不表示此人已成為專業人士、教師，或能靠該技能謀生的人。";
"theory_chapter_1000_mechanism_title" = "刻意練習及其解釋的份額";
"theory_chapter_1000_mechanism" = "Ericsson、Krampe 與 Tesch-Römer 將刻意練習描述為旨在改進特定方面的活動，帶有回饋與糾正，而不是簡單重複已經舒適的內容。他們 1993 年的論文以音樂家研究發展了該框架。它沒有公布在每個領域造就專家的小時數。Macnamara、Hambrick 與 Oswald 後來估計表現差異中有多少與刻意練習相關。份額因領域而異：遊戲、音樂與體育高於教育與職業。";
"theory_chapter_1000_example" = "花在仍會出錯的片段上的一小時，與演奏已經順利的曲目的一小時，是不同的活動。進度條兩種情況都會記錄時間。";
"theory_chapter_1000_caveat" = "各領域百分比是 2014 年統合分析中的方差份額。它們不是一個人能學會的技能比例，也不是任何人的成功機率。論文沒有把 1000 小時設為職業門檻。應用中把 1000 小時當作成為專業人士時刻的舊表述誇大了證據。";
"theory_chapter_10000_title" = "著名數字，不是定律";
"theory_chapter_10000_lead" = "一萬小時因精通規則而著名。它所依據的研究並沒有確立定律，此標籤上的水晶只標識應用顯示的最高小時標記。";
"theory_chapter_10000_mechanism_title" = "這個數字如何流傳";
"theory_chapter_10000_mechanism" = "Malcolm Gladwell 的 Outliers（2008）使這個整數廣為人知。它依據專家表現研究，包括 Ericsson、Krampe 與 Tesch-Römer 1993 年關於音樂家刻意練習的論文。Macnamara 與 Maitra（2019）討論該流行規則與研究的差異。流行版本把複雜論證壓縮成一個據稱保證精通的門檻。";
"theory_chapter_10000_example" = "兩個人可以記錄相同總數，卻以不同方式花費時間。一人可能有老師糾正具體缺點。另一人可能在重複已經會彈的曲子。小時總數不會記錄這種差別。";
