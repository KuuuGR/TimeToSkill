"theory_topic_deliberate_title" = "有目的地練習";
"theory_topic_deliberate_summary" = "重複一項活動不等於有意識地改進它。選擇具體方面，帶著明確目標練習，注意錯誤並調整下一次嘗試。追蹤時間有用，但練習方式也很重要。";
"theory_topic_deliberate_takeaway" = "在一次練習前，決定你想改進的一件事。";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "該論文發展了專家表現框架，並報告了包括小提琴家與鋼琴家在內的音樂家研究。";
"theory_topic_deliberate_limitation" = "該論文沒有確立保證所有技能精通的固定練習小時數。";
"theory_topic_10k_title" = "一萬小時：流行規則，不是定律";
"theory_topic_10k_summary" = "一萬小時規則因 Malcolm Gladwell 的 Outliers（2008）而廣為人知。它依據專家表現研究，但流行版本簡化了原論點。並不存在保證精通的普遍神奇小時數。";
"theory_topic_10k_takeaway" = "用長期里程碑慶祝堅持，而不是預測何時成為專家。";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "一萬小時規則因 Malcolm Gladwell 的 Outliers（2008）而廣為人知。2019 年論文討論該流行規則與 1993 年研究的差異。";
"theory_topic_10k_limitation" = "Ericsson 及其同事沒有確立普遍的一萬小時精通定律。不存在保證精通的普遍小時數。";
