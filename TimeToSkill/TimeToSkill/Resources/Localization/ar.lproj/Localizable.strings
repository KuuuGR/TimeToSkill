"theory_topic_first20_limitation" = "إطار العشرين ساعة طريقة للبدء. ليس وقتًا مثبتًا علميًا مطلوبًا للإتقان.";
"theory_topic_deliberate_title" = "تمرّن بهدف";
"theory_topic_deliberate_summary" = "تكرار نشاط ليس كتحسينه عمدًا. اختر جانبًا محددًا، وتمرّن بهدف واضح، ولاحظ الأخطاء، وعدّل المحاولة التالية. تتبّع الوقت مفيد، لكن طريقة التمرين مهمة أيضًا.";
"theory_topic_deliberate_takeaway" = "قبل الجلسة، قرّر شيئًا واحدًا تريد تحسينه.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "طوّرت الورقة إطارًا لأداء الخبراء وأبلغت عن دراسات شملت موسيقيين، منهم عازفو كمان وبيانو.";
"theory_topic_deliberate_limitation" = "لا تُثبت الورقة عدد ساعات تمرين ثابتًا يضمن الإتقان عبر كل المهارات.";
"theory_topic_10k_title" = "10,000 ساعة: قاعدة شائعة، لا قانون";
"theory_topic_10k_summary" = "أصبحت قاعدة الـ10,000 ساعة شائعة عبر Outliers (2008) لمالكوم غلادويل. استندت إلى بحث أداء الخبراء، لكن النسخة الشائعة بسّطت الحجة الأصلية. لا يوجد رقم ساعات سحري عالمي يضمن الإتقان.";
"theory_topic_10k_takeaway" = "استخدم المعالم طويلة الأمد للاحتفال بالمثابرة، لا للتنبؤ بمتى تصبح خبيرًا.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "أصبحت قاعدة الـ10,000 ساعة شائعة عبر Outliers (2008) لمالكوم غلادويل. تناقش ورقة 2019 كيف تختلف تلك القاعدة الشائعة عن بحث 1993.";
"theory_topic_10k_limitation" = "لم يُثبت إريكسون وزملاؤه قانون إتقان عالميًا بـ10,000 ساعة. لا يوجد عدد ساعات عالمي يضمن الإتقان.";
"theory_topic_variance_title" = "التمرين مهم، لكنه ليس كل شيء";
"theory_topic_variance_summary" = "فحص تحليل تلوي لعام 2014 التمرين المتعمّد عبر عدة مجالات. ارتبط التمرين بالأداء، لكن مساهمته اختلفت كثيرًا حسب المجال.";
"theory_topic_variance_takeaway" = "التمرين شيء يمكنك التأثير فيه. تعتمد النتائج أيضًا على عوامل أخرى تختلف بين الأنشطة.";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick, and Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "فحص تحليل تلوي لعام 2014 التمرين المتعمّد عبر عدة مجالات. ارتبط التمرين بالأداء، لكن مساهمته اختلفت كثيرًا حسب المجال.";
"theory_topic_variance_findings_intro" = "كانت الحصة المقدّرة لفروق الأداء التي فسّرها التمرين المتعمّد في هذا التحليل:";
"theory_topic_variance_limitation" = "تشير هذه النسب إلى تباين الأداء المفسَّر في هذا التحليل التلوي. ليست نسبة المهارة التي يمكن لشخص تعلّمها، ولا احتمال نجاح فردي.";
