"theory_topic_spacing_title" = "عُد إلى مهارة بدل حشر كل شيء معًا";
"theory_topic_spacing_summary" = "يدعم بحث التمرين الموزّع نشر التعلّم على جلسات متعددة بدل الاعتماد فقط على التمرين المكثف. أفضل تباعد يعتمد على المادة وعلى مدة الاحتفاظ بها.";
"theory_topic_spacing_takeaway" = "جرّب العودة إلى مهارة على مدى عدة أيام ولاحظ ما تتذكره وما يحتاج مزيدًا من التمرين.";
"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "راجع التحليل التلوي 317 تجربة عبر 184 مقالة، مع 839 تقييمًا للتمرين الموزّع.";
"theory_topic_spacing_limitation" = "تتعلق هذه النتائج بمهام التعلّم والاسترجاع. لا تقدّم جدولًا أمثل لكل مهارة جسدية أو اجتماعية أو فنية أو مهنية.";
"theory_topic_habit_title" = "ليس للعادة موعد نهائي عالمي";
"theory_topic_habit_summary" = "تكرار فعل في سياق ثابت يمكن أن يجعله أكثر تلقائية بمرور الوقت. لكن الوقت المطلوب يختلف بين الأشخاص والسلوكيات. تفويت يوم لا يعني فقدان كل التقدّم.";
"theory_topic_habit_takeaway" = "اربط نشاطًا بموقف تصادفه بانتظام، واستأنف بلا ذنب عندما تُفوت جلسة.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "اختار ستة وتسعون متطوعًا سلوك أكل أو شرب أو نشاط لتكراره في السياق نفسه 12 أسبوعًا. قدّم اثنان وثمانون مشاركًا بيانات كافية. تراوح الوقت النموذجي للوصول إلى 95٪ من تقدير التلقائية التقاربي بين 18 و254 يومًا.";
"theory_topic_habit_limitation" = "كانت دراسة لتكوين العادة، لا دراسة عن عدد الساعات اللازمة لإتقان مهارة. لا تدعم عتبة إتقان 21 ساعة ولا قاعدة عادة عالمية من 21 يومًا.";
