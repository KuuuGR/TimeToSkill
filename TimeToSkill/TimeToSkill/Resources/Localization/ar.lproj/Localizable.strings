/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "تعرض هذه الشاشة المهارات المرفقة مع التطبيق: المجموعة الأصلية بالإضافة إلى عناصر من الكتالوج المُعدّ.";
"theory_compendium_intro" = "كل علامة تبويب هي عتبة ساعات تستخدمها شريط التقدّم بالفعل. البلورة هي لون تلك العتبة. يشرح النص ما تعنيه العتبة — وما لا تعنيه.";
"theory_hour_unit" = "ساعات";
"theory_callout_example" = "مثال";
"theory_callout_caveat" = "تحفظ";
"theory_callout_takeaway" = "الخلاصة";
"theory_chapter_21_title" = "تجاوز البداية";
"theory_chapter_21_lead" = "إحدى وعشرون ساعة تغيّر لون شريط التقدّم. هذا ليس نتيجة بحث. أقرب طريقة منشورة هي إطار العشرين ساعة لجوش كوفمان لتجاوز البداية المحرجة، وهذان الرقمان ليسا الادعاء نفسه.";
"theory_chapter_21_mechanism_title" = "طريقة للبداية";
"theory_chapter_21_mechanism" = "يعامل كوفمان البداية كمشكلة عملية. قسّم المهارة إلى أجزاء أصغر، وتعلّم ما يكفي لملاحظة أخطائك، وأزل العوائق التي تجعل التمرين غير مريح، واقضِ وقتًا مركّزًا على نتيجة واحدة. يعرض الكتاب ذلك كطريقة للمؤلف للبدء.";
"theory_chapter_21_example" = "من يريد أن تبدو ثلاث أوتار نظيفة يمكنه التمرين على تلك النتيجة تحديدًا. «تعلّم الجيتار» هدف أكبر، والساعات الأولى لا تحسمه.";
"theory_chapter_100_title" = "مائة ساعة كعلامة للتطبيق";
"theory_chapter_100_lead" = "مائة ساعة معلم في Time4Skill للوقت المسجّل أصلًا. لا تُعرّف أي دراسة في هذا الملخص 100 ساعة كلحظة يصبح فيها شخص كفؤًا.";
"theory_chapter_100_mechanism_title" = "ما قاسه البحث القريب فعليًا";
"theory_chapter_100_mechanism" = "يقع خطّان من العمل قرب هذه الفترة دون قياسها بالساعات. راجع سيبيدا وباشلر وفول وويكستد ورورر 317 تجربة عن الاسترجاع اللفظي. تفوقت الجلسات الموزّعة على الحفظ المكثف في تلك الأدبيات، واعتمد الفاصل المفيد على مدة الاحتفاظ بالمادة. طلبت لالي وفان يارسفيلد وبوتس وواردل من متطوعين تكرار سلوك أكل أو شرب أو نشاط في السياق نفسه. تباين الوقت النموذجي للوصول إلى 95 بالمئة من هضبة كل شخص كثيرًا. تفويت يوم واحد لم يمحُ المنحنى.";
"theory_chapter_100_example" = "عزف مقطع قصير في ثلاثة أيام مختلفة يُظهر أي مقياس بقي فعلًا في الذاكرة. أمسية طويلة من التكرار لا تجيب عن هذا السؤال.";
"theory_chapter_100_caveat" = "مراجعة التباعد تتعلق بالاسترجاع اللفظي. دراسة العادة تتعلق بأتمتة سلوك مختار، وكان المدى في النموذج المبلغ عنه مع المقال من 18 إلى 254 يومًا، لا خط كفاءة عند 100 ساعة. لا نتيجة تقول إن 100 ساعة تجعل أحدًا كفؤًا في التصوير أو القيادة أو أي مهارة أخرى.";
"theory_chapter_100_takeaway" = "استخدم العلامة لتلاحظ إن كنت تعود. لا تعاملها كمستوى مكتسب.";
"theory_chapter_1000_title" = "تمرين موجّه نحو فجوة واحدة";
"theory_chapter_1000_lead" = "بلورة الألف ساعة تسجّل الوقت المُستغرق. لا تعني أن الشخص أصبح محترفًا أو معلّمًا أو من يمكنه العيش من المهارة.";
"theory_chapter_1000_mechanism_title" = "التمرين المتعمّد، وكم فسّر";
"theory_chapter_1000_mechanism" = "وصف إريكسون وكرامبي وتش-رومر التمرين المتعمّد بأنه نشاط منظم لتحسين جانب محدد، مع تغذية راجعة وتصحيح، بدل مجرد تكرار ما هو مريح أصلًا. طوّرت ورقتهم لعام 1993 هذا الإطار بدراسات على موسيقيين. لم تنشر عدد ساعات يصنع خبراء في كل مجال. قدّر ماكنامارا وهامبريك وأوزوالد لاحقًا كم من فرق الأداء ارتبط بالتمرين المتعمّد. اختلفت الحصص حسب المجال: أعلى في الألعاب والموسيقى والرياضة منها في التعليم والمهن.";
"theory_chapter_1000_example" = "ساعة على المقطع الذي ما زال ينهار نشاط مختلف عن ساعة عزف قطع تسير جيدًا. يسجّل شريط التقدّم الوقت في الحالتين.";
"theory_chapter_1000_caveat" = "نسب المجالات حصص تباين في التحليل التلوي لعام 2014. ليست جزء المهارة الذي يمكن تعلّمه، ولا فرصة نجاح أحد. لا تضع الورقة 1000 ساعة كعتبة مهنية. الصياغة الأقدم في التطبيق التي اعتبرت 1000 ساعة لحظة أن تصبح محترفًا بالغت في الأدلة.";
"theory_chapter_10000_title" = "رقم شهير، لا قانون";
"theory_chapter_10000_lead" = "عشرة آلاف ساعة اشتهرت كقاعدة للإتقان. البحث الذي استُمدت منه لم يُثبت قانونًا، وبلورة هذه العلامة تحدد فقط أعلى عتبة ساعات يعرضها التطبيق.";
"theory_chapter_10000_mechanism_title" = "كيف سافر الرقم";
"theory_chapter_10000_mechanism" = "جعل كتاب Outliers (2008) لمالكوم غلادويل الرقم المستدير معروفًا على نطاق واسع. استند إلى بحث عن أداء الخبراء، بما في ذلك ورقة إريكسون وكرامبي وتش-رومر لعام 1993 عن التمرين المتعمّد لدى الموسيقيين. يناقش ماكنامارا ومايترا (2019) كيف تختلف تلك القاعدة الشائعة عن البحث. ضغطت النسخة الشائعة حجة معقدة إلى عتبة واحدة يُفترض أن تضمن الإتقان.";
"theory_chapter_10000_example" = "يمكن لشخصين تسجيل المجموع نفسه ومع ذلك قضاء الوقت بشكل مختلف. ربما كان لأحدهما معلّم يصحح عيبًا محددًا. وربما كرر الآخر قطعة يعزفها أصلًا. مجموع الساعات لا يسجّل ذلك الفرق.";
