"theory_topic_first20_title" = "Pierwsze 20 godzin: przejść przez początek";
"theory_topic_first20_summary" = "Początek bywa frustrujący, bo wszystko jest nowe. Josh Kaufman proponuje praktyczne podejście: podziel umiejętność na mniejsze części, skup się na tym, co ważne, usuń przeszkody i poświęć skupiony czas na poprawę. Ramy 20 godzin to metoda startu, a nie naukowa gwarancja, że dowolną umiejętność da się opanować w 20 godzin.";
"theory_topic_first20_takeaway" = "Wybierz jedną konkretną rzecz, którą chcesz robić lepiej po pierwszych 20 godzinach.";
"theory_topic_first20_citation" = "Josh Kaufman. The First 20 Hours: How to Learn Anything… Fast! Ebook published in 2013; paperback published in 2014.";
"theory_topic_first20_context" = "Praktyczne ramy autora i książka, a nie kontrolowane badanie naukowe.";
"theory_topic_first20_limitation" = "Ramy 20 godzin są metodą startu. To nie jest naukowo ustalony czas potrzebny do mistrzostwa.";

"theory_topic_deliberate_title" = "Ćwiczenie z celem";
"theory_topic_deliberate_summary" = "Powtarzanie czynności to nie to samo co celowe poprawianie jej. Wybierz konkretny aspekt, ćwicz z jasnym celem, zauważaj błędy i koryguj następną próbę. Czas warto mierzyć, ale sposób ćwiczenia też ma znaczenie.";
"theory_topic_deliberate_takeaway" = "Przed sesją zdecyduj, co jedną rzecz chcesz poprawić.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "The paper developed a framework for expert performance and reported studies involving musicians, including violinists and pianists.";
"theory_topic_deliberate_limitation" = "Artykuł nie ustala jednej liczby godzin, która gwarantuje mistrzostwo we wszystkich umiejętnościach.";

"theory_topic_10k_title" = "10 000 godzin: popularna reguła, nie prawo";
"theory_topic_10k_summary" = "Reguła 10 000 godzin stała się popularna dzięki książce Malcolma Gladwella Outliers (2008). Odwoływała się do badań nad eksperckim wykonaniem, ale popularna wersja uprościła pierwotny argument. Nie ma uniwersalnej liczby godzin, która gwarantuje mistrzostwo.";
"theory_topic_10k_takeaway" = "Długie progi służą do świętowania wytrwałości, a nie do przewidywania, kiedy zostaniesz ekspertem.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "The 10,000-hour rule became widely popular through Malcolm Gladwell's Outliers (2008). The 2019 paper discusses how that popular rule differs from the 1993 research.";
"theory_topic_10k_limitation" = "Ericsson i współautorzy nie ustalili uniwersalnego prawa 10 000 godzin. Nie ma liczby godzin, która gwarantuje mistrzostwo.";

"theory_topic_variance_title" = "Praktyka ma znaczenie, ale nie jest wszystkim";
"theory_topic_variance_summary" = "Metaanaliza z 2014 roku obejmowała celową praktykę w kilku dziedzinach. Praktyka wiązała się z wynikami, ale jej udział wyraźnie różnił się między dziedzinami.";
"theory_topic_variance_takeaway" = "Na praktykę masz wpływ. Wynik zależy też od innych czynników, różnych w zależności od czynności.";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick, and Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "A 2014 meta-analysis examined deliberate practice across several fields. Practice was associated with performance, but its contribution differed substantially by domain.";
"theory_topic_variance_findings_intro" = "The estimated share of performance differences explained by deliberate practice in this analysis was:";
