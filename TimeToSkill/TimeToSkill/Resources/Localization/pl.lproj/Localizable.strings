/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Ten ekran pokazuje umiejętności dołączone do aplikacji: dotychczasowy zestaw oraz pozycje przyjęte z opracowanego zbioru. Pliki propozycji pilotażowych same nie są katalogiem.";
"theory_compendium_intro" = "Każda zakładka to próg godzin, którego już używa pasek postępu. Kryształ ma kolor tego progu. Tekst wyjaśnia, co próg znaczy, a czego nie znaczy.";
"theory_hour_unit" = "godz.";
"theory_callout_example" = "Przykład";
"theory_callout_caveat" = "Zastrzeżenie";
"theory_callout_takeaway" = "Wniosek";
"theory_chapter_21_title" = "Przejść przez początek";
"theory_chapter_21_lead" = "Dwadzieścia jeden godzin zmienia kolor paska postępu. To nie jest wynik badania. Najbliższa opublikowana metoda to ramy 20 godzin Josha Kaufmana na przejście przez niewygodny początek. Te dwie liczby nie są tym samym twierdzeniem.";
"theory_chapter_21_mechanism_title" = "Metoda na start";
"theory_chapter_21_mechanism" = "Kaufman traktuje początek jako praktyczny problem. Podziel umiejętność na mniejsze części, naucz się tyle, by zauważać własne błędy, usuń przeszkody, które utrudniają ćwiczenie, i poświęć skupiony czas jednemu wynikowi. Książka przedstawia to jako metodę autora na rozpoczęcie.";
"theory_chapter_21_example" = "Osoba, która chce, żeby trzy chwyty brzmiały czysto, może ćwiczyć właśnie ten wynik. „Nauczyć się gitary” jest większym celem i pierwsze godziny go nie rozstrzygają.";
"theory_chapter_100_title" = "Sto godzin jako próg aplikacji";
"theory_chapter_100_lead" = "Sto godzin to próg Time4Skill dla czasu, który został już zapisany. Żadne badanie zebrane w tym kompendium nie określa 100 godzin jako momentu, w którym ktoś staje się kompetentny.";
"theory_chapter_100_mechanism_title" = "Co naprawdę mierzyły pobliskie badania";
"theory_chapter_100_mechanism" = "Dwa nurty leżą blisko tego okresu, ale nie mierzą go w godzinach. Cepeda, Pashler, Vul, Wixted i Rohrer przejrzeli 317 eksperymentów o przypominaniu słownym. W tej literaturze rozłożenie sesji wygrywało z zakuwaniem, a użyteczny odstęp zależał od tego, jak długo materiał miał być pamiętany. Lally, van Jaarsveld, Potts i Wardle prosili ochotników o powtarzanie czynności jedzenia, picia albo aktywności w tym samym kontekście. Wymodelowany czas dojścia do 95 procent własnego plateau każdej osoby był bardzo różny. Pominięcie jednego dnia nie zerowało krzywej.";
"theory_chapter_100_example" = "Zagranie krótkiego fragmentu w trzy różne dni pokazuje, który takt naprawdę został w pamięci. Jeden długi wieczór powtórzeń nie odpowiada na to pytanie.";
"theory_chapter_100_caveat" = "Przegląd o rozłożeniu dotyczy przypominania słownego. Badanie nawyku dotyczy automatyczności wybranej czynności, a zakres w modelu opisanym przy artykule wynosił od 18 do 254 dni, a nie linię kompetencji po 100 godzinach. Żaden z tych wyników nie mówi, że 100 godzin czyni kogoś kompetentnym w fotografii, prowadzeniu samochodu albo innej umiejętności.";
"theory_chapter_100_takeaway" = "Użyj progu, żeby zauważyć, czy wracasz do ćwiczenia. Nie traktuj go jako zdobytego poziomu.";
"theory_chapter_1000_title" = "Ćwiczenie wymierzone w jedną lukę";
"theory_chapter_1000_lead" = "Kryształ 1000 godzin zapisuje poświęcony czas. Nie oznacza, że osoba jest już profesjonalistą, nauczycielem albo kimś, kto może utrzymywać się z tej umiejętności.";
"theory_chapter_1000_mechanism_title" = "Celowa praktyka i to, ile wyjaśniała";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe i Tesch-Römer opisali celową praktykę jako czynność ułożoną tak, by poprawić konkretny aspekt, z informacją zwrotną i korektą, a nie jako zwykłe powtarzanie tego, co już jest wygodne. Artykuł z 1993 roku rozwijał te ramy na badaniach muzyków. Nie opublikował jednej liczby godzin, która tworzy ekspertów w każdej dziedzinie. Macnamara, Hambrick i Oswald oszacowali później, jaka część różnic w wynikach wiązała się z celową praktyką. Udziały różniły się między dziedzinami: wyższe w grach, muzyce i sporcie niż w edukacji i zawodach.";
"theory_chapter_1000_example" = "Godzina spędzona na fragmencie, który wciąż się sypie, jest inną czynnością niż godzina grania utworów, które już wychodzą. Pasek postępu zapisuje czas w obu przypadkach.";
"theory_chapter_1000_caveat" = "Procenty dla dziedzin to udziały wariancji w metaanalizie z 2014 roku. To nie jest część umiejętności, której można się nauczyć, ani czyjaś szansa powodzenia. Artykuł nie ustanawia 1000 godzin jako progu zawodowego. Starsze sformułowanie w aplikacji, które traktowało 1000 godzin jako moment zostania profesjonalistą, wykraczało poza te dane.";
"theory_chapter_10000_title" = "Słynna liczba, nie prawo";
"theory_chapter_10000_lead" = "Dziesięć tysięcy godzin zasłynęło jako reguła mistrzostwa. Badania, z których ją wyprowadzono, nie ustanowiły prawa, a kryształ na tej zakładce tylko identyfikuje najwyższy wyświetlany próg godzin w aplikacji.";
"theory_chapter_10000_mechanism_title" = "Jak liczba wędrowała";
"theory_chapter_10000_mechanism" = "Książka Malcolma Gladwella Outliers (2008) spopularyzowała okrągłą liczbę. Odwoływała się do badań nad eksperckim wykonaniem, w tym do artykułu Ericssona, Krampego i Tesch-Römera z 1993 roku o celowej praktyce muzyków. Macnamara i Maitra (2019) omawiają, czym ta popularna reguła różni się od badań. Popularna wersja spłaszczyła złożony argument do jednego progu, który miał gwarantować mistrzostwo.";
"theory_chapter_10000_example" = "Dwie osoby mogą mieć ten sam łączny czas i spędzić go inaczej. Jedna mogła mieć nauczyciela poprawiającego konkretny błąd. Druga mogła powtarzać utwór, który już gra. Suma godzin tej różnicy nie zapisuje.";
