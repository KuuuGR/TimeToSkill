"theory_topic_spacing_title" = "กลับมาที่ทักษะ แทนการอัดทุกอย่างพร้อมกัน";
"theory_topic_spacing_summary" = "งานวิจัยเกี่ยวกับการฝึกแบบกระจายสนับสนุนการกระจายการเรียนรู้หลายเซสชัน แทนการพึ่งการฝึกอัดเพียงอย่างเดียว ระยะที่ดีที่สุดขึ้นกับเนื้อหาและระยะเวลาที่อยากเก็บไว้";
"theory_topic_spacing_takeaway" = "ลองกลับมาที่ทักษะหลายวัน และสังเกตว่าคุณจำอะไรได้และอะไรต้องฝึกเพิ่ม";
"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "เมตาวิเคราะห์ทบทวน 317 การทดลองใน 184 บทความ พร้อมการประเมินการฝึกแบบกระจาย 839 รายการ";
"theory_topic_spacing_limitation" = "ผลลัพธ์เหล่านี้เกี่ยวกับงานเรียนรู้และการระลึก ไม่ได้นำเสนอตารางที่เหมาะสมที่สุดสำหรับทุกทักษะทางกาย ทางสังคม ศิลปะ หรืออาชีพ";
"theory_topic_habit_title" = "นิสัยไม่มีกำหนดเวลาสากล";
"theory_topic_habit_summary" = "การทำซ้ำในบริบทเดียวกันอาจทำให้อัตโนมัติมากขึ้นตามเวลา แต่เวลาที่ต้องการต่างกันตามคนและพฤติกรรม การพลาดหนึ่งวันไม่ได้หมายความว่าความคืบหน้าทั้งหมดหายไป";
"theory_topic_habit_takeaway" = "เชื่อมกิจกรรมกับสถานการณ์ที่คุณพบเป็นประจำ และกลับมาโดยไม่รู้สึกผิดเมื่อพลาดเซสชัน";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "อาสาสมัครเก้าสิบหกคนเลือกพฤติกรรมกิน ดื่ม หรือกิจกรรมเพื่อทำซ้ำในบริบทเดียวกันสิบสองสัปดาห์ ผู้เข้าร่วมแปดสิบสองคนให้ข้อมูลพอ เวลาแบบจำลองถึง 95% ของการประมาณอัตโนมัติเชิงเส้นกำกับแปรจาก 18 ถึง 254 วัน";
