"theory_compendium_intro" = "แต่ละแท็บเป็นเครื่องหมายชั่วโมงที่แถบความคืบหน้าใช้แล้ว คริสตัลคือสีของเครื่องหมายนั้น ข้อความอธิบายว่าเครื่องหมายหมายถึงอะไร — และไม่หมายถึงอะไร";
"theory_hour_unit" = "ชั่วโมง";
"theory_callout_example" = "ตัวอย่าง";
"theory_callout_caveat" = "ข้อควรระวัง";
"theory_callout_takeaway" = "ข้อสรุป";
"theory_chapter_21_title" = "ก้าวพ้นจุดเริ่มต้น";
"theory_chapter_21_lead" = "ยี่สิบเอ็ดชั่วโมงเปลี่ยนสีแถบความคืบหน้า นี่ไม่ใช่ผลการวิจัย วิธีที่ตีพิมพ์ใกล้ที่สุดคือกรอบ 20 ชั่วโมงของ Josh Kaufman เพื่อฝ่าจุดเริ่มต้นที่เก้อเขิน และตัวเลขสองค่านี้ไม่ใช่ข้ออ้างเดียวกัน";
"theory_chapter_21_mechanism_title" = "วิธีสำหรับจุดเริ่มต้น";
"theory_chapter_21_mechanism" = "Kaufman ถือจุดเริ่มต้นเป็นปัญหาเชิงปฏิบัติ แบ่งทักษะเป็นส่วนย่อย เรียนพอให้เห็นข้อผิดพลาดของตนเอง กำจัดอุปสรรคที่ทำให้ฝึกไม่สะดวก และใช้เวลาโฟกัสกับผลลัพธ์หนึ่งอย่าง หนังสือเสนอเป็นวิธีของผู้เขียนในการเริ่มต้น";
"theory_chapter_21_example" = "คนที่อยากให้สามคอร์ดดังกังวานสะอาดสามารถฝึกผลลัพธ์นั้นได้โดยตรง \"เรียนกีตาร์\" เป็นเป้าหมายใหญ่กว่า และชั่วโมงแรกไม่ได้ตัดสินมัน";
"theory_chapter_100_title" = "หนึ่งร้อยชั่วโมงในฐานะเครื่องหมายแอป";
"theory_chapter_100_lead" = "หนึ่งร้อยชั่วโมงเป็นหลักไมล์ Time4Skill สำหรับเวลาที่บันทึกแล้ว ไม่มีงานวิจัยในสรุปนี้ที่นิยาม 100 ชั่วโมงเป็นจุดที่ใครสักคนมีความสามารถ";
"theory_chapter_100_mechanism_title" = "งานวิจัยใกล้เคียงวัดอะไรจริง ๆ";
"theory_chapter_100_mechanism" = "สองสายงานอยู่ใกล้ช่วงนี้โดยไม่วัดเป็นชั่วโมง Cepeda, Pashler, Vul, Wixted และ Rohrer ทบทวน 317 การทดลองเกี่ยวกับการระลึกทางวาจา การกระจายเซสชันชนะการอัดในวรรณกรรมนั้น และช่วงที่มีประโยชน์ขึ้นกับว่าต้องจำเนื้อหานานแค่ไหน Lally, van Jaarsveld, Potts และ Wardle ให้ผู้สมัครใจทำพฤติกรรมกิน ดื่ม หรือกิจกรรมซ้ำในบริบทเดียวกัน เวลาที่แบบจำลองถึง 95 เปอร์เซ็นต์ของที่ราบสูงของแต่ละคนแตกต่างกันมาก การพลาดหนึ่งวันไม่ได้ลบเส้นโค้ง";
"theory_chapter_100_example" = "เล่นท่อนสั้นในสามวันต่างกันแสดงว่าจังหวะใดยังอยู่ในความจำจริง ๆ คืนยาว ๆ ของการทำซ้ำไม่ตอบคำถามนั้น";
"theory_chapter_100_caveat" = "ภาพรวมเรื่องการเว้นระยะเกี่ยวกับการระลึกทางวาจา การศึกษานิสัยเกี่ยวกับอัตโนมัติของพฤติกรรมที่เลือก และช่วงในแบบจำลองที่รายงานกับบทความคือ 18 ถึง 254 วัน ไม่ใช่เส้นความสามารถที่ 100 ชั่วโมง ไม่มีผลลัพธ์ใดบอกว่า 100 ชั่วโมงทำให้ใครมีความสามารถในการถ่ายภาพ ขับรถ หรือทักษะอื่น";
"theory_chapter_100_takeaway" = "ใช้เครื่องหมายเพื่อสังเกตว่าคุณกลับมาหรือไม่ อย่าถือว่าเป็นระดับที่ได้รับมา";
"theory_chapter_1000_title" = "การฝึกที่มุ่งไปที่ช่องว่างหนึ่ง";
"theory_chapter_1000_lead" = "คริสตัล 1,000 ชั่วโมงบันทึกเวลาที่ใช้ ไม่ได้หมายความว่าบุคคลนั้นเป็นมืออาชีพ ครู หรือผู้ที่สามารถเลี้ยงชีพด้วยทักษะได้แล้ว";
"theory_chapter_1000_mechanism_title" = "การฝึกอย่างตั้งใจ และมันอธิบายได้มากแค่ไหน";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe และ Tesch-Römer อธิบายการฝึกอย่างตั้งใจว่าเป็นการจัดกิจกรรมเพื่อปรับปรุงด้านเฉพาะ พร้อมข้อเสนอแนะและการแก้ไข แทนการทวนสิ่งที่สบายอยู่แล้ว บทความปี 1993 พัฒนากรอบนั้นด้วยการศึกษาของนักดนตรี ไม่ได้ตีพิมพ์จำนวนชั่วโมงที่สร้างผู้เชี่ยวชาญในทุกสาขา Macnamara, Hambrick และ Oswald ประมาณภายหลังว่าความแตกต่างของผลงานเกี่ยวข้องกับการฝึกอย่างตั้งใจกี่ส่วน สัดส่วนต่างกันตามโดเมน: สูงกว่าในเกม ดนตรี และกีฬา เมื่อเทียบกับการศึกษาและอาชีพ";
"theory_chapter_1000_example" = "หนึ่งชั่วโมงกับท่อนที่ยังพังอยู่เป็นกิจกรรมต่างจากหนึ่งชั่วโมงเล่นชิ้นที่ไปได้ดีแล้ว แถบความคืบหน้าบันทึกเวลาทั้งสองกรณี";
"theory_chapter_1000_caveat" = "เปอร์เซ็นต์ตามโดเมนคือส่วนของความแปรปรวนในเมตาวิเคราะห์ปี 2014 ไม่ใช่ส่วนของทักษะที่เรียนได้ และไม่ใช่โอกาสสำเร็จของใคร บทความไม่ได้ตั้ง 1,000 ชั่วโมงเป็นเกณฑ์อาชีพ ข้อความเก่าในแอปที่ถือ 1,000 ชั่วโมงเป็นจุดกลายเป็นมืออาชีพเกินเลยหลักฐาน";
"theory_chapter_10000_title" = "ตัวเลขดัง ไม่ใช่กฎธรรมชาติ";
"theory_chapter_10000_lead" = "หนึ่งหมื่นชั่วโมงกลายเป็นที่รู้จักในฐานะกฎความเชี่ยวชาญ งานวิจัยที่เป็นที่มาไม่ได้ตั้งกฎ และคริสตัลบนแท็บนี้เพียงระบุเครื่องหมายชั่วโมงสูงสุดที่แอปแสดง";
"theory_chapter_10000_mechanism_title" = "ตัวเลขเดินทางอย่างไร";
"theory_chapter_10000_mechanism" = "Outliers (2008) ของ Malcolm Gladwell ทำให้ตัวเลขกลมเป็นที่รู้จักกว้าง อิงงานวิจัยประสิทธิภาพผู้เชี่ยวชาญ รวมบทความปี 1993 ของ Ericsson, Krampe และ Tesch-Römer เกี่ยวกับการฝึกอย่างตั้งใจในนักดนตรี Macnamara และ Maitra (2019) อภิปรายว่ากฎยอดนิยมนั้นต่างจากงานวิจัยอย่างไร เวอร์ชันยอดนิยมบีบอาร์กิวเมนต์ซับซ้อนให้เป็นเกณฑ์เดียวที่รับประกันความเชี่ยวชาญ";
"theory_chapter_10000_example" = "สองคนอาจบันทึกผลรวมเดียวกันแต่ใช้เวลาต่างกัน คนหนึ่งอาจมีครูแก้ข้อบกพร่องเฉพาะ อีกคนอาจทวนชิ้นที่เล่นได้อยู่แล้ว ผลรวมชั่วโมงไม่บันทึกความต่างนั้น";
