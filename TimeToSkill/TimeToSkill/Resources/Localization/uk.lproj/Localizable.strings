/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Этот экран показывает навыки, входящие в приложение: исходный набор и позиции из подготовленного каталога.";
"theory_compendium_intro" = "Кожна вкладка — годинна позначка, яку вже використовує смуга прогресу. Кристал — колір цієї позначки. Текст пояснює, що позначка означає і чого не означає.";
"theory_hour_unit" = "годин";
"theory_callout_example" = "Приклад";
"theory_callout_caveat" = "Застереження";
"theory_callout_takeaway" = "Висновок";
"theory_chapter_21_title" = "Пройти початок";
"theory_chapter_21_lead" = "Двадцять одна година змінює колір смуги прогресу. Це не науковий висновок. Найближчий опублікований метод — рамка 20 годин Джоша Кауфмана, щоб пережити незручний початок, і ці два числа — не те саме твердження.";
"theory_chapter_21_mechanism_title" = "Метод для старту";
"theory_chapter_21_mechanism" = "Кауфман розглядає початок як практичну задачу. Розділіть навичку на менші частини, навчіться достатньо, щоб помічати свої помилки, приберіть перешкоди, що ускладнюють практику, і приділіть зосереджений час одному результату. Книга подає це як метод автора для початку.";
"theory_chapter_21_example" = "Той, хто хоче, щоб три акорди звучали чисто, може практикувати саме цей результат. «Навчитися гітари» — більша мета, і перші години її не вирішують.";
"theory_chapter_100_title" = "Сто годин як позначка застосунку";
"theory_chapter_100_lead" = "Сто годин — віха Time4Skill для вже записаного часу. Жодне дослідження в цьому компендіумі не визначає 100 годин як момент, коли хтось стає компетентним.";
"theory_chapter_100_mechanism_title" = "Що насправді вимірювали близькі дослідження";
"theory_chapter_100_mechanism" = "Дві лінії робіт близькі до цього періоду, не вимірюючи його в годинах. Cepeda, Pashler, Vul, Wixted і Rohrer розглянули 317 експериментів зі словесного пригадування. Розподіл сесій у тій літературі перемагав зубрежку, а корисний інтервал залежав від того, як довго матеріал треба пам’ятати. Lally, van Jaarsveld, Potts і Wardle просили добровольців повторювати поведінку їжі, пиття або активності в тому самому контексті. Змодельований час до 95 відсотків власного плато кожної людини сильно різнився. Пропуск одного дня не обнулював криву.";
"theory_chapter_100_example" = "Гра короткого уривка в три різні дні показує, який такт справді лишився в пам’яті. Один довгий вечір повторень на це питання не відповідає.";
"theory_chapter_100_caveat" = "Огляд про розподіл стосується словесного пригадування. Дослідження звички — про автоматичність обраної поведінки, а діапазон у моделі при статті був від 18 до 254 днів, а не лінія компетентності на 100 годинах. Жоден результат не каже, що 100 годин роблять когось компетентним у фотографії, водінні чи іншій навичці.";
"theory_chapter_100_takeaway" = "Використовуйте позначку, щоб помітити, чи повертаєтесь. Не вважайте її заслуженим рівнем.";
"theory_chapter_1000_title" = "Практика, націлена на одну прогалину";
"theory_chapter_1000_lead" = "Кристал 1000 годин фіксує витрачений час. Він не означає, що людина вже професіонал, учитель чи хтось, хто може заробляти навичкою.";
"theory_chapter_1000_mechanism_title" = "Усвідомлена практика і скільки вона пояснювала";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe і Tesch-Römer описали усвідомлену практику як діяльність, влаштовану для покращення конкретного аспекту, зі зворотним зв’язком і корекцією, а не просте повторення вже зручного. Їхня стаття 1993 року розвивала цю рамку на дослідженнях музикантів. Вона не опублікувала числа годин, що створює експертів у кожній галузі. Macnamara, Hambrick і Oswald пізніше оцінили, яка частка різниць у результатах пов’язана з усвідомленою практикою. Частки різнилися за доменами: вищі в іграх, музиці та спорті, ніж в освіті та професіях.";
"theory_chapter_1000_example" = "Година на пасажі, який усе ще розвалюється, — інша діяльність, ніж година гри вже добрих п’єс. Смуга прогресу записує час в обох випадках.";
"theory_chapter_1000_caveat" = "Відсотки за доменами — частки дисперсії в метааналізі 2014 року. Це не частка навички, яку можна вивчити, і не чийсь шанс успіху. Стаття не встановлює 1000 годин як професійний поріг. Старе формулювання в застосунку, де 1000 годин вважалися моментом становлення професіоналом, перебільшувало дані.";
"theory_chapter_10000_title" = "Відоме число, не закон";
"theory_chapter_10000_lead" = "Десять тисяч годин стали відомими як правило майстерності. Дослідження, з яких це вивели, не встановили закону, а кристал на цій вкладці лише позначає найвищу відображувану годинну позначку застосунку.";
"theory_chapter_10000_mechanism_title" = "Як число мандрувало";
"theory_chapter_10000_mechanism" = "Outliers (2008) Малкольма Гладуелла зробив кругле число широко відомим. Воно спиралося на дослідження експертного виконання, зокрема статтю Ericsson, Krampe і Tesch-Römer 1993 року про усвідомлену практику музикантів. Macnamara і Maitra (2019) обговорюють, чим популярне правило відрізняється від дослідження. Популярна версія стиснула складний аргумент до одного порогу, що нібито гарантує майстерність.";
"theory_chapter_10000_example" = "Двоє можуть записати ту саму суму й усе одно витратити час інакше. В одного міг бути вчитель, що виправляв конкретну ваду. Інший міг повторювати п’єсу, яку вже грає. Сума годин цю різницю не записує.";
