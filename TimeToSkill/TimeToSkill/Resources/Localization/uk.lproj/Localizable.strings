"theory_topic_first20_limitation" = "Рамка 20 годин — метод старту. Це не науково встановлений час до майстерності.";
"theory_topic_deliberate_title" = "Практика з метою";
"theory_topic_deliberate_summary" = "Повторювати діяльність — не те саме, що цілеспрямовано її покращувати. Оберіть конкретний аспект, практикуйте з ясною метою, помічайте помилки й коригуйте наступну спробу. Облік часу корисний, але спосіб практики теж важливий.";
"theory_topic_deliberate_takeaway" = "Перед сесією вирішіть, що одне ви хочете покращити.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "Стаття розвинула рамку експертного виконання й повідомила дослідження музикантів, зокрема скрипалів і піаністів.";
"theory_topic_deliberate_limitation" = "Стаття не встановлює одного фіксованого числа годин практики, що гарантує майстерність у всіх навичках.";
"theory_topic_10k_title" = "10 000 годин: популярне правило, не закон";
"theory_topic_10k_summary" = "Правило 10 000 годин стало широко відомим завдяки Outliers (2008) Малкольма Гладуелла. Воно спиралося на дослідження експертного виконання, але популярна версія спростила початковий аргумент. Універсального магічного числа годин, що гарантує майстерність, немає.";
"theory_topic_10k_takeaway" = "Використовуйте довгострокові віхи, щоб відзначати наполегливість, а не щоб передбачати, коли станете експертом.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "Правило 10 000 годин стало широко відомим завдяки Outliers (2008) Малкольма Гладуелла. Стаття 2019 року обговорює, чим це популярне правило відрізняється від дослідження 1993 року.";
"theory_topic_10k_limitation" = "Ericsson і колеги не встановили універсального закону майстерності в 10 000 годин. Універсального числа годин, що гарантує майстерність, немає.";
"theory_topic_variance_title" = "Практика важлива, але це не все";
"theory_topic_variance_summary" = "Метааналіз 2014 року вивчав усвідомлену практику в кількох галузях. Практика була пов’язана з результатами, але її внесок сильно різнився за доменами.";
"theory_topic_variance_takeaway" = "На практику можна впливати. Результати залежать і від інших чинників, різних для різних занять.";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick, and Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "Метааналіз 2014 року вивчав усвідомлену практику в кількох галузях. Практика була пов’язана з результатами, але її внесок сильно різнився за доменами.";
"theory_topic_variance_findings_intro" = "Оцінена частка різниць у результатах, пояснена усвідомленою практикою в цьому аналізі:";
"theory_topic_variance_limitation" = "Ці відсотки стосуються поясненої дисперсії результатів у цьому метааналізі. Це не відсоток навички, яку можна вивчити, і не індивідуальна ймовірність успіху.";
