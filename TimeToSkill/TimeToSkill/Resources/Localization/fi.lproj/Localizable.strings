/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Dieser Bildschirm listet die mit der App gelieferten Fähigkeiten: den ursprünglichen Satz plus Einträge aus dem erarbeiteten Katalog.";
"theory_compendium_intro" = "Jokainen välilehti on tuntimerkki, jota edistymispalkki jo käyttää. Kristalli on merkin väri. Teksti selittää, mitä merkki tarkoittaa — ja mitä se ei tarkoita.";
"theory_hour_unit" = "tuntia";
"theory_callout_example" = "Esimerkki";
"theory_callout_caveat" = "Varaus";
"theory_callout_takeaway" = "Ota mukaan";
"theory_chapter_21_title" = "Alun ohi";
"theory_chapter_21_lead" = "Kaksikymmentäyksi tuntia muuttaa edistymispalkin väriä. Se ei ole tutkimustulos. Lähin julkaistu menetelmä on Josh Kaufmanin 20 tunnin kehys kömpelön alun selättämiseen, eivätkä nuo kaksi lukua ole sama väite.";
"theory_chapter_21_mechanism_title" = "Menetelmä alkuun";
"theory_chapter_21_mechanism" = "Kaufman käsittelee alkua käytännön ongelmana. Jaa taito pienempiin osiin, opi tarpeeksi huomataksesi omat virheesi, poista harjoittelua hankaloittavat esteet ja käytä keskittynyttä aikaa yhteen tulokseen. Kirja esittää tämän kirjoittajan tapana aloittaa.";
"theory_chapter_21_example" = "Henkilö, joka haluaa kolmen soinnun kuulostavan puhtailta, voi harjoitella juuri sitä tulosta. ”Oppia kitara” on suurempi tavoite, eivätkä ensimmäiset tunnit ratkaise sitä.";
"theory_chapter_100_title" = "Sata tuntia sovelluksen merkkinä";
"theory_chapter_100_lead" = "Sata tuntia on Time4Skill-merkkipaalu jo kirjatulle ajalle. Yksikään tämän kokoelman tutkimus ei määritä 100 tuntia pisteeksi, jossa joku tulee päteväksi.";
"theory_chapter_100_mechanism_title" = "Mitä läheinen tutkimus todella mittasi";
"theory_chapter_100_mechanism" = "Kaksi tutkimuslinjaa on lähellä tätä ajanjaksoa mittaamatta sitä tunteina. Cepeda, Pashler, Vul, Wixted ja Rohrer kävivät läpi 317 kokeilua sanallisesta mieleenpalautuksesta. Hajautetut sessiot voittivat ahtamisen tuossa kirjallisuudessa, ja hyödyllinen väli riippui siitä, kuinka kauan aineistoa piti muistaa. Lally, van Jaarsveld, Potts ja Wardle pyysivät vapaaehtoisia toistamaan syömis-, juomis- tai aktiviteettikäyttäytymistä samassa kontekstissa. Mallinnettu aika kunkin oman ylätason 95 prosenttiin vaihteli laajasti. Yhden päivän väliin jättäminen ei pyyhkinyt käyrää.";
"theory_chapter_100_example" = "Lyhyen kappaleen soittaminen kolmena eri päivänä näyttää, mikä tahti todella jäi mieleen. Yksi pitkä ilta toistoa ei vastaa siihen kysymykseen.";
"theory_chapter_100_caveat" = "Hajautuksen katsaus koskee sanallista mieleenpalautusta. Tottumustutkimus koskee valitun käyttäytymisen automatisoitumista, ja artikkelin mallin vaihteluväli oli 18–254 päivää — ei 100 tunnin pätevyyslinjaa. Mikään tulos ei sano, että 100 tuntia tekee kenestäkään pätevän valokuvauksessa, ajamisessa tai muussa taidossa.";
"theory_chapter_100_takeaway" = "Käytä merkkiä huomataksesi, palaatko. Älä käsittele sitä ansaittuna tasona.";
"theory_chapter_1000_title" = "Harjoittelu kohti yhtä aukkoa";
"theory_chapter_1000_lead" = "1000 tunnin kristalli kirjaa käytetyn ajan. Se ei tarkoita, että henkilö on nyt ammattilainen, opettaja tai joku, joka voi elää taidolla.";
"theory_chapter_1000_mechanism_title" = "Tarkoituksellinen harjoittelu ja kuinka paljon se selitti";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe ja Tesch-Römer kuvasivat tarkoituksellisen harjoittelun toiminnaksi, joka on järjestetty parantamaan tiettyä osa-aluetta palautteen ja korjauksen kanssa, sen sijaan että vain toistetaan jo mukavaa. Vuoden 1993 artikkeli kehitti kehystä muusikkotutkimuksilla. Se ei julkaissut tuntimäärää, joka tuottaa asiantuntijoita jokaisella alalla. Macnamara, Hambrick ja Oswald arvioivat myöhemmin, kuinka suuri osa suorituseroista liittyi tarkoitukselliseen harjoitteluun. Osuudet erosivat alueittain: korkeampia peleissä, musiikissa ja urheilussa kuin koulutuksessa ja ammateissa.";
"theory_chapter_1000_example" = "Tunti kohtaan, joka yhä hajoaa, on eri toimintaa kuin tunti kappaleita, jotka jo sujuvat. Edistymispalkki kirjaa ajan molemmissa tapauksissa.";
"theory_chapter_1000_caveat" = "Alueprosentit ovat varianssin osuuksia vuoden 2014 meta-analyysissä. Ne eivät ole taidon osuus, jonka voi oppia, eivätkä kenenkään menestymismahdollisuus. Artikkeli ei aseta 1000 tuntia ammattikynnykseksi. Sovelluksen vanha sanamuoto, joka käsitteli 1000 tuntia ammattilaiseksi tulemisen hetkenä, liioitteli näyttöä.";
"theory_chapter_10000_title" = "Kuuluisa luku, ei laki";
"theory_chapter_10000_lead" = "Kymmenentuhatta tuntia tuli kuuluisaksi mestaruussääntönä. Tutkimus, josta se johdettiin, ei vahvistanut lakia, ja tämän välilehden kristalli merkitsee vain sovelluksen korkeinta näytettyä tuntimerkkiä.";
"theory_chapter_10000_mechanism_title" = "Miten luku matkusti";
"theory_chapter_10000_mechanism" = "Malcolm Gladwellin Outliers (2008) teki pyöreän luvun laajalti tunnetuksi. Se nojasi asiantuntijasuorituksen tutkimukseen, mukaan lukien Ericssonin, Krampen ja Tesch-Römerin vuoden 1993 artikkeli tarkoituksellisesta harjoittelusta muusikoilla. Macnamara ja Maitra (2019) käsittelevät, miten tuo suosittu sääntö eroaa tutkimuksesta. Suosittu versio tiivisti monimutkaisen argumentin yhdeksi kynnykseksi, joka takaisi mestaruuden.";
"theory_chapter_10000_example" = "Kaksi ihmistä voi kirjata saman summan ja silti käyttää ajan eri tavalla. Toisella saattoi olla opettaja, joka korjasi tietyn virheen. Toinen saattoi toistaa kappaletta, jota jo soittaa. Tuntisumma ei kirjaa sitä eroa.";
