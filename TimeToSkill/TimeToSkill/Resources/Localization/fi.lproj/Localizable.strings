"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "Meta-analyysi kävi läpi 317 koetta 184 artikkelissa, 839 hajautetun harjoittelun arviolla.";
"theory_topic_spacing_limitation" = "Nämä tulokset koskevat oppimis- ja mieleenpalautustehtäviä. Ne eivät esitä yhtä optimaalista aikataulua jokaiselle fyysiselle, sosiaaliselle, taiteelliselle tai ammatilliselle taidolle.";
"theory_topic_habit_title" = "Tottumuksella ei ole yleistä määräaikaa";
"theory_topic_habit_summary" = "Toiminnon toistaminen samassa kontekstissa voi tehdä siitä ajan myötä automaattisemman. Tarvittava aika kuitenkin vaihtelee ihmisten ja käyttäytymisten välillä. Yhden päivän väliin jättäminen ei tarkoita, että kaikki edistyminen on menetetty.";
"theory_topic_habit_takeaway" = "Liitä toiminta tilanteeseen, jonka tapaat säännöllisesti, ja jatka ilman syyllisyyttä, kun sessio jää väliin.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "Yhdeksänkymmentäkuusi vapaaehtoista valitsi syömis-, juomis- tai aktiviteettikäyttäytymisen toistettavaksi samassa kontekstissa 12 viikon ajan. Kahdeksankymmentäkaksi osallistujaa antoi riittävästi dataa. Mallinnettu aika 95 %:iin asymptoottisesta automatisaatioestimaatista vaihteli 18–254 päivään.";
"theory_topic_habit_limitation" = "Tämä oli tottumuksen muodostumisen tutkimus, ei tutkimus siitä, kuinka monta tuntia mestaruuteen tarvitaan. Se ei tue 21 tunnin mestaruuskynnystä eikä yleistä 21 päivän tottumussääntöä.";
