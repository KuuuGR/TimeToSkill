"theory_topic_first20_title" = "Ensimmäiset 20 tuntia: alun ohi";
"theory_topic_first20_summary" = "Taidon aloittaminen on usein turhauttavaa, koska kaikki on vierasta. Josh Kaufman ehdottaa käytännön tapaa: jaa taito, keskity olennaiseen, poista harjoitusesteet ja käytä keskittynyttä aikaa parantamiseen. Hänen 20 tunnin kehyksensä on aloitusmenetelmä, ei tieteellinen takuu siitä, että mikä tahansa taito hallitaan 20 tunnissa.";
"theory_topic_first20_takeaway" = "Valitse yksi konkreettinen asia, jonka haluat osata paremmin ensimmäisten 20 tunnin jälkeen.";
"theory_topic_first20_citation" = "Josh Kaufman. The First 20 Hours: How to Learn Anything… Fast! Ebook published in 2013; paperback published in 2014.";
"theory_topic_first20_context" = "Kirjoittajan käytännön kehys ja kirja, ei kontrolloitu tieteellinen tutkimus.";
"theory_topic_first20_limitation" = "20 tunnin kehys on aloitusmenetelmä. Se ei ole tieteellisesti vakiintunut aika mestaruuteen.";
"theory_topic_deliberate_title" = "Harjoittele tarkoituksella";
"theory_topic_deliberate_summary" = "Toiminnan toistaminen ei ole sama kuin sen tarkoituksellinen parantaminen. Valitse tietty osa-alue, harjoittele selkeällä tavoitteella, huomaa virheet ja säädä seuraavaa yritystä. Ajan seuranta on hyödyllistä, mutta myös harjoittelutapa merkitsee.";
"theory_topic_deliberate_takeaway" = "Ennen sessiota päätä yksi asia, jota haluat parantaa.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "Artikkeli kehitti asiantuntijasuorituksen kehyksen ja raportoi tutkimuksia muusikoilla, mukaan lukien viulistit ja pianistit.";
"theory_topic_deliberate_limitation" = "Artikkeli ei aseta yhtä kiinteää harjoitustuntimäärää, joka takaa mestaruuden kaikissa taidoissa.";
"theory_topic_10k_title" = "10 000 tuntia: suosittu sääntö, ei laki";
"theory_topic_10k_summary" = "10 000 tunnin sääntö tuli laajalti tunnetuksi Malcolm Gladwellin Outliersin (2008) kautta. Se nojasi asiantuntijasuorituksen tutkimukseen, mutta suosittu versio yksinkertaisti alkuperäistä argumenttia. Ei ole universaalia maagista tuntimäärää, joka takaa mestaruuden.";
"theory_topic_10k_takeaway" = "Käytä pitkän aikavälin merkkipaaluja juhlistaaksesi sinnikkyyttä, älä ennustaaksesi milloin sinusta tulee asiantuntija.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "10 000 tunnin sääntö tuli laajalti tunnetuksi Malcolm Gladwellin Outliersin (2008) kautta. Vuoden 2019 artikkeli käsittelee, miten tuo suosittu sääntö eroaa vuoden 1993 tutkimuksesta.";
"theory_topic_10k_limitation" = "Ericsson ja kollegat eivät vahvistaneet universaalia 10 000 tunnin mestaruuslakia. Ei ole universaalia tuntimäärää, joka takaa mestaruuden.";
"theory_topic_variance_title" = "Harjoittelu merkitsee, mutta se ei ole kaikki";
"theory_topic_variance_summary" = "Vuoden 2014 meta-analyysi tutki tarkoituksellista harjoittelua useilla aloilla. Harjoittelu liittyi suoritukseen, mutta sen panos vaihteli huomattavasti alueittain.";
"theory_topic_variance_takeaway" = "Harjoittelu on jotain, johon voit vaikuttaa. Tulokset riippuvat myös muista tekijöistä, jotka vaihtelevat toiminnan mukaan.";
