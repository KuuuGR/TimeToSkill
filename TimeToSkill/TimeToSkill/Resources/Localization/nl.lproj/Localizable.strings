"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "De meta-analyse bekeek 317 experimenten in 184 artikelen, met 839 beoordelingen van gespreide praktijk.";
"theory_topic_spacing_limitation" = "Deze resultaten betreffen leer- en herinnertaken. Ze bieden geen optimaal schema voor elke fysieke, sociale, artistieke of professionele vaardigheid.";
"theory_topic_habit_title" = "Een gewoonte heeft geen universele deadline";
"theory_topic_habit_summary" = "Een handeling in dezelfde context herhalen kan die met de tijd automatischer maken. De benodigde tijd verschilt echter tussen mensen en gedragingen. Eén gemiste dag betekent niet dat alle vooruitgang weg is.";
"theory_topic_habit_takeaway" = "Koppel een activiteit aan een situatie die je regelmatig tegenkomt, en hervat zonder schuldgevoel als een sessie uitvalt.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "Zesennegentig vrijwilligers kozen een eet-, drink- of activiteitsgedrag om twaalf weken in dezelfde context te herhalen. Tweeëntachtig deelnemers leverden voldoende data. De gemodelleerde tijd tot 95% van de asymptotische automatiseringsschatting varieerde van 18 tot 254 dagen.";
"theory_topic_habit_limitation" = "Dit was een studie naar gewoontevorming, geen studie naar hoeveel uur tot meesterschap nodig is. Het ondersteunt geen meesterschapsdrempel van 21 uur en geen universele gewoonteregel van 21 dagen.";
"theory_milestones_title" = "Voortgangsmijlpalen";
"theory_milestones_note" = "The 100-hour, 1,000-hour, and 10,000-hour marks in Time4Skill record time you have spent. They are progress milestones, not scientifically validated stages, and they do not predict when you will become an expert.";
