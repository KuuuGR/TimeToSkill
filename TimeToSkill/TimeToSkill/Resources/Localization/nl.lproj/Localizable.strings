/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Dit scherm toont de vaardigheden die bij de app horen: de oorspronkelijke set plus items uit de uitgewerkte catalogus.";
"theory_compendium_intro" = "Elk tabblad is een urenmarkering die de voortgangsbalk al gebruikt. Het kristal is de kleur van die markering. De tekst legt uit wat de markering wel en niet betekent.";
"theory_hour_unit" = "uur";
"theory_callout_example" = "Voorbeeld";
"theory_callout_caveat" = "Kanttekening";
"theory_callout_takeaway" = "Leerpunt";
"theory_chapter_21_title" = "Voorbij het begin komen";
"theory_chapter_21_lead" = "Eenentwintig uur verandert de kleur van de voortgangsbalk. Dat is geen onderzoeksbevinding. De dichtstbijzijnde gepubliceerde methode is Josh Kaufmans kader van 20 uur om het ongemakkelijke begin te doorstaan, en die twee getallen zijn niet dezelfde bewering.";
"theory_chapter_21_mechanism_title" = "Een methode voor de start";
"theory_chapter_21_mechanism" = "Kaufman behandelt het begin als een praktisch probleem. Splits de vaardigheid in kleinere delen, leer genoeg om je eigen fouten te zien, verwijder obstakels die oefenen lastig maken, en besteed gerichte tijd aan één resultaat. Het boek presenteert dit als een auteursmethode om te beginnen.";
"theory_chapter_21_example" = "Iemand die wil dat drie akkoorden schoon klinken, kan precies dat resultaat oefenen. „Gitaar leren” is een groter doel, en de eerste uren beslissen het niet.";
"theory_chapter_100_title" = "Honderd uur als app-markering";
"theory_chapter_100_lead" = "Honderd uur is een Time4Skill-mijlpaal voor al geregistreerde tijd. Geen van de studies in dit compendium definieert 100 uur als het punt waarop iemand bekwaam wordt.";
"theory_chapter_100_mechanism_title" = "Wat nabij onderzoek echt mat";
"theory_chapter_100_mechanism" = "Twee onderzoekslijnen liggen dicht bij deze periode zonder die in uren te meten. Cepeda, Pashler, Vul, Wixted en Rohrer bekeken 317 experimenten over verbale herinnering. Verspreide sessies versloegen stampwerk in die literatuur, en de nuttige tussenruimte hing af van hoe lang het materiaal onthouden moest worden. Lally, van Jaarsveld, Potts en Wardle vroegen vrijwilligers een eet-, drink- of activiteitsgedrag in dezelfde context te herhalen. De gemodelleerde tijd tot 95 procent van ieders eigen plateau varieerde sterk. Eén gemiste dag wiste de curve niet.";
"theory_chapter_100_example" = "Een kort stuk op drie verschillende dagen spelen laat zien welke maat echt in het geheugen bleef. Eén lange avond herhalen beantwoordt die vraag niet.";
"theory_chapter_100_caveat" = "Het overzicht over spreiding gaat over verbale herinnering. De gewoontestudie gaat over automatisering van gekozen gedrag, en het bereik in het model bij het artikel was 18 tot 254 dagen — geen bekwaamheidslijn bij 100 uur. Geen resultaat zegt dat 100 uur iemand bekwaam maakt in fotografie, autorijden of een andere vaardigheid.";
"theory_chapter_100_takeaway" = "Gebruik de markering om te merken of je terugkomt. Behandel hem niet als een verdiend niveau.";
"theory_chapter_1000_title" = "Oefening gericht op één gat";
"theory_chapter_1000_lead" = "Het kristal van 1000 uur registreert bestede tijd. Het betekent niet dat de persoon nu professional, leraar of iemand is die van de vaardigheid kan leven.";
"theory_chapter_1000_mechanism_title" = "Doelgerichte praktijk, en hoeveel die verklaarde";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe en Tesch-Römer beschreven doelgerichte praktijk als activiteit gericht op het verbeteren van een specifiek aspect, met feedback en correctie, in plaats van alleen herhalen wat al comfortabel is. Hun artikel uit 1993 ontwikkelde dat kader met studies van musici. Het publiceerde geen urenaantal dat experts in elk veld maakt. Macnamara, Hambrick en Oswald schatten later hoeveel van de prestatieverschillen samenhing met doelgerichte praktijk. De aandelen verschilden per domein: hoger in games, muziek en sport dan in onderwijs en beroepen.";
"theory_chapter_1000_example" = "Een uur aan de passage die steeds misgaat is een andere activiteit dan een uur stukken die al goed gaan. De voortgangsbalk registreert de tijd in beide gevallen.";
"theory_chapter_1000_caveat" = "De domeinpercentages zijn aandelen van variantie in die meta-analyse uit 2014. Ze zijn niet het deel van een vaardigheid dat iemand kan leren, en niet iemands slagingskans. Het artikel stelt 1000 uur niet als professionele drempel. Oudere app-tekst die 1000 uur als het moment van professional worden behandelde, overdreef het bewijs.";
"theory_chapter_10000_title" = "Een beroemd getal, geen wet";
"theory_chapter_10000_lead" = "Tienduizend uur werd beroemd als meesterschapsregel. Het onderzoek waaruit het kwam, stelde geen wet vast, en het kristal op dit tabblad markeert alleen de hoogste weergegeven urenmarkering van de app.";
"theory_chapter_10000_mechanism_title" = "Hoe het getal reisde";
"theory_chapter_10000_mechanism" = "Malcolm Gladwells Outliers (2008) maakte het ronde getal breed bekend. Het steunde op onderzoek naar expertprestaties, waaronder het artikel uit 1993 van Ericsson, Krampe en Tesch-Römer over doelgerichte praktijk bij musici. Macnamara en Maitra (2019) bespreken hoe die populaire regel verschilt van het onderzoek. De populaire versie perste een complex argument samen tot één drempel die meesterschap zou garanderen.";
"theory_chapter_10000_example" = "Twee mensen kunnen hetzelfde totaal registreren en de tijd toch anders hebben besteed. De een had misschien een leraar die een specifiek foutje corrigeerde. De ander herhaalde misschien een stuk dat al speelbaar is. Het urentotaal legt dat verschil niet vast.";
