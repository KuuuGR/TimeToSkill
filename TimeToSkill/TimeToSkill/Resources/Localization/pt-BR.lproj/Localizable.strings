/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Esta tela lista as habilidades incluídas no app: o conjunto original mais as entradas do catálogo elaborado.";
"theory_compendium_intro" = "Cada aba é uma marca de horas já usada pela barra de progresso. O cristal é a cor dessa marca. O texto explica o que a marca significa — e o que não significa.";
"theory_hour_unit" = "horas";
"theory_callout_example" = "Exemplo";
"theory_callout_caveat" = "Ressalva";
"theory_callout_takeaway" = "Conclusão";
"theory_chapter_21_title" = "Passar do começo";
"theory_chapter_21_lead" = "Vinte e uma horas mudam a cor da barra de progresso. Isso não é um achado de pesquisa. O método publicado mais próximo é o quadro de 20 horas de Josh Kaufman para sobreviver ao começo desajeitado, e esses dois números não são a mesma afirmação.";
"theory_chapter_21_mechanism_title" = "Um método para o início";
"theory_chapter_21_mechanism" = "Kaufman trata o começo como um problema prático. Divida a habilidade em partes menores, aprenda o suficiente para perceber seus próprios erros, remova barreiras que tornam a prática inconveniente e dedique tempo focado a um resultado. O livro apresenta isso como um método do autor para começar.";
"theory_chapter_21_example" = "Quem quer que três acordes soem limpos pode praticar exatamente esse resultado. “Aprender violão” é um objetivo maior, e as primeiras horas não o resolvem.";
"theory_chapter_100_title" = "Cem horas como marca do app";
"theory_chapter_100_lead" = "Cem horas é um marco do Time4Skill para o tempo já registrado. Nenhum dos estudos reunidos neste compêndio define 100 horas como o ponto em que alguém se torna competente.";
"theory_chapter_100_mechanism_title" = "O que a pesquisa próxima de fato mediu";
"theory_chapter_100_mechanism" = "Duas linhas de trabalho ficam perto desse período sem medi-lo em horas. Cepeda, Pashler, Vul, Wixted e Rohrer revisaram 317 experimentos sobre recordação verbal. Espaçar as sessões vencia a memorização concentrada nessa literatura, e o intervalo útil dependia de quanto tempo o material precisava ser lembrado. Lally, van Jaarsveld, Potts e Wardle pediram a voluntários que repetissem um comportamento de comer, beber ou atividade no mesmo contexto. O tempo modelado para chegar a 95 por cento do platô próprio de cada pessoa variou bastante. Perder um dia não apagava a curva.";
"theory_chapter_100_example" = "Tocar um trecho curto em três dias diferentes mostra qual compasso realmente ficou na memória. Uma longa noite de repetição não responde a essa pergunta.";
"theory_chapter_100_caveat" = "A revisão sobre espaçamento trata de recordação verbal. O estudo de hábito trata da automaticidade de um comportamento escolhido, e a faixa no modelo relatado com o artigo foi de 18 a 254 dias, não uma linha de competência em 100 horas. Nenhum resultado diz que 100 horas tornam alguém competente em fotografia, direção ou qualquer outra habilidade.";
"theory_chapter_100_takeaway" = "Use a marca para notar se você está voltando. Não a trate como um nível conquistado.";
"theory_chapter_1000_title" = "Prática voltada a uma lacuna";
"theory_chapter_1000_lead" = "O cristal de 1.000 horas registra o tempo gasto. Não significa que a pessoa agora é profissional, professora ou alguém que pode viver da habilidade.";
"theory_chapter_1000_mechanism_title" = "Prática deliberada e quanto ela explicou";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe e Tesch-Römer descreveram a prática deliberada como atividade organizada para melhorar um aspecto específico, com feedback e correção, em vez de apenas repetir o que já é confortável. O artigo de 1993 desenvolveu esse quadro com estudos de músicos. Não publicou uma contagem de horas que cria especialistas em todo campo. Macnamara, Hambrick e Oswald depois estimaram quanto da diferença de desempenho estava associado à prática deliberada. As parcelas diferiam por domínio: maiores em jogos, música e esportes do que em educação e profissões.";
"theory_chapter_1000_example" = "Uma hora no trecho que continua falhando é uma atividade diferente de uma hora tocando peças que já saem bem. A barra de progresso registra o tempo nos dois casos.";
"theory_chapter_1000_caveat" = "Os percentuais por domínio são parcelas de variância na meta-análise de 2014. Não são a porção de uma habilidade que alguém pode aprender, nem a chance de sucesso de ninguém. O artigo não define 1.000 horas como limiar profissional. Uma redação antiga no app que tratava 1.000 horas como o momento de se tornar profissional exagerava as evidências.";
"theory_chapter_10000_title" = "Um número famoso, não uma lei";
"theory_chapter_10000_lead" = "Dez mil horas ficaram famosas como regra de maestria. A pesquisa de onde isso veio não estabeleceu uma lei, e o cristal nesta aba só identifica a marca de horas mais alta exibida pelo app.";
"theory_chapter_10000_mechanism_title" = "Como o número viajou";
"theory_chapter_10000_mechanism" = "Outliers (2008), de Malcolm Gladwell, tornou o número redondo amplamente conhecido. Apoiou-se em pesquisa sobre desempenho de especialistas, incluindo o artigo de 1993 de Ericsson, Krampe e Tesch-Römer sobre prática deliberada entre músicos. Macnamara e Maitra (2019) discutem como essa regra popular difere da pesquisa. A versão popular comprimiu um argumento complexo em um limiar que garantiria a maestria.";
"theory_chapter_10000_example" = "Duas pessoas podem registrar o mesmo total e mesmo assim terem passado o tempo de formas diferentes. Uma pode ter tido um professor corrigindo uma falha específica. A outra pode ter repetido uma peça que já toca. O total de horas não registra essa diferença.";
