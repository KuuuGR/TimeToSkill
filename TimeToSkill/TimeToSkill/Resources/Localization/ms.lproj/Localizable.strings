/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Esta pantalla lista las habilidades incluidas con la aplicación: el conjunto original más las entradas aceptadas de la colección desarrollada. Los archivos de propuestas piloto no son, por sí solos, el catálogo.";
"theory_compendium_intro" = "Setiap tab ialah tanda jam yang sudah digunakan oleh bar kemajuan. Kristal ialah warna tanda itu. Teks menjelaskan maksud tanda itu — dan apa yang tidak.";
"theory_hour_unit" = "jam";
"theory_callout_example" = "Contoh";
"theory_callout_caveat" = "Nota";
"theory_callout_takeaway" = "Pengajaran";
"theory_chapter_21_title" = "Melepasi permulaan";
"theory_chapter_21_lead" = "Dua puluh satu jam mengubah warna bar kemajuan. Itu bukan penemuan penyelidikan. Kaedah diterbitkan yang paling hampir ialah rangka 20 jam Josh Kaufman untuk bertahan di permulaan yang kekok, dan kedua-dua nombor itu bukan dakwaan yang sama.";
"theory_chapter_21_mechanism_title" = "Metode untuk memulai";
"theory_chapter_21_mechanism" = "Kaufman memperlakukan awal sebagai masalah praktis. Bagi keterampilan menjadi bagian lebih kecil, belajar cukup untuk menyadari kesalahan sendiri, hilangkan hambatan yang membuat latihan sulit, dan luangkan waktu terfokus pada satu hasil. Buku menyajikan itu sebagai metode penulis untuk memulai.";

"theory_chapter_100_title" = "Seratus jam sebagai tanda aplikasi";
"theory_chapter_100_lead" = "Seratus jam adalah tonggak Time4Skill untuk waktu yang sudah dicatat. Tidak ada studi dalam kompendium ini yang mendefinisikan 100 jam sebagai titik seseorang menjadi kompeten.";
"theory_chapter_100_mechanism_title" = "Apa yang benar-benar diukur penelitian terdekat";
"theory_chapter_100_mechanism" = "Dua jalur kerja berada dekat periode ini tanpa mengukurnya dalam jam. Cepeda, Pashler, Vul, Wixted, dan Rohrer meninjau 317 eksperimen tentang mengingat verbal. Menyebar sesi mengalahkan cramming dalam literatur itu, dan jarak berguna bergantung pada berapa lama materi harus diingat. Lally, van Jaarsveld, Potts, dan Wardle meminta sukarelawan mengulang perilaku makan, minum, atau aktivitas dalam konteks yang sama. Waktu termodel untuk mencapai 95 persen plateau masing-masing orang sangat bervariasi. Kehilangan satu hari tidak menghapus kurva.";
"theory_chapter_100_example" = "Memainkan potongan pendek pada tiga hari berbeda menunjukkan birama mana yang benar-benar tinggal dalam memori. Satu malam panjang pengulangan tidak menjawab pertanyaan itu.";
"theory_chapter_100_caveat" = "Tinjauan tentang jarak menyangkut mengingat verbal. Studi kebiasaan menyangkut otomatisitas perilaku yang dipilih, dan rentangnya 18 hingga 254 hari dalam model yang dilaporkan bersama artikel, bukan garis kompetensi pada 100 jam. Tidak ada hasil yang mengatakan 100 jam membuat seseorang kompeten dalam fotografi, mengemudi, atau keterampilan lain.";
"theory_chapter_100_takeaway" = "Gunakan tanda untuk menyadari apakah Anda kembali. Jangan perlakukan sebagai level yang sudah didapat.";
"theory_chapter_1000_title" = "Latihan yang ditujukan pada satu celah";
"theory_chapter_1000_lead" = "Kristal 1.000 jam mencatat waktu yang dihabiskan. Itu tidak berarti orang tersebut kini profesional, guru, atau seseorang yang bisa hidup dari keterampilan.";
"theory_chapter_1000_mechanism_title" = "Latihan yang disengaja, dan berapa banyak yang dijelaskannya";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe, dan Tesch-Römer menggambarkan latihan yang disengaja sebagai aktivitas yang disusun untuk memperbaiki aspek tertentu, dengan umpan balik dan koreksi, bukan sekadar mengulang yang sudah nyaman. Artikel 1993 mereka mengembangkan kerangka itu dengan studi musisi. Mereka tidak menerbitkan jumlah jam yang menciptakan ahli di setiap bidang. Macnamara, Hambrick, dan Oswald kemudian memperkirakan berapa banyak perbedaan kinerja terkait latihan yang disengaja. Baginya berbeda menurut domain: lebih tinggi dalam permainan, musik, dan olahraga daripada pendidikan dan profesi.";
"theory_chapter_1000_example" = "Satu jam pada bagian yang masih gagal adalah aktivitas berbeda dari satu jam memainkan karya yang sudah lancar. Bilah kemajuan mencatat waktu di kedua kasus.";
"theory_chapter_1000_caveat" = "Persentase domain adalah bagian varians dalam meta-analisis 2014 itu. Bukan porsi keterampilan yang bisa dipelajari, dan bukan peluang sukses siapa pun. Artikel tidak menetapkan 1.000 jam sebagai ambang profesional. Kata-kata lama di aplikasi yang memperlakukan 1.000 jam sebagai titik menjadi profesional melebih-lebihkan bukti.";
"theory_chapter_10000_title" = "Angka terkenal, bukan hukum";
"theory_chapter_10000_lead" = "Sepuluh ribu jam menjadi terkenal sebagai aturan penguasaan. Penelitian yang mendasarinya tidak menetapkan hukum, dan kristal pada tab ini hanya menandai tanda jam tertinggi yang ditampilkan aplikasi.";
"theory_chapter_10000_mechanism_title" = "Bagaimana angka itu berkelana";
"theory_chapter_10000_mechanism" = "Outliers (2008) karya Malcolm Gladwell membuat angka bulat itu dikenal luas. Ia mengacu pada penelitian kinerja ahli, termasuk artikel 1993 Ericsson, Krampe, dan Tesch-Römer tentang latihan yang disengaja di kalangan musisi. Macnamara dan Maitra (2019) membahas bagaimana aturan populer itu berbeda dari penelitian. Versi populer meruntuhkan argumen rumit menjadi satu ambang yang menjamin penguasaan.";
"theory_chapter_10000_example" = "Dua orang dapat mencatat total yang sama dan tetap menghabiskan waktu berbeda. Satu mungkin punya guru yang memperbaiki kesalahan tertentu. Yang lain mungkin mengulang karya yang sudah bisa dimainkan. Total jam tidak mencatat perbedaan itu.";
