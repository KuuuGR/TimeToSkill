"theory_topic_first20_title" = "पहले 20 घंटे: शुरुआत पार करना";
"theory_topic_first20_summary" = "कौशल शुरू करना अक्सर निराशाजनक होता है क्योंकि सब अपरिचित है। जोश कॉफ़मैन व्यावहारिक दृष्टिकोण सुझाते हैं: कौशल बाँटें, महत्वपूर्ण पर ध्यान दें, अभ्यास बाधाएँ हटाएँ, और सुधार पर केंद्रित समय दें। उनका 20 घंटे का ढाँचा शुरुआत विधि है, यह वैज्ञानिक गारंटी नहीं कि कोई भी कौशल 20 घंटे में महारत हासिल करता है।";
"theory_topic_first20_takeaway" = "पहले 20 घंटों के बाद बेहतर करने योग्य एक ठोस चीज़ चुनें।";
"theory_topic_first20_citation" = "Josh Kaufman. The First 20 Hours: How to Learn Anything… Fast! Ebook published in 2013; paperback published in 2014.";
"theory_topic_first20_context" = "लेखक का व्यावहारिक ढाँचा और पुस्तक, नियंत्रित वैज्ञानिक अध्ययन नहीं।";
"theory_topic_first20_limitation" = "20 घंटे का ढाँचा शुरुआत विधि है। महारत के लिए वैज्ञानिक रूप से स्थापित समय नहीं है।";
"theory_topic_deliberate_title" = "उद्देश्य के साथ अभ्यास";
"theory_topic_deliberate_summary" = "गतिविधि दोहराना जानबूझकर सुधारने के समान नहीं है। विशिष्ट पहलू चुनें, स्पष्ट लक्ष्य से अभ्यास करें, त्रुटियाँ देखें और अगला प्रयास समायोजित करें। समय ट्रैक करना उपयोगी है, पर अभ्यास का तरीका भी मायने रखता है।";
"theory_topic_deliberate_takeaway" = "सत्र से पहले तय करें कि आप क्या एक चीज़ सुधारना चाहते हैं।";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "लेख ने विशेषज्ञ प्रदर्शन का ढाँचा विकसित किया और वायलिन वादकों तथा पियानो वादकों सहित संगीतकारों के अध्ययन बताए।";
"theory_topic_deliberate_limitation" = "लेख सभी कौशलों में महारत की गारंटी देने वाले अभ्यास घंटों की एक निश्चित संख्या स्थापित नहीं करता।";
"theory_topic_10k_title" = "10,000 घंटे: लोकप्रिय नियम, कानून नहीं";
"theory_topic_10k_summary" = "10,000 घंटे का नियम मैल्कम ग्लैडवेल की Outliers (2008) से व्यापक रूप से लोकप्रिय हुआ। यह विशेषज्ञ प्रदर्शन शोध पर आधारित था, पर लोकप्रिय संस्करण ने मूल तर्क सरल बना दिया। कोई सार्वभौमिक जादुई घंटे संख्या महारत की गारंटी नहीं देती।";
"theory_topic_10k_takeaway" = "दीर्घकालिक मील के पत्थर दृढ़ता मनाने के लिए उपयोग करें, यह भविष्यवाणी करने के लिए नहीं कि आप कब विशेषज्ञ बनेंगे।";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "10,000 घंटे का नियम मैल्कम ग्लैडवेल की Outliers (2008) से व्यापक रूप से लोकप्रिय हुआ। 2019 का लेख चर्चा करता है कि वह लोकप्रिय नियम 1993 शोध से कैसे भिन्न है।";
"theory_topic_10k_limitation" = "एरिक्सन और सहयोगियों ने सार्वभौमिक 10,000 घंटे महारत कानून स्थापित नहीं किया। कोई सार्वभौमिक घंटे संख्या महारत की गारंटी नहीं देती।";
"theory_topic_variance_title" = "अभ्यास मायने रखता है, पर सब कुछ नहीं";
"theory_topic_variance_summary" = "2014 मेटा-विश्लेषण ने कई क्षेत्रों में सचेत अभ्यास जाँचा। अभ्यास प्रदर्शन से जुड़ा, पर योगदान क्षेत्रानुसार बहुत भिन्न था।";
"theory_topic_variance_takeaway" = "अभ्यास ऐसी चीज़ है जिस पर आप प्रभाव डाल सकते हैं। परिणाम अन्य कारकों पर भी निर्भर करते हैं जो गतिविधियों में भिन्न हैं।";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick, and Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "2014 मेटा-विश्लेषण ने कई क्षेत्रों में सचेत अभ्यास जाँचा। अभ्यास प्रदर्शन से जुड़ा, पर योगदान क्षेत्रानुसार बहुत भिन्न था।";
"theory_topic_variance_findings_intro" = "इस विश्लेषण में सचेत अभ्यास द्वारा समझाए गए प्रदर्शन अंतर का अनुमानित अंश था:";
"theory_topic_variance_limitation" = "ये प्रतिशत इस मेटा-विश्लेषण में समझाए गए प्रदर्शन विचरण से संबंधित हैं। वे कौशल का प्रतिशत नहीं जो व्यक्ति सीख सकता है, न व्यक्तिगत सफलता की संभावना।";
