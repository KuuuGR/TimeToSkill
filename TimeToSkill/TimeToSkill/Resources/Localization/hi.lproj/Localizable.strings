"theory_topic_spacing_title" = "सब कुछ एक साथ रटने के बजाय कौशल पर लौटें";
"theory_topic_spacing_summary" = "वितरित अभ्यास शोध कई सत्रों में सीखने का समर्थन करता है, न कि केवल सघन अभ्यास पर निर्भरता। सबसे अच्छा अंतराल सामग्री और आप कितने समय याद रखना चाहते हैं इस पर निर्भर करता है।";
"theory_topic_spacing_takeaway" = "कुछ दिनों तक कौशल पर लौटकर देखें कि आप क्या याद रखते हैं और किसे और अभ्यास चाहिए।";
"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "मेटा-विश्लेषण ने 184 लेखों में 317 प्रयोगों की समीक्षा की, जिसमें वितरित अभ्यास के 839 आकलन थे।";
"theory_topic_spacing_limitation" = "ये परिणाम अधिगम और स्मरण कार्यों से संबंधित हैं। वे हर शारीरिक, सामाजिक, कलात्मक या पेशेवर कौशल के लिए एक इष्टतम अनुसूची नहीं देते।";
"theory_topic_habit_title" = "आदत की कोई सार्वभौमिक समयसीमा नहीं";
"theory_topic_habit_summary" = "एक ही संदर्भ में क्रिया दोहराने से समय के साथ वह अधिक स्वचालित हो सकती है। पर आवश्यक समय लोगों और व्यवहारों में भिन्न होता है। एक दिन छोड़ने का अर्थ यह नहीं कि सारी प्रगति खो गई।";
"theory_topic_habit_takeaway" = "गतिविधि को उस स्थिति से जोड़ें जो आप नियमित रूप से देखते हैं, और जब सत्र छूटे तो अपराधबोध के बिना फिर शुरू करें।";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "छानबे स्वयंसेवकों ने 12 सप्ताह तक एक ही संदर्भ में दोहराने के लिए खाने, पीने या गतिविधि व्यवहार चुना। बयासी प्रतिभागियों ने पर्याप्त डेटा दिया। असिम्प्टोटिक स्वचालितता अनुमान के 95% तक पहुँचने का मॉडल समय 18 से 254 दिन तक था।";
"theory_topic_habit_limitation" = "यह आदत निर्माण अध्ययन था, यह अध्ययन नहीं कि कौशल में महारत के लिए कितने घंटे लगते हैं। यह 21 घंटे महारत सीमा या सार्वभौमिक 21 दिन आदत नियम का समर्थन नहीं करता।";
"theory_milestones_title" = "प्रगति के मील के पत्थर";
"theory_milestones_note" = "The 100-hour, 1,000-hour, and 10,000-hour marks in Time4Skill record time you have spent. They are progress milestones, not scientifically validated stages, and they do not predict when you will become an expert.";
