"theory_compendium_intro" = "प्रत्येक टैब प्रगति पट्टी द्वारा पहले से प्रयुक्त घंटे का चिह्न है। क्रिस्टल उसी चिह्न का रंग है। पाठ बताता है कि चिह्न का अर्थ क्या है — और क्या नहीं।";
"theory_hour_unit" = "घंटे";
"theory_callout_example" = "उदाहरण";
"theory_callout_caveat" = "चेतावनी";
"theory_callout_takeaway" = "मुख्य बात";
"theory_chapter_21_title" = "शुरुआत पार करना";
"theory_chapter_21_lead" = "इक्कीस घंटे प्रगति पट्टी का रंग बदलते हैं। यह शोध निष्कर्ष नहीं है। निकटतम प्रकाशित विधि जोश कॉफ़मैन का 20 घंटे का ढाँचा है जिससे अटपटी शुरुआत पार हो, और ये दो संख्याएँ एक ही दावा नहीं हैं।";
"theory_chapter_21_mechanism_title" = "शुरुआत की विधि";
"theory_chapter_21_mechanism" = "कॉफ़मैन शुरुआत को व्यावहारिक समस्या मानते हैं। कौशल को छोटे हिस्सों में बाँटें, अपनी गलतियाँ पहचानने जितना सीखें, अभ्यास को असुविधाजनक बनाने वाली बाधाएँ हटाएँ, और एक परिणाम पर केंद्रित समय दें। पुस्तक इसे लेखक की शुरुआत विधि के रूप में प्रस्तुत करती है।";
"theory_chapter_21_example" = "जो चाहता है कि तीन कॉर्ड साफ़ लगें, वह ठीक उसी परिणाम का अभ्यास कर सकता है। \"गिटार सीखना\" बड़ा लक्ष्य है, और पहले घंटे उसे तय नहीं करते।";
"theory_chapter_100_title" = "ऐप चिह्न के रूप में सौ घंटे";
"theory_chapter_100_lead" = "सौ घंटे पहले से दर्ज समय के लिए Time4Skill मील का पत्थर हैं। इस संग्रह का कोई अध्ययन 100 घंटे को उस बिंदु के रूप में परिभाषित नहीं करता जहाँ कोई सक्षम हो जाता है।";
"theory_chapter_100_mechanism_title" = "निकटवर्ती शोध ने वास्तव में क्या मापा";
"theory_chapter_100_mechanism" = "दो शोध रेखाएँ इस अवधि के पास हैं बिना उसे घंटों में मापे। सेपेदा, पैशलर, वुल, विक्स्टेड और रोहरर ने मौखिक स्मरण पर 317 प्रयोगों की समीक्षा की। उस साहित्य में सत्र फैलाना रटने से बेहतर रहा, और उपयोगी अंतराल इस पर निर्भर था कि सामग्री कितने समय याद रखनी है। लैली, वैन यार्सवेल्ड, पॉट्स और वार्डल ने स्वयंसेवकों से एक ही संदर्भ में खाने, पीने या गतिविधि व्यवहार दोहराने को कहा। प्रत्येक व्यक्ति के अपने पठार के 95 प्रतिशत तक पहुँचने का मॉडल समय बहुत भिन्न था। एक दिन छोड़ने से वक्र मिटा नहीं।";
"theory_chapter_100_example" = "तीन अलग दिनों में छोटा अंश बजाना दिखाता है कि कौन-सा माप सच में स्मृति में रहा। दोहराव की एक लंबी शाम उस प्रश्न का उत्तर नहीं देती।";
"theory_chapter_100_caveat" = "अंतराल की समीक्षा मौखिक स्मरण के बारे में है। आदत अध्ययन चुने व्यवहार की स्वचालितता के बारे में है, और लेख के साथ बताए मॉडल की सीमा 18 से 254 दिन थी — 100 घंटे पर दक्षता रेखा नहीं। कोई परिणाम नहीं कहता कि 100 घंटे किसी को फ़ोटोग्राफ़ी, ड्राइविंग या किसी अन्य कौशल में सक्षम बनाते हैं।";
"theory_chapter_100_takeaway" = "चिह्न का उपयोग यह देखने के लिए करें कि आप लौट रहे हैं या नहीं। इसे अर्जित स्तर न मानें।";
"theory_chapter_1000_title" = "एक खाली जगह पर लक्षित अभ्यास";
"theory_chapter_1000_lead" = "1,000 घंटे का क्रिस्टल बिताए समय को दर्ज करता है। इसका अर्थ यह नहीं कि व्यक्ति अब पेशेवर, शिक्षक या कौशल से जीविका चलाने वाला है।";
"theory_chapter_1000_mechanism_title" = "सचेत अभ्यास, और उसने कितना समझाया";
"theory_chapter_1000_mechanism" = "एरिक्सन, क्राम्पे और टेश-रोमर ने सचेत अभ्यास को किसी विशिष्ट पहलू को सुधारने के लिए व्यवस्थित गतिविधि कहा, प्रतिक्रिया और सुधार के साथ, न कि केवल आरामदायक चीज़ दोहराना। उनके 1993 लेख ने संगीतकारों के अध्ययनों से वह ढाँचा विकसित किया। उन्होंने हर क्षेत्र में विशेषज्ञ बनाने वाली घंटों की संख्या प्रकाशित नहीं की। मैकनामारा, हैम्ब्रिक और ऑसवाल्ड ने बाद में अनुमान लगाया कि प्रदर्शन अंतर का कितना हिस्सा सचेत अभ्यास से जुड़ा। अंश क्षेत्रानुसार भिन्न थे: शिक्षा और व्यवसायों से अधिक खेल, संगीत और खेलकूद में।";
"theory_chapter_1000_example" = "अभी भी टूटने वाले अंश पर एक घंटा उन रचनाओं को बजाने से अलग गतिविधि है जो पहले से अच्छी चलती हैं। प्रगति पट्टी दोनों मामलों में समय दर्ज करती है।";
"theory_chapter_1000_caveat" = "क्षेत्र प्रतिशत 2014 मेटा-विश्लेषण में विचरण के अंश हैं। वे सीखे जा सकने वाले कौशल का हिस्सा नहीं, न किसी की सफलता की संभावना। लेख 1,000 घंटे को पेशेवर सीमा नहीं बनाता। ऐप का पुराना पाठ जो 1,000 घंटे को पेशेवर बनने का क्षण मानता था, साक्ष्य को बढ़ा-चढ़ाकर बताता था।";
"theory_chapter_10000_title" = "प्रसिद्ध संख्या, कानून नहीं";
"theory_chapter_10000_lead" = "दस हज़ार घंटे महारत नियम के रूप में प्रसिद्ध हुए। जिस शोध से वे आए, उसने कानून स्थापित नहीं किया, और इस टैब का क्रिस्टल केवल ऐप द्वारा दिखाए गए उच्चतम घंटे चिह्न को चिह्नित करता है।";
"theory_chapter_10000_mechanism_title" = "संख्या कैसे घूमी";
"theory_chapter_10000_mechanism" = "मैल्कम ग्लैडवेल की Outliers (2008) ने गोल संख्या को व्यापक रूप से जाना। यह विशेषज्ञ प्रदर्शन शोध पर आधारित थी, जिसमें संगीतकारों में सचेत अभ्यास पर एरिक्सन, क्राम्पे और टेश-रोमर का 1993 लेख शामिल है। मैकनामारा और मैत्रा (2019) चर्चा करते हैं कि वह लोकप्रिय नियम शोध से कैसे भिन्न है। लोकप्रिय संस्करण ने जटिल तर्क को एक सीमा में समेट दिया जो महारत की गारंटी देगा।";
"theory_chapter_10000_example" = "दो लोग एक ही योग दर्ज कर सकते हैं और फिर भी समय अलग खर्च कर सकते हैं। एक के पास विशिष्ट दोष सुधारने वाला शिक्षक हो सकता था। दूसरा पहले से बजाने योग्य रचना दोहरा सकता था। घंटों का योग उस अंतर को दर्ज नहीं करता।";
