/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Dieser Bildschirm listet die mit der App gelieferten Fähigkeiten: den ursprünglichen Satz plus Einträge aus dem erarbeiteten Katalog.";
"theory_compendium_intro" = "Her sekme, ilerleme çubuğunun zaten kullandığı bir saat işaretidir. Kristal, o işaretin rengidir. Metin, işaretin ne anlama geldiğini — ve gelmediğini — açıklar.";
"theory_hour_unit" = "saat";
"theory_callout_example" = "Örnek";
"theory_callout_caveat" = "Uyarı";
"theory_callout_takeaway" = "Çıkarım";
"theory_chapter_21_title" = "Başlangıcı geçmek";
"theory_chapter_21_lead" = "Yirmi bir saat ilerleme çubuğunun rengini değiştirir. Bu bir araştırma bulgusu değildir. En yakın yayımlanmış yöntem, Josh Kaufman'ın beceriksiz başlangıcı atlatmak için 20 saatlik çerçevesidir ve bu iki sayı aynı iddia değildir.";
"theory_chapter_21_mechanism_title" = "Başlangıç için bir yöntem";
"theory_chapter_21_mechanism" = "Kaufman başlangıcı pratik bir sorun olarak ele alır. Beceriyi daha küçük parçalara bölün, kendi hatalarınızı fark edecek kadar öğrenin, pratiği zorlaştıran engelleri kaldırın ve bir sonuca odaklanmış zaman ayırın. Kitap bunu başlamak için yazarın yöntemi olarak sunar.";
"theory_chapter_21_example" = "Üç akordun temiz çalmasını isteyen biri tam olarak o sonucu çalışabilir. \"Gitar öğrenmek\" daha büyük bir hedeftir ve ilk saatler bunu çözmez.";
"theory_chapter_100_title" = "Uygulama işareti olarak yüz saat";
"theory_chapter_100_lead" = "Yüz saat, zaten kaydedilmiş zaman için bir Time4Skill dönüm noktasıdır. Bu derlemedeki çalışmaların hiçbiri 100 saati birinin yetkinleştiği nokta olarak tanımlamaz.";
"theory_chapter_100_mechanism_title" = "Yakın araştırmanın gerçekte ölçtüğü şey";
"theory_chapter_100_mechanism" = "İki araştırma çizgisi, bunu saat cinsinden ölçmeden bu döneme yakındır. Cepeda, Pashler, Vul, Wixted ve Rohrer sözel hatırlama üzerine 317 deneyi gözden geçirdi. O literatmde oturumları yaymak ezbere çalışmayı yendi ve yararlı aralık, malzemenin ne kadar süre hatırlanması gerektiğine bağlıydı. Lally, van Jaarsveld, Potts ve Wardle gönüllülerden aynı bağlamda yeme, içme veya etkinlik davranışını tekrarlamalarını istedi. Her kişinin kendi platosunun yüzde 95'ine ulaşmak için modellenen süre geniş ölçüde değişti. Bir günü kaçırmak eğriyi silmedi.";
"theory_chapter_100_example" = "Kısa bir parçayı üç farklı günde çalmak, hangi ölçünün gerçekten bellekte kaldığını gösterir. Uzun bir tekrar akşamı bu soruyu yanıtlamaz.";
"theory_chapter_100_caveat" = "Aralık incelemesi sözel hatırlamayla ilgilidir. Alışkanlık çalışması seçilen davranışın otomatikleşmesiyle ilgilidir ve makaleyle bildirilen modeldeki aralık 18 ile 254 gün arasındaydı — 100 saatte bir yetkinlik çizgisi değil. Hiçbir sonuç 100 saatin fotoğrafçılık, araba kullanma veya başka bir beceride birini yetkin kıldığını söylemez.";
"theory_chapter_100_takeaway" = "İşareti geri gelip gelmediğinizi fark etmek için kullanın. Kazanılmış bir seviye gibi davranmayın.";
"theory_chapter_1000_title" = "Bir boşluğa yönelik pratik";
"theory_chapter_1000_lead" = "1000 saatlik kristal harcanan zamanı kaydeder. Kişinin artık profesyonel, öğretmen veya beceriden geçinen biri olduğu anlamına gelmez.";
"theory_chapter_1000_mechanism_title" = "Kasıtlı pratik ve ne kadar açıkladığı";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe ve Tesch-Römer kasıtlı pratiği, zaten rahat olanı tekrarlamak yerine geri bildirim ve düzeltmeyle belirli bir yönü geliştirmek üzere düzenlenmiş etkinlik olarak tanımladı. 1993 makaleleri bu çerçeveyi müzisyen çalışmalarıyla geliştirdi. Her alanda uzman yaratan bir saat sayısı yayımlamadılar. Macnamara, Hambrick ve Oswald daha sonra performans farklarının ne kadarının kasıtlı pratikle ilişkili olduğunu tahmin etti. Paylar alana göre değişti: eğitim ve mesleklerden daha yüksek olarak oyun, müzik ve sporda.";
"theory_chapter_1000_example" = "Hâlâ bozulan pasaja harcanan bir saat, zaten iyi giden parçaları çalmakla aynı etkinlik değildir. İlerleme çubuğu her iki durumda da zamanı kaydeder.";
"theory_chapter_1000_caveat" = "Alan yüzdeleri 2014 meta-analizindeki varyans paylarıdır. Öğrenilebilecek beceri payı veya birinin başarı şansı değildir. Makale 1000 saati mesleki eşik olarak koymaz. Uygulamada 1000 saati profesyonel olma noktası sayan eski ifade kanıtı abartıyordu.";
"theory_chapter_10000_title" = "Ünlü bir sayı, yasa değil";
"theory_chapter_10000_lead" = "On bin saat ustalık kuralı olarak ünlü oldu. Dayandığı araştırma bir yasa kurmadı ve bu sekmedeki kristal yalnızca uygulamanın gösterdiği en yüksek saat işaretini belirtir.";
"theory_chapter_10000_mechanism_title" = "Sayının yolculuğu";
"theory_chapter_10000_mechanism" = "Malcolm Gladwell'in Outliers'ı (2008) yuvarlak sayıyı genişçe tanıttı. Uzman performansı araştırmasına, müzisyenlerde kasıtlı pratik üzerine Ericsson, Krampe ve Tesch-Römer'in 1993 makalesine dayandı. Macnamara ve Maitra (2019) bu popüler kuralın araştırmadan nasıl ayrıldığını tartışır. Popüler sürüm karmaşık bir argümanı ustalığı garanti edecek tek bir eşiğe sıkıştırdı.";
"theory_chapter_10000_example" = "İki kişi aynı toplamı kaydedip yine de zamanı farklı geçirmiş olabilir. Birinin belirli bir hatayı düzelten öğretmeni olmuş olabilir. Diğeri zaten çaldığı bir parçayı tekrarlamış olabilir. Saat toplamı bu farkı kaydetmez.";
