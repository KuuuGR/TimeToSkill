"theory_topic_first20_title" = "İlk 20 saat: başlangıcı geçmek";
"theory_topic_first20_summary" = "Bir beceriyi başlatmak çoğu zaman sinir bozucudur çünkü her şey yabancıdır. Josh Kaufman pratik bir yaklaşım önerir: beceriyi bölün, önemli olana odaklanın, pratik engellerini kaldırın ve gelişmeye odaklanmış zaman ayırın. 20 saatlik çerçevesi bir başlangıç yöntemidir; herhangi bir becerinin 20 saatte ustalaşacağına dair bilimsel bir garanti değildir.";
"theory_topic_first20_takeaway" = "İlk 20 saatinizden sonra daha iyi yapmak istediğiniz somut bir şey seçin.";
"theory_topic_first20_citation" = "Josh Kaufman. The First 20 Hours: How to Learn Anything… Fast! Ebook published in 2013; paperback published in 2014.";
"theory_topic_first20_context" = "Yazarın pratik çerçevesi ve kitabı, kontrollü bilimsel çalışma değil.";
"theory_topic_first20_limitation" = "20 saatlik çerçeve bir başlangıç yöntemidir. Ustalık için bilimsel olarak belirlenmiş bir süre değildir.";
"theory_topic_deliberate_title" = "Amaçla pratik yapmak";
"theory_topic_deliberate_summary" = "Bir etkinliği tekrarlamak, onu kasıtlı olarak geliştirmekle aynı şey değildir. Belirli bir yön seçin, net bir hedefle pratik yapın, hataları fark edin ve sonraki denemeyi ayarlayın. Zamanı izlemek yararlıdır ama pratik biçimi de önemlidir.";
"theory_topic_deliberate_takeaway" = "Bir oturumdan önce iyileştirmek istediğiniz tek bir şeye karar verin.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "Makale uzman performans çerçevesini geliştirdi ve kemancılar ile piyanistler dahil müzisyenlerle yapılan çalışmaları bildirdi.";
"theory_topic_deliberate_limitation" = "Makale tüm becerilerde ustalığı garanti eden sabit bir pratik saat sayısı koymaz.";
"theory_topic_10k_title" = "10.000 saat: popüler bir kural, yasa değil";
"theory_topic_10k_summary" = "10.000 saat kuralı Malcolm Gladwell'in Outliers'ı (2008) ile yaygınlaştı. Uzman performansı araştırmasına dayandı ama popüler sürüm özgün argümanı basitleştirdi. Ustalığı garanti eden evrensel sihirli bir saat sayısı yoktur.";
"theory_topic_10k_takeaway" = "Uzun vadeli dönüm noktalarını azmi kutlamak için kullanın, ne zaman uzman olacağınızı tahmin etmek için değil.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "10.000 saat kuralı Malcolm Gladwell'in Outliers'ı (2008) ile yaygınlaştı. 2019 makalesi bu popüler kuralın 1993 araştırmasından nasıl ayrıldığını tartışır.";
"theory_topic_10k_limitation" = "Ericsson ve meslektaşları evrensel bir 10.000 saat ustalık yasası kurmadı. Ustalığı garanti eden evrensel bir saat sayısı yoktur.";
