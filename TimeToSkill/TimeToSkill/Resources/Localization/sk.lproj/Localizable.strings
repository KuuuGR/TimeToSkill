"theory_topic_spacing_title" = "Vracajte sa k zručnosti namiesto bifľovania všetkého naraz";
"theory_topic_spacing_summary" = "Výzkum rozložené praxe podporuje rozprostření učení do více session místo spoléhání jen na masovanou praxi. Nejlepší rozestup závisí na materiálu a na tom, jak dlouho jej chcete udržet.";
"theory_topic_spacing_takeaway" = "Zkuste se k dovednosti vracet několik dní a sledujte, co si pamatujete a co potřebuje více cvičení.";
"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "Metaanalýza prohlédla 317 experimentů v 184 článcích s 839 hodnoceními rozložené praxe.";
"theory_topic_spacing_limitation" = "Tyto výsledky se týkají úloh učení a vybavení. Nenabízejí jeden optimální rozvrh pro každou fyzickou, sociální, uměleckou nebo profesní dovednost.";
"theory_topic_habit_title" = "Návyk nemá univerzálnu lehotu";
"theory_topic_habit_summary" = "Opakování akce ve stejném kontextu ji může časem učinit automatickější. Potřebný čas se však liší mezi lidmi a chováními. Vynechání jednoho dne neznamená, že je veškerý pokrok ztracen.";
"theory_topic_habit_takeaway" = "Propojte činnost se situací, kterou potkáváte pravidelně, a vraťte se bez viny, když session vypadne.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "Devadesát šest dobrovolníků zvolilo chování jídla, pití nebo aktivity k opakování ve stejném kontextu po 12 týdnů. Osmdesát dva účastníků dodalo dostatek dat. Modelovaný čas k dosažení 95 % odhadu asymptotické automatizace se pohyboval od 18 do 254 dní.";
"theory_topic_habit_limitation" = "Šlo o studii tvorby návyku, ne o studii, kolik hodin je třeba k mistrovství. Nepodporuje práh mistrovství 21 hodin ani univerzální pravidlo návyku 21 dní.";
