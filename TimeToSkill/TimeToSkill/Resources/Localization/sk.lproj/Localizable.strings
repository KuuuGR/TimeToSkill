/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Ten ekran pokazuje umiejętności dołączone do aplikacji: dotychczasowy zestaw oraz pozycje przyjęte z opracowanego zbioru. Pliki propozycji pilotażowych same nie są katalogiem.";
"theory_compendium_intro" = "Každá záložka je hodinová značka, ktorú už používa ukazovateľ postupu. Kryštál je farba tejto značky. Text vysvetľuje, čo značka znamená — a čo nie.";
"theory_hour_unit" = "hodín";
"theory_callout_example" = "Príklad";
"theory_callout_caveat" = "Výhrada";
"theory_callout_takeaway" = "Zhrnutie";
"theory_chapter_21_title" = "Prekonať začiatok";
"theory_chapter_21_lead" = "Dvadsaťjeden hodín mení farbu ukazovateľa postupu. To nie je výskumný záver. Najbližšia publikovaná metóda je Kaufmanov rámec 20 hodín na prežitie nešikovného začiatku, a tieto dve čísla nie sú rovnaké tvrdenie.";
"theory_chapter_21_mechanism_title" = "Metoda pro start";
"theory_chapter_21_mechanism" = "Kaufman berie začiatok ako praktický problém. Rozdeľte zručnosť na menšie časti, naučte sa dosť na to, aby ste si všimli vlastné chyby, odstráňte prekážky, ktoré cvičenie sťažujú, a venujte sústredený čas jednému výsledku. Kniha to predstavuje ako autorovu metódu, ako začať.";
"theory_chapter_21_example" = "Kto chce, aby tri akordy znelí čisto, môže cvičiť práve tento výsledok. „Naučiť sa gitaru“ je väčší cieľ a prvé hodiny ho nerozhodnú.";
"theory_chapter_100_title" = "Sto hodín ako značka aplikácie";
"theory_chapter_100_lead" = "Sto hodín je míľnik Time4Skill pre už zaznamenaný čas. Žiadna zo štúdií v tomto kompendiu nedefinuje 100 hodín ako bod, kedy sa niekto stáva kompetentným.";
"theory_chapter_100_mechanism_title" = "Čo blízky výskum skutočne meral";
"theory_chapter_100_mechanism" = "Dvě výzkumné linie leží blízko tohoto období, aniž by je měřily v hodinách. Cepeda, Pashler, Vul, Wixted a Rohrer prohlédli 317 experimentů o slovním vybavení. Rozložené sessiony v té literatuře porážely biflování a užitečný odstup závisel na tom, jak dlouho měl být materiál pamatován. Lally, van Jaarsveld, Potts a Wardle žádali dobrovolníky, aby opakovali chování jídla, pití nebo aktivity ve stejném kontextu. Modelovaný čas do 95 procent vlastního plateaus každé osoby se široce lišil. Vynechání jednoho dne křivku nevymazalo.";
"theory_chapter_100_example" = "Hraní krátkého úryvku ve tři různé dny ukáže, který takt opravdu zůstal v paměti. Jeden dlouhý večer opakování na tuto otázku neodpoví.";
"theory_chapter_100_caveat" = "Přehled o rozložení se týká slovního vybavení. Studie návyku se týká automatizace zvoleného chování a rozsah v modelu u článku byl 18 až 254 dní, ne linie kompetence na 100 hodinách. Žádný výsledek neříká, že 100 hodin dělá někoho kompetentním ve fotografii, řízení auta nebo jiné dovednosti.";
"theory_chapter_100_takeaway" = "Použite značku, aby ste si všimli, či sa vraciate. Nepovažujte ju za zaslúženú úroveň.";
"theory_chapter_1000_title" = "Cvičenie zamerané na jednu medzeru";
"theory_chapter_1000_lead" = "Kryštál 1000 hodín zaznamenáva strávený čas. Neznamená, že je osoba teraz profesionál, učiteľ alebo niekto, kto môže zo zručnosti žiť.";
"theory_chapter_1000_mechanism_title" = "Záměrná praxe a kolik vysvětlovala";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe a Tesch-Römer popsali záměrnou praxi jako činnost uspořádanou ke zlepšení konkrétního aspektu, se zpětnou vazbou a opravou, místo pouhého opakování už pohodlného. Jejich článek z roku 1993 rozvíjel tento rámec na studiích hudebníků. Neuveřejnil počet hodin, který tvoří experty v každém oboru. Macnamara, Hambrick a Oswald později odhadli, jaká část rozdílů ve výkonu souvisela se záměrnou praxí. Podíly se lišily podle oblasti: vyšší ve hrách, hudbě a sportu než ve vzdělávání a profesích.";
"theory_chapter_1000_example" = "Hodina u pasáže, která se stále láme, je jiná činnost než hodina skladeb, které už jdou dobře. Ukazatel postupu zaznamenává čas v obou případech.";
"theory_chapter_1000_caveat" = "Procenta podle oblastí jsou podíly variance v metaanalýze z roku 2014. Nejsou částí dovednosti, kterou lze naučit, ani něčí šancí na úspěch. Článek nestanoví 1000 hodin jako profesní práh. Starší znění v aplikaci, které bralo 1000 hodin jako moment stát se profesionálem, přehánělo důkazy.";
"theory_chapter_10000_title" = "Slávne číslo, nie zákon";
"theory_chapter_10000_lead" = "Deset tisíc hodin se proslavilo jako pravidlo mistrovství. Výzkum, z nějž vycházelo, nestanovil zákon a krystal na této záložce jen označuje nejvyšší zobrazenou hodinovou značku aplikace.";
"theory_chapter_10000_mechanism_title" = "Jak číslo cestovalo";
"theory_chapter_10000_mechanism" = "Outliers (2008) Malcolma Gladwella učinilo kulaté číslo široce známým. Opíralo se o výzkum expertního výkonu včetně článku Ericssona, Krampeho a Tesch-Römera z roku 1993 o záměrné praxi hudebníků. Macnamara a Maitra (2019) probírají, čím se toto populární pravidlo liší od výzkumu. Populární verze stlačila složitý argument do jednoho prahu, který měl zaručit mistrovství.";
"theory_chapter_10000_example" = "Dva lidé mohou zaznamenat stejný součet a přesto strávit čas jinak. Jeden mohl mít učitele opravujícího konkrétní chybu. Druhý mohl opakovat skladbu, kterou už hraje. Součet hodin tento rozdíl nezaznamená.";
