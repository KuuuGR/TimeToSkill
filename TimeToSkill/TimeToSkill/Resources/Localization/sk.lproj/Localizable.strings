"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "Pravidlo 10 000 hodin se stalo široce známým díky Outliers (2008) Malcolma Gladwella. Článek z roku 2019 probírá, čím se toto populární pravidlo liší od výzkumu z roku 1993.";
"theory_topic_10k_limitation" = "Ericsson a kolegové nestanovili univerzální zákon mistrovství o 10 000 hodinách. Neexistuje univerzální počet hodin, který zaručí mistrovství.";
"theory_topic_variance_title" = "Cvičenie má význam, ale nie je všetkým";
"theory_topic_variance_summary" = "Metaanalýza z roku 2014 zkoumala záměrnou praxi v několika oborech. Praxe souvisela s výkonem, ale její přínos se výrazně lišil podle oblasti.";
"theory_topic_variance_takeaway" = "Cvičení je něco, co můžete ovlivnit. Výsledky také závisí na jiných faktorech, které se mezi činnostmi liší.";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick, and Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "Metaanalýza z roku 2014 zkoumala záměrnou praxi v několika oborech. Praxe souvisela s výkonem, ale její přínos se výrazně lišil podle oblasti.";
"theory_topic_variance_findings_intro" = "Odhadovaný podíl rozdílů ve výkonu vysvětlený záměrnou praxí v této analýze byl:";
"theory_topic_variance_limitation" = "Tato procenta se týkají vysvětlené variance výkonu v této metaanalýze. Nejsou procentem dovednosti, kterou lze naučit, ani individuální pravděpodobností úspěchu.";
