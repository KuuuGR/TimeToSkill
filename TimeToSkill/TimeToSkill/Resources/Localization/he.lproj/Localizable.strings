"theory_topic_first20_title" = "20 השעות הראשונות: לעבור את ההתחלה";
"theory_topic_first20_summary" = "התחלת מיומנות לעיתים קרובות מתסכלת כי הכול לא מוכר. ג'וש קאופמן מציע גישה מעשית: פצלו את המיומנות, התמקדו במה שחשוב, הסירו מחסומי תרגול והקדישו זמן ממוקד לשיפור. מסגרת 20 השעות שלו היא שיטת התחלה, לא ערבות מדעית שכל מיומנות נשלטת ב־20 שעות.";
"theory_topic_first20_takeaway" = "בחרו דבר אחד ספציפי שתרצו לעשות טוב יותר אחרי 20 השעות הראשונות.";
"theory_topic_first20_citation" = "Josh Kaufman. The First 20 Hours: How to Learn Anything… Fast! Ebook published in 2013; paperback published in 2014.";
"theory_topic_first20_context" = "מסגרת מעשית וספר של המחבר, לא מחקר מדעי מבוקר.";
"theory_topic_first20_limitation" = "מסגרת 20 השעות היא שיטת התחלה. זה אינו זמן מבוסס מדעית הנדרש לשליטה.";
"theory_topic_deliberate_title" = "לתרגל עם מטרה";
"theory_topic_deliberate_summary" = "לחזור על פעילות אינו אותו דבר כמו לשפר אותה במכוון. בחרו היבט ספציפי, תרגלו עם מטרה ברורה, שימו לב לטעויות והתאימו את הניסיון הבא. מעקב אחרי זמן שימושי, אבל גם אופן התרגול חשוב.";
"theory_topic_deliberate_takeaway" = "לפני מפגש, החליטו דבר אחד שאתם רוצים לשפר.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "המאמר פיתח מסגרת לביצועי מומחים ודיווח על מחקרים עם מוזיקאים, כולל כנרים ופסנתרנים.";
"theory_topic_deliberate_limitation" = "המאמר אינו קובע מספר שעות תרגול קבוע שמבטיח שליטה בכל המיומנויות.";
"theory_topic_10k_title" = "10,000 שעות: כלל פופולרי, לא חוק";
"theory_topic_10k_summary" = "כלל 10,000 השעות הפך פופולרי לרוחב דרך Outliers (2008) של מלקום גלדוול. הוא נשען על מחקר ביצועי מומחים, אבל הגרסה הפופולרית פישטה את הטיעון המקורי. אין מספר שעות קסום אוניברסלי שמבטיח שליטה.";
"theory_topic_10k_takeaway" = "השתמשו באבני דרך ארוכות טווח כדי לחגוג התמדה, לא כדי לחזות מתי תהיו מומחים.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "כלל 10,000 השעות הפך פופולרי לרוחב דרך Outliers (2008) של מלקום גלדוול. מאמר 2019 דן כיצד הכלל הפופולרי נבדל ממחקר 1993.";
"theory_topic_10k_limitation" = "אריקסון ועמיתיו לא קבעו חוק שליטה אוניברסלי של 10,000 שעות. אין מספר שעות אוניברסלי שמבטיח שליטה.";
"theory_topic_variance_title" = "תרגול חשוב, אבל הוא לא הכול";
"theory_topic_variance_summary" = "מטא־אנליזה מ־2014 בחנה תרגול מכוון בכמה תחומים. התרגול נקשר לביצוע, אבל תרומתו נבדלה באופן משמעותי לפי תחום.";
"theory_topic_variance_takeaway" = "תרגול הוא דבר שאתם יכולים להשפיע עליו. התוצאות תלויות גם בגורמים אחרים שמשתנים בין פעילויות.";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick, and Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "מטא־אנליזה מ־2014 בחנה תרגול מכוון בכמה תחומים. התרגול נקשר לביצוע, אבל תרומתו נבדלה באופן משמעותי לפי תחום.";
"theory_topic_variance_findings_intro" = "החלק המוערך של הבדלי הביצוע שהוסבר על ידי תרגול מכוון בניתוח זה היה:";
"theory_topic_variance_limitation" = "אחוזים אלה מתייחסים לשונות ביצוע שהוסברה במטא־אנליזה זו. הם אינם אחוז המיומנות שאדם יכול ללמוד, ואינם הסתברות הצלחה אישית.";
