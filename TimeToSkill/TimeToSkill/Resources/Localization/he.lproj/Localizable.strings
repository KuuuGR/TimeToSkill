"theory_chapter_21_title" = "לעבור את ההתחלה";
"theory_chapter_21_lead" = "עשרים ואחת שעות משנות את צבע סרגל ההתקדמות. זה לא ממצא מחקרי. השיטה הפורסמת הקרובה ביותר היא מסגרת 20 השעות של ג'וש קאופמן לשרוד התחלה מגושמת, ושני המספרים האלה אינם אותה טענה.";
"theory_chapter_21_mechanism_title" = "שיטה להתחלה";
"theory_chapter_21_mechanism" = "קאופמן מתייחס להתחלה כבעיה מעשית. פצלו את המיומנות לחלקים קטנים יותר, למדו מספיק כדי להבחין בטעויות שלכם, הסירו מחסומים שמקשים על התרגול, והקדישו זמן ממוקד לתוצאה אחת. הספר מציג זאת כשיטת מחבר להתחיל.";
"theory_chapter_21_example" = "מי שרוצה ששלושה אקורדים יישמעו נקיים יכול לתרגל בדיוק את התוצאה הזו. \"ללמוד גיטרה\" הוא יעד גדול יותר, והשעות הראשונות אינן מכריעות אותו.";
"theory_chapter_100_title" = "מאה שעות כסימן באפליקציה";
"theory_chapter_100_lead" = "מאה שעות הן אבן דרך של Time4Skill לזמן שכבר נרשם. אף מחקר בקובץ זה אינו מגדיר 100 שעות כנקודה שבה מישהו הופך לכשיר.";
"theory_chapter_100_mechanism_title" = "מה מדד באמת מחקר קרוב";
"theory_chapter_100_mechanism" = "שני קווי עבודה יושבים ליד התקופה הזו בלי למדוד אותה בשעות. ספדה, פשלר, וול, ויקסטד ורוהר סקרו 317 ניסויים על שליפה מילולית. פיזור מפגשים ניצח דחיסה בספרות ההיא, והמרווח השימושי תלוי כמה זמן החומר צריך להישמר. ללי, ואן יארסוולד, פוטס וורדל ביקשו ממתנדבים לחזור על התנהגות אכילה, שתייה או פעילות באותו הקשר. הזמן המודלי להגיע ל־95 אחוז מהרמה הגבוהה של כל אדם השתנה מאוד. דילוג על יום אחד לא מחק את העקומה.";
"theory_chapter_100_example" = "נגינת קטע קצר בשלושה ימים שונים מראה איזה תיבה באמת נשארה בזיכרון. ערב ארוך של חזרות אינו עונה על השאלה הזו.";
"theory_chapter_100_caveat" = "סקירת הפיזור עוסקת בשליפה מילולית. מחקר ההרגל עוסק באוטומטיות של התנהגות שנבחרה, והטווח במודל שדווח עם המאמר היה 18 עד 254 ימים — לא קו כשירות ב־100 שעות. שום תוצאה לא אומרת ש־100 שעות הופכות מישהו לכשיר בצילום, נהיגה או כל מיומנות אחרת.";
"theory_chapter_100_takeaway" = "השתמשו בסימן כדי להבחין אם אתם חוזרים. אל תתייחסו אליו כאל רמה שנצברה.";
"theory_chapter_1000_title" = "תרגול המופנה לפער אחד";
"theory_chapter_1000_lead" = "גביש 1,000 השעות רושם זמן שהושקע. הוא אינו אומר שהאדם כעת מקצוען, מורה או מי שיכול להתפרנס מהמיומנות.";
"theory_chapter_1000_mechanism_title" = "תרגול מכוון, וכמה הוא הסביר";
"theory_chapter_1000_mechanism" = "אריקסון, קרמפה וטש־רמר תיארו תרגול מכוון כפעילות שמאורגנת לשיפור היבט ספציפי, עם משוב ותיקון, במקום פשוט לחזור על מה שכבר נוח. מאמרם מ־1993 פיתח את המסגרת במחקרי מוזיקאים. הם לא פרסמו מספר שעות שיוצר מומחים בכל תחום. מקנמרה, האמבריק ואוסוולד העריכו מאוחר יותר כמה מההבדל בביצוע נקשר לתרגול מכוון. החלקים נבדלו לפי תחום: גבוהים יותר במשחקים, מוזיקה וספורט מאשר בחינוך ובמקצועות.";
"theory_chapter_1000_example" = "שעה על הקטע שעדיין מתפרק היא פעילות שונה משעה של יצירות שכבר הולכות טוב. סרגל ההתקדמות רושם את הזמן בשני המקרים.";
"theory_chapter_1000_caveat" = "אחוזי התחומים הם חלקי שונות במטא־אנליזה מ־2014. הם אינם חלק מיומנות שאפשר ללמוד, ואינם סיכוי ההצלחה של מישהו. המאמר אינו קובע 1,000 שעות כסף מקצועי. ניסוח ישן באפליקציה שטיפל ב־1,000 שעות כנקודת הפיכה למקצוען הגזים בראיות.";
"theory_chapter_10000_title" = "מספר מפורסם, לא חוק";
"theory_chapter_10000_lead" = "עשרת אלפים שעות התפרסמו ככלל שליטה. המחקר שממנו נגזרו לא קבע חוק, והגביש בלשונית זו מסמן רק את סימן השעות הגבוה ביותר שהאפליקציה מציגה.";
"theory_chapter_10000_mechanism_title" = "איך המספר נדד";
"theory_chapter_10000_mechanism" = "Outliers (2008) של מלקום גלדוול הפך את המספר העגול לידוע לרוחב. הוא נשען על מחקר ביצועי מומחים, כולל מאמר 1993 של אריקסון, קרמפה וטש־רמר על תרגול מכוון במוזיקאים. מקנמרה ומאיטרה (2019) דנות כיצד הכלל הפופולרי נבדל מהמחקר. הגרסה הפופולרית דחסה טיעון מורכב לסף אחד שאמור להבטיח שליטה.";
