"theory_topic_spacing_title" = "חזרו למיומנות במקום לדחוס הכול יחד";
"theory_topic_spacing_summary" = "מחקר על תרגול מפוזר תומך בפיזור הלמידה על פני כמה מפגשים במקום להסתמך רק על תרגול מרוכז. המרווח הטוב ביותר תלוי בחומר ובכמה זמן אתם רוצים לשמור אותו.";
"theory_topic_spacing_takeaway" = "נסו לחזור למיומנות לאורך כמה ימים וצפו במה שאתם זוכרים ומה שדורש עוד תרגול.";
"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "המטא־אנליזה סקרה 317 ניסויים ב־184 מאמרים, עם 839 הערכות של תרגול מפוזר.";
"theory_topic_spacing_limitation" = "תוצאות אלה נוגעות למשימות למידה ושליפה. הן אינן מציגות לוח זמנים אופטימלי לכל מיומנות גופנית, חברתית, אמנותית או מקצועית.";
"theory_topic_habit_title" = "להרגל אין מועד אחרון אוניברסלי";
"theory_topic_habit_summary" = "חזרה על פעולה באותו הקשר יכולה להפוך אותה לאוטומטית יותר עם הזמן. עם זאת הזמן הנדרש משתנה בין אנשים והתנהגויות. דילוג על יום אחד אינו אומר שכל ההתקדמות אבדה.";
"theory_topic_habit_takeaway" = "קשרו פעילות למצב שאתם פוגשים באופן קבוע, והמשיכו בלי אשמה כשמפגש מתפספס.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "תשעים ושישה מתנדבים בחרו התנהגות אכילה, שתייה או פעילות לחזרה באותו הקשר במשך 12 שבועות. שמונים ושניים משתתפים סיפקו נתונים מספיקים. הזמן המודלי להגיע ל־95% מהערכת האוטומטיות האסימפטוטית נע בין 18 ל־254 ימים.";
"theory_topic_habit_limitation" = "זה היה מחקר על יצירת הרגל, לא מחקר על כמה שעות נדרשות לשלוט במיומנות. הוא אינו תומך בסף שליטה של 21 שעות או בכלל הרגל אוניברסלי של 21 יום.";
"theory_milestones_title" = "אבני דרך להתקדמות";
"theory_milestones_note" = "The 100-hour, 1,000-hour, and 10,000-hour marks in Time4Skill record time you have spent. They are progress milestones, not scientifically validated stages, and they do not predict when you will become an expert.";
