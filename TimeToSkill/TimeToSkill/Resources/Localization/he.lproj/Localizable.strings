"catalog_exemplary_note" = "מסך זה מציג מיומנויות שמגיעות עם האפליקציה: הסט המקורי ופריטים מהקטלוג שהוכן.";
"theory_compendium_intro" = "כל לשונית היא סימן שעות שסרגל ההתקדמות כבר משתמש בו. הגביש הוא צבע הסימן. הטקסט מסביר מה הסימן אומר — ומה הוא לא אומר.";
