/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "本屏幕列出应用附带的技能：原有集合以及来自已整理目录的条目。";
"theory_compendium_intro" = "每个标签都是进度条已经使用的小时标记。水晶是该标记的颜色。文字说明这个标记意味着什么——以及不意味着什么。";
"theory_hour_unit" = "小时";
"theory_callout_example" = "例子";
"theory_callout_caveat" = "注意";
"theory_callout_takeaway" = "要点";
"theory_chapter_21_title" = "迈过开始阶段";
"theory_chapter_21_lead" = "二十一小时会改变进度条的颜色。这不是研究发现。最接近的已发表方法是 Josh Kaufman 帮助度过尴尬开端的 20 小时框架，这两个数字并不是同一主张。";
"theory_chapter_21_mechanism_title" = "起步方法";
"theory_chapter_21_mechanism" = "Kaufman 把开始当作实际问题。把技能拆成更小部分，学到足以察觉自己的错误，去掉妨碍练习的障碍，并把专注时间用在一个结果上。书中把它呈现为作者的起步方法。";
"theory_chapter_21_example" = "想让三个和弦干净的人，可以专门练习这个结果。“学会吉他”是更大的目标，最初几小时并不能决定它。";
"theory_chapter_100_title" = "作为应用标记的一百小时";
"theory_chapter_100_lead" = "一百小时是 Time4Skill 对已记录时间的里程碑。本汇编中的研究都没有把 100 小时定义为某人变得胜任的时刻。";
"theory_chapter_100_mechanism_title" = "相近研究实际测量了什么";
"theory_chapter_100_mechanism" = "两条研究线接近这段时期，但并不以小时计。Cepeda、Pashler、Vul、Wixted 与 Rohrer 回顾了 317 项言语回忆实验。在该文献中，分散练习优于突击，有用的间隔取决于材料需要被记住多久。Lally、van Jaarsveld、Potts 与 Wardle 让志愿者在相同情境中重复饮食或活动行为。达到每人自身平台 95% 的建模时间差异很大。漏掉一天并不会抹掉曲线。";
"theory_chapter_100_example" = "在三个不同日子演奏一小段，能看出哪一小节真正留在记忆里。一整晚的重复回答不了这个问题。";
"theory_chapter_100_caveat" = "关于间隔的综述针对言语回忆。习惯研究针对所选行为的自动化，文中模型的范围是 18 到 254 天，而不是 100 小时的胜任线。任何结果都没有说 100 小时会让人在摄影、驾驶或其他技能上变得胜任。";
"theory_chapter_100_takeaway" = "用这个标记留意自己是否回来练习。不要把它当成已经赚到的等级。";
"theory_chapter_1000_title" = "针对一个缺口的练习";
"theory_chapter_1000_lead" = "1000 小时水晶记录花费的时间。它并不表示此人已成为专业人士、教师，或能靠该技能谋生的人。";
"theory_chapter_1000_mechanism_title" = "刻意练习及其解释的份额";
"theory_chapter_1000_mechanism" = "Ericsson、Krampe 与 Tesch-Römer 将刻意练习描述为旨在改进特定方面的活动，带有反馈与纠正，而不是简单重复已经舒适的内容。他们 1993 年的论文以音乐家研究发展了该框架。它没有公布在每个领域造就专家的小时数。Macnamara、Hambrick 与 Oswald 后来估计表现差异中有多少与刻意练习相关。份额因领域而异：游戏、音乐与体育高于教育与职业。";
"theory_chapter_1000_example" = "花在仍会出错的片段上的一小时，与演奏已经顺利的曲目的一小时，是不同的活动。进度条两种情况都会记录时间。";
"theory_chapter_1000_caveat" = "各领域百分比是 2014 年元分析中的方差份额。它们不是一个人能学会的技能比例，也不是任何人的成功概率。论文没有把 1000 小时设为职业门槛。应用中把 1000 小时当作成为专业人士时刻的旧表述夸大了证据。";
"theory_chapter_10000_title" = "著名数字，不是定律";
"theory_chapter_10000_lead" = "一万小时因精通规则而著名。它所依据的研究并没有确立定律，此标签上的水晶只标识应用显示的最高小时标记。";
"theory_chapter_10000_mechanism_title" = "这个数字如何流传";
"theory_chapter_10000_mechanism" = "Malcolm Gladwell 的 Outliers（2008）使这个整数广为人知。它依据专家表现研究，包括 Ericsson、Krampe 与 Tesch-Römer 1993 年关于音乐家刻意练习的论文。Macnamara 与 Maitra（2019）讨论该流行规则与研究的差异。流行版本把复杂论证压缩成一个据称保证精通的门槛。";
"theory_chapter_10000_example" = "两个人可以记录相同总数，却以不同方式花费时间。一人可能有老师纠正具体缺点。另一人可能在重复已经会弹的曲子。小时总数不会记录这种差别。";
