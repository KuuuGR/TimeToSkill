"theory_topic_first20_title" = "Prve 20 časov: projti početok";
"theory_topic_first20_summary" = "Započinati umětnost často frustruje, ibo vse jest neznamo. Josh Kaufman predlaga praktičny put: razděliti umětnost na menše čęsti, sosrědotočiti se na to, čto važno, odstraniti prěpony praktikě i potrětiti sosrědotočeno vrěme na ulěpšenje. Jego okvir 20 časov jest metoda starta, a ne naučna garancija, že vsaku umětnost možno ovladniti za 20 časov.";
"theory_topic_first20_takeaway" = "Izberite jednu konkretnu věč, ktoru hočete dělat lěpše poslě prvyh 20 časov.";
"theory_topic_first20_citation" = "Josh Kaufman. The First 20 Hours: How to Learn Anything… Fast! Elektronna kniga v 2013; paperna kniga v 2014.";
"theory_topic_first20_context" = "Praktičny okvir i kniga avtora, a ne kontrolovano naučno izslědovanje.";
"theory_topic_first20_limitation" = "Okvir 20 časov jest metoda starta. To ne jest naučno ustanovjeny čas, potrěbny da by ovladniti umětnost.";

"theory_topic_deliberate_title" = "Praktikovati s cělju";
"theory_topic_deliberate_summary" = "Povtorjati dějanje ne jest to samo, čto naměrno jego ulěpšati. Izberite konkretny aspekt, praktikujte s jasnoju cělju, zaměčajte pogrěšky i popravjajte slědujuči popyt. Vrěme koristno zapisovati, ale i sposob praktiky važen.";
"theory_topic_deliberate_takeaway" = "Prěd sesijoju rěšite, čto jedno hočete ulěpšiti.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe i Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "Članok razvil okvir ekspertnogo izpolnjenja i opisal izslědovanja muzikantov, vključno so skripačami i pianistami.";
"theory_topic_deliberate_limitation" = "Članok ne ustanavlja jednogo čisla časov, ktore garantiralo by majstorstvo vo vsih umětnostjah.";

"theory_topic_10k_title" = "10 000 časov: popularno pravilo, ne zakon";
"theory_topic_10k_summary" = "Pravilo 10 000 časov stalo široko znano prěz knigu Outliers (2008) Malcolma Gladwella. Ono opiralo se na izslědovanje ekspertnogo izpolnjenja, ale popularna verzija uprostila originalny argument. Nema univerzalnogo magičnogo čisla časov, ktore garantiralo by majstorstvo.";
"theory_topic_10k_takeaway" = "Upotrěbljajte dolgovrěmenne milniky, da by slaviti upornost, a ne da by prědviděti, kogda stanete ekspertom.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe i Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara i Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "Pravilo 10 000 časov stalo široko znano prěz Outliers (2008) Malcolma Gladwella. Članok iz 2019 govori, kako to popularno pravilo razlikuje se od izslědovanja iz 1993.";
"theory_topic_10k_limitation" = "Ericsson i kolegy ne ustanovili univerzalny zakon majstorstva na 10 000 časov. Nema univerzalnogo čisla časov, ktore garantiralo by majstorstvo.";

"theory_topic_variance_title" = "Praktika važna, ale ne jest vse";
"theory_topic_variance_summary" = "Metaanaliza iz 2014 izslědovala naměrnu praktiku v několika oblastjah. Ona našla, že praktika svęzana jest s izpolnjenjem, ale jej prispevek silno razlikuje se po oblasti.";
"theory_topic_variance_takeaway" = "Praktika jest něčto, na čto možete vplivati. Rezultaty zaviset takože od inyh faktorov, ktore razlikujut se medžu dějanjami.";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick i Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "Metaanaliza iz 2014 izslědovala naměrnu praktiku v několika oblastjah. Praktika byla svęzana s izpolnjenjem, ale jej prispevek silno razlikoval se po oblasti.";
