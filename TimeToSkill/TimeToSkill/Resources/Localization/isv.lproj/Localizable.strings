/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Taky ekran pokazuje umětnosti, ktore idut s programom: originalny nabor plus zapisy prijęte iz razvitoj zbirky. Fajly pilotnyh predloženj same ne sut katalog.";
"theory_compendium_intro" = "Vsaky vklad jest časova oznaka, ktoru već uporablja polosa postupa. Kristal jest barva toj oznaky. Tekst objasnja, čto oznaka znači i čego ne znači.";
"theory_hour_unit" = "časy";
"theory_callout_example" = "Priklad";
"theory_callout_caveat" = "Ograničenje";
"theory_callout_takeaway" = "Izvod";
"theory_chapter_21_title" = "Projti početok";
"theory_chapter_21_lead" = "Dvadset jedin časov měnja barvu polosy postupa. To ne jest najdka izslědovanja. Najbližša objavjena metoda jest okvir 20 časov Josha Kaufmana, da by prěžiti neudobny početok, i te dvě čisla ne sut to samo tvrđenje.";
"theory_chapter_21_mechanism_title" = "Metoda za početok";
"theory_chapter_21_mechanism" = "Kaufman traktuje početok kak praktičny problem. Razdělite umětnost na menše čęsti, naučite se dovoljno, da by zaměčati svoje pogrěšky, odstranite prěpony, ktore dělajut praktiku neudobnu, i potrětite sosrědotočeno vrěme na jedin rezultat. Kniga predstavja to kak metodu avtora za početok.";
"theory_chapter_21_example" = "Člověk, ktory hoče, da by tri akordy zvučali čisto, može praktikovati taky rezultat. «Naučiti se gitary» jest večši cěl, i prve časy jego ne rěšajut.";
"theory_chapter_100_title" = "Sto časov, kak oznaka programa";
"theory_chapter_100_lead" = "Sto časov jest milnik Time4Skill za vrěme, koje već jest zapisano. Nijedno izslědovanje v tutom zborniku ne definuje 100 časov kak moment, kogda někto staje se kompetentny.";
"theory_chapter_100_mechanism_title" = "Čto blizko izslědovanje dejstvitelno měrilo";
"theory_chapter_100_mechanism" = "Dvě linije raboty ležet blizko tutogo perioda, ale ne měrjajut jego v časah. Cepeda, Pashler, Vul, Wixted i Rohrer prěgledali 317 eksperimentov o slovesnom pripomněnju. V toj literaturě razdělene sesije pobědžali stisnjeno učenje, i koristny razstoj zavisel od togo, kako dolgo material trěboval byti pamętany. Lally, van Jaarsveld, Potts i Wardle prosili dobrovoljcev povtorjati povedenje jedenja, pitja ili aktivnosti v tom samom kontekstu. Modelovany čas da by dostignuti 95 procentov vlastnogo plato vsakoj osoby široko variral. Propustiti jedin denj ne izbrisalo krivu.";
"theory_chapter_100_example" = "Igrati kratky kus v tri razne dni pokazuje, ktory takt dejstvitelno ostal v paměti. Jedin dolgy večer povtorjenja ne odgovarja na to pytanje.";
"theory_chapter_100_caveat" = "Prěgled o razstojah kasaje se slovesnogo pripomněnja. Izslědovanje o navykah kasaje se avtomatičnosti izbranogo povedenja, i jego diapazon byl 18 do 254 dni v modelu objavljenom s člankom, a ne linija kompetencije na 100 časov. Nijaky rezultat ne govori, že 100 časov děla někogo kompetentnym v fotografiji, voženju ili inoj umětnosti.";
"theory_chapter_100_takeaway" = "Upotrěbljajte oznaku, da by zamětiti, či vračajete se. Ne traktujte ju kak urovenj, ktory ste zaslužili.";
"theory_chapter_1000_title" = "Praktika směrovana na jednu prazdnotu";
"theory_chapter_1000_lead" = "Kristal 1 000 časov zapisyje potrěteno vrěme. On ne znači, že osoba nyně jest profesional, učitelj ili někto, ktory može živeti od umětnosti.";
"theory_chapter_1000_mechanism_title" = "Naměrna praktika, i koliko ona objasnila";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe i Tesch-Römer opisali naměrnu praktiku kak dějanje ustrojeno da by ulěpšiti konkretny aspekt, s povratnoju informacijoju i popravkoju, vměsto prostogo povtorjenja togo, čto již jest udobno. Jihny članok iz 1993 razvil taky okvir na izslědovanjah muzikantov. On ne objavil jednogo čisla časov, ktore tvori ekspertov v vsakoj oblasti. Macnamara, Hambrick i Oswald pozže ocěnili, koliko razliky v izpolnjenju bylo svęzano s naměrnoju praktikoju. Čęsti razlikovali se po oblasti: vyše v igrah, muzikě i sportu než v obrazovanju i profesijah.";
"theory_chapter_1000_example" = "Čas potrěteny na kus, ktory vse loma se, jest ino dějanje než čas igranja kusov, ktore již idut dobro. Polosa postupa zapisyje vrěme v oboh slučajah.";
"theory_chapter_1000_caveat" = "Procenty po oblastjah sut čęsti variance v toj metaanalizi iz 2014. Oni ne sut čast umětnosti, ktoru člověk može naučiti se, ni šansa uspěha někogo. Članok ne stavlja 1 000 časov kak profesijny prag. Starše slova v programu, ktore traktovali 1 000 časov kak moment stati se profesionalom, prěuveličili dokazy.";
"theory_chapter_10000_title" = "Znano čislo, ne zakon";
"theory_chapter_10000_lead" = "Deset tyseč časov stalo znano kak pravilo majstorstva. Izslědovanje, iz kotorogo to bylo vzęto, ne ustanovilo zakon, i kristal na tutom vkladu samo označaje najvyšu časovu oznaku, ktoru program pokazuje.";
"theory_chapter_10000_mechanism_title" = "Kak čislo putovalo";
"theory_chapter_10000_mechanism" = "Outliers (2008) Malcolma Gladwella učinilo kruglo čislo široko znano. Ono opiralo se na izslědovanje ekspertnogo izpolnjenja, vključno s člankom iz 1993 Ericssona, Krampe i Tesch-Römera o naměrnoj praktikě muzikantov. Macnamara i Maitra (2019) razpravjajut, kako to popularno pravilo razlikuje se od izslědovanja. Popularna verzija stisnila složeny argument v jedin prag, ktory garantiraje majstorstvo.";
"theory_chapter_10000_example" = "Dva člověka mogut zapisati tu samu sumu i vsejedno potrětiti vrěme razno. Jedin mogl iměti učitelja, ktory popravjal konkretny nedostatok. Drugy mogl povtorjati kus, ktory již graje. Suma časov ne zapisyje tu razliku.";
