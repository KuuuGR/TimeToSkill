"theory_topic_habit_title" = "Navyk ne imaje univerzalny krajny termin";
"theory_topic_habit_summary" = "Povtorjati dějanje v tom samom kontekstu može s vrěmenem učiniti jego bolje avtomatičnym. Odnako potrěbno vrěme razlikuje se medžu ljudami i povedenjami. Propustiti jedin denj ne znači, že ves postup izgubjeny.";
"theory_topic_habit_takeaway" = "Svęžite dějanje so situacijoju, ktoru srečajete regularno, i vozobnovite bez viny, kogda sesija propadena.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts i Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "Devetdeset šest dobrovoljcev izbralo povedenje jedenja, pitja ili aktivnosti, da by povtorjati jego v tom samom kontekstu prěz 12 nedělj. Osemdeset dva učestnikov dalo dovoljno danov za analizu. Modelovany čas da by dostignuti 95% ocěny asimptotičnoj avtomatičnosti variral od 18 do 254 dni.";
"theory_topic_habit_limitation" = "To bylo izslědovanje o tvorjenju navykov, a ne o tom, koliko časov trěbuje se da by ovladniti umětnost. Ono ne podpiraje prag majstorstva na 21 časov ni univerzalno pravilo navyka na 21 dni.";

