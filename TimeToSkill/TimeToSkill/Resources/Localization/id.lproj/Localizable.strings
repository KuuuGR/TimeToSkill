"theory_topic_first20_title" = "20 jam pertama: melewati awal";
"theory_topic_first20_summary" = "Memulai keterampilan sering membuat frustrasi karena semuanya asing. Josh Kaufman mengusulkan pendekatan praktis: pecah keterampilan, fokus pada yang penting, hilangkan hambatan latihan, dan luangkan waktu terfokus untuk memperbaiki. Kerangka 20 jamnya adalah metode memulai, bukan jaminan ilmiah bahwa setiap keterampilan dikuasai dalam 20 jam.";
"theory_topic_first20_takeaway" = "Pilih satu hal konkret yang ingin Anda lakukan lebih baik setelah 20 jam pertama.";
"theory_topic_first20_citation" = "Josh Kaufman. The First 20 Hours: How to Learn Anything… Fast! Ebook published in 2013; paperback published in 2014.";
"theory_topic_first20_context" = "Kerangka praktis dan buku penulis, bukan studi ilmiah terkontrol.";
"theory_topic_first20_limitation" = "Kerangka 20 jam adalah metode memulai. Bukan waktu yang ditetapkan secara ilmiah untuk menguasai keterampilan.";
"theory_topic_deliberate_title" = "Berlatih dengan tujuan";
"theory_topic_deliberate_summary" = "Mengulang aktivitas tidak sama dengan sengaja memperbaikinya. Pilih aspek tertentu, berlatih dengan tujuan jelas, perhatikan kesalahan, dan sesuaikan percobaan berikutnya. Melacak waktu berguna, tetapi cara berlatih juga penting.";
"theory_topic_deliberate_takeaway" = "Sebelum sesi, putuskan satu hal yang ingin Anda perbaiki.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "Artikel itu mengembangkan kerangka kinerja ahli dan melaporkan studi yang melibatkan musisi, termasuk pemain biola dan piano.";
"theory_topic_deliberate_limitation" = "Artikel itu tidak menetapkan satu jumlah jam latihan tetap yang menjamin penguasaan di semua keterampilan.";
"theory_topic_10k_title" = "10.000 jam: aturan populer, bukan hukum";
"theory_topic_10k_summary" = "Aturan 10.000 jam menjadi sangat populer melalui Outliers (2008) Malcolm Gladwell. Ia mengacu pada penelitian kinerja ahli, tetapi versi populer menyederhanakan argumen asli. Tidak ada angka jam ajaib universal yang menjamin penguasaan.";
"theory_topic_10k_takeaway" = "Gunakan tonggak jangka panjang untuk merayakan ketekunan, bukan untuk memprediksi kapan Anda menjadi ahli.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "Aturan 10.000 jam menjadi sangat populer melalui Outliers (2008) Malcolm Gladwell. Artikel 2019 membahas bagaimana aturan populer itu berbeda dari penelitian 1993.";
"theory_topic_10k_limitation" = "Ericsson dan rekan tidak menetapkan hukum penguasaan universal 10.000 jam. Tidak ada jumlah jam universal yang menjamin penguasaan.";
