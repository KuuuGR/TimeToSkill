"theory_topic_spacing_title" = "Kembali ke keterampilan, bukan menjejalkan semuanya";
"theory_topic_spacing_summary" = "Penelitian tentang latihan terdistribusi mendukung menyebarkan pembelajaran ke beberapa sesi daripada hanya mengandalkan latihan massal. Jarak terbaik bergantung pada materi dan berapa lama Anda ingin mempertahankannya.";
"theory_topic_spacing_takeaway" = "Coba kembali ke keterampilan selama beberapa hari dan amati apa yang Anda ingat serta apa yang butuh lebih banyak latihan.";
"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "Meta-analisis meninjau 317 eksperimen di 184 artikel, dengan 839 penilaian latihan terdistribusi.";
"theory_topic_spacing_limitation" = "Hasil ini menyangkut tugas belajar dan mengingat. Mereka tidak menyajikan satu jadwal optimal untuk setiap keterampilan fisik, sosial, artistik, atau profesional.";
"theory_topic_habit_title" = "Kebiasaan tidak punya tenggat universal";
"theory_topic_habit_summary" = "Mengulang tindakan dalam konteks konsisten dapat membuatnya lebih otomatis seiring waktu. Namun waktu yang dibutuhkan berbeda antar orang dan perilaku. Kehilangan satu hari tidak berarti semua kemajuan hilang.";
"theory_topic_habit_takeaway" = "Hubungkan aktivitas dengan situasi yang Anda temui secara teratur, dan lanjutkan tanpa rasa bersalah saat sesi terlewat.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "Sembilan puluh enam sukarelawan memilih perilaku makan, minum, atau aktivitas untuk diulang dalam konteks yang sama selama 12 minggu. Delapan puluh dua peserta memberikan data cukup. Waktu termodel untuk mencapai 95% estimasi otomatisitas asimtotik bervariasi dari 18 hingga 254 hari.";
"theory_topic_habit_limitation" = "Ini adalah studi pembentukan kebiasaan, bukan studi berapa jam yang dibutuhkan untuk menguasai keterampilan. Tidak mendukung ambang penguasaan 21 jam maupun aturan kebiasaan universal 21 hari.";
"theory_milestones_title" = "Tonggak kemajuan";
