/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Esta pantalla lista las habilidades incluidas con la aplicación: el conjunto original más las entradas aceptadas de la colección desarrollada. Los archivos de propuestas piloto no son, por sí solos, el catálogo.";
"theory_compendium_intro" = "Cada pestaña es una marca de horas que ya usa la barra de progreso. El cristal es el color de esa marca. El texto explica qué significa la marca y qué no significa.";
"theory_hour_unit" = "horas";
"theory_callout_example" = "Ejemplo";
"theory_callout_caveat" = "Advertencia";
"theory_callout_takeaway" = "Conclusión";
"theory_chapter_21_title" = "Superar el comienzo";
"theory_chapter_21_lead" = "Veintiuna horas cambian el color de la barra de progreso. No es un hallazgo de investigación. El método publicado más cercano es el marco de 20 horas de Josh Kaufman para superar el comienzo torpe, y esos dos números no afirman lo mismo.";
"theory_chapter_21_mechanism_title" = "Un método para el comienzo";
"theory_chapter_21_mechanism" = "Kaufman trata el comienzo como un problema práctico. Parte la habilidad en trozos más pequeños, aprende lo bastante para notar tus propios errores, quita las barreras que hacen incómoda la práctica y dedica tiempo concentrado a un resultado. El libro lo presenta como un método del autor para empezar.";
"theory_chapter_21_example" = "Quien quiere que tres acordes suenen limpios puede practicar ese resultado. «Aprender guitarra» es una meta más grande, y las primeras horas no la resuelven.";
"theory_chapter_100_title" = "Cien horas, como marca de la aplicación";
"theory_chapter_100_lead" = "Cien horas son un hito de Time4Skill para el tiempo ya registrado. Ninguno de los estudios reunidos en este compendio define 100 horas como el punto en el que alguien se vuelve competente.";
"theory_chapter_100_mechanism_title" = "Qué midió de verdad la investigación cercana";
"theory_chapter_100_mechanism" = "Dos líneas de trabajo están cerca de este periodo, pero no lo miden en horas. Cepeda, Pashler, Vul, Wixted y Rohrer revisaron 317 experimentos sobre el recuerdo verbal. En esa literatura, las sesiones espaciadas vencían al estudio masivo, y el intervalo útil dependía de cuánto tiempo había que recordar el material. Lally, van Jaarsveld, Potts y Wardle pidieron a voluntarios repetir una conducta de comida, bebida o actividad en el mismo contexto. El tiempo modelado para llegar al 95 por ciento de la meseta propia de cada persona varió mucho. Perder un día no borraba la curva.";
"theory_chapter_100_example" = "Tocar una pieza corta en tres días distintos muestra qué compás se quedó de verdad en la memoria. Una tarde larga de repetición no responde a esa pregunta.";
"theory_chapter_100_caveat" = "La revisión sobre el espaciado trata del recuerdo verbal. El estudio de hábitos trata de la automaticidad de una conducta elegida, y su rango fue de 18 a 254 días en el modelo publicado con el artículo, no una línea de competencia a las 100 horas. Ningún resultado dice que 100 horas vuelvan a alguien competente en fotografía, conducción u otra habilidad.";
"theory_chapter_100_takeaway" = "Usa la marca para notar si vuelves. No la trates como un nivel que hayas ganado.";
"theory_chapter_1000_title" = "Práctica dirigida a una sola laguna";
"theory_chapter_1000_lead" = "El cristal de 1 000 horas registra el tiempo dedicado. No significa que la persona sea ya un profesional, un profesor o alguien que pueda vivir de la habilidad.";
"theory_chapter_1000_mechanism_title" = "La práctica deliberada, y cuánto explicó";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe y Tesch-Römer describieron la práctica deliberada como una actividad organizada para mejorar un aspecto concreto, con información de retorno y corrección, en lugar de repetir simplemente lo que ya resulta cómodo. Su artículo de 1993 elaboró ese marco con estudios de músicos. No publicó un número de horas que cree expertos en todos los campos. Macnamara, Hambrick y Oswald estimaron después cuánta diferencia de rendimiento se asociaba con la práctica deliberada. Las partes cambiaban según el ámbito: más altas en juegos, música y deporte que en educación y profesiones.";
"theory_chapter_1000_example" = "Una hora dedicada al pasaje que sigue rompiéndose es una actividad distinta de una hora tocando piezas que ya salen bien. La barra de progreso registra el tiempo en ambos casos.";
"theory_chapter_1000_caveat" = "Los porcentajes por ámbito son partes de la varianza en ese metaanálisis de 2014. No son la parte de una habilidad que una persona puede aprender, ni la probabilidad de éxito de nadie. El artículo no fija 1 000 horas como umbral profesional. Un texto más antiguo de la aplicación, que trataba las 1 000 horas como el momento de volverse profesional, exageraba las pruebas.";
"theory_chapter_10000_title" = "Un número famoso, no una ley";
"theory_chapter_10000_lead" = "Diez mil horas se hicieron famosas como regla de la maestría. La investigación de la que salió esa idea no estableció una ley, y el cristal de esta pestaña solo identifica la marca de horas más alta que muestra la aplicación.";
"theory_chapter_10000_mechanism_title" = "Cómo viajó el número";
"theory_chapter_10000_mechanism" = "Outliers (2008), de Malcolm Gladwell, hizo muy conocido el número redondo. Se apoyaba en investigación sobre el rendimiento experto, incluido el artículo de 1993 de Ericsson, Krampe y Tesch-Römer sobre la práctica deliberada de músicos. Macnamara y Maitra (2019) explican en qué se aparta esa regla popular de la investigación. La versión popular comprimió un argumento complicado en un solo umbral que garantizaría la maestría.";
"theory_chapter_10000_example" = "Dos personas pueden registrar el mismo total y aun así haber pasado el tiempo de forma distinta. Una quizá tuvo un profesor que corregía un fallo concreto. La otra quizá repetía una pieza que ya toca. El total de horas no registra esa diferencia.";
