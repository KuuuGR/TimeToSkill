/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Dit scherm toont de vaardigheden die bij de app horen: de oorspronkelijke set plus items uit de uitgewerkte catalogus.";
"theory_compendium_intro" = "Hver fane er et timemerke som fremdriftslinjen allerede bruker. Krystallen er merkets farge. Teksten forklarer hva merket betyr — og hva det ikke betyr.";
"theory_hour_unit" = "timer";
"theory_callout_example" = "Eksempel";
"theory_callout_caveat" = "Forbehold";
"theory_callout_takeaway" = "Lærdom";
"theory_chapter_21_title" = "Forbi begynnelsen";
"theory_chapter_21_lead" = "Tjueén timer endrer fargen på fremdriftslinjen. Det er ikke et forskningsfunn. Den nærmeste publiserte metoden er Josh Kaufmans 20-timers ramme for å overleve den keitete starten, og de to tallene er ikke den samme påstanden.";
"theory_chapter_21_mechanism_title" = "En metode for starten";
"theory_chapter_21_mechanism" = "Kaufman behandler begynnelsen som et praktisk problem. Del ferdigheten i mindre deler, lær nok til å merke egne feil, fjern hindringer som gjør øving upraktisk, og bruk fokusert tid på ett resultat. Boken presenterer det som en forfattermetode for å komme i gang.";
"theory_chapter_21_example" = "En person som vil at tre akkorder skal høres rene ut, kan øve akkurat det resultatet. «Lære gitar» er et større mål, og de første timene avgjør det ikke.";
"theory_chapter_100_title" = "Hundre timer som app-merke";
"theory_chapter_100_lead" = "Hundre timer er en Time4Skill-milepæl for allerede registrert tid. Ingen av studiene i dette kompendiet definerer 100 timer som punktet der noen blir kompetent.";
"theory_chapter_100_mechanism_title" = "Hva nærliggende forskning faktisk målte";
"theory_chapter_100_mechanism" = "To forskningslinjer ligger nær denne perioden uten å måle den i timer. Cepeda, Pashler, Vul, Wixted og Rohrer gikk gjennom 317 eksperimenter om verbal gjenkalling. Spredte økter slo pugging i den litteraturen, og det nyttige mellomrommet avhang av hvor lenge materialet skulle huskes. Lally, van Jaarsveld, Potts og Wardle ba frivillige gjenta en spise-, drikke- eller aktivitetsatferd i samme kontekst. Den modellerte tiden til 95 prosent av hver persons eget platå varierte sterkt. Å miste én dag slettet ikke kurven.";
"theory_chapter_100_example" = "Å spille et kort stykke på tre forskjellige dager viser hvilken takt som faktisk ble værende i hukommelsen. En lang kveld med gjentakelse svarer ikke på det spørsmålet.";
"theory_chapter_100_caveat" = "Oversikten om spredning handler om verbal gjenkalling. Vaneundersøkelsen handler om automatisering av en valgt atferd, og intervallet i modellen med artikkelen var 18 til 254 dager — ikke en kompetanselinje ved 100 timer. Ingen resultat sier at 100 timer gjør noen kompetent i fotografi, bilkjøring eller en annen ferdighet.";
"theory_chapter_100_takeaway" = "Bruk merket til å merke om du kommer tilbake. Behandle det ikke som et fortjent nivå.";
"theory_chapter_1000_title" = "Øving rettet mot ett hull";
"theory_chapter_1000_lead" = "1000-timerskrystallen registrerer brukt tid. Den betyr ikke at personen nå er profesjonell, lærer eller noen som kan leve av ferdigheten.";
"theory_chapter_1000_mechanism_title" = "Bevisst øving, og hvor mye den forklarte";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe og Tesch-Römer beskrev bevisst øving som aktivitet arrangert for å forbedre et bestemt aspekt, med tilbakemelding og korreksjon, i stedet for bare å gjenta det allerede behagelige. Artikkelen deres fra 1993 utviklet rammen med studier av musikere. Den publiserte ikke et timeantall som skaper eksperter på hvert felt. Macnamara, Hambrick og Oswald estimerte senere hvor mye av forskjellen i prestasjon hang sammen med bevisst øving. Andelene varierte etter domene: høyere i spill, musikk og sport enn i utdanning og yrker.";
"theory_chapter_1000_example" = "En time på passasjen som fortsatt faller fra hverandre er en annen aktivitet enn en time med stykker som allerede går bra. Fremdriftslinjen registrerer tiden i begge tilfeller.";
"theory_chapter_1000_caveat" = "Domeneprosentene er andeler av varians i metaanalysen fra 2014. De er ikke den delen av en ferdighet man kan lære, og ikke noens sjanse for suksess. Artikkelen setter ikke 1000 timer som profesjonell terskel. Eldre ordlyd i appen som behandlet 1000 timer som punktet for å bli profesjonell, overdrev evidensen.";
"theory_chapter_10000_title" = "Et berømt tall, ikke en lov";
"theory_chapter_10000_lead" = "Ti tusen timer ble berømte som mesterskapsregel. Forskningen den kom fra etablerte ikke en lov, og krystallen på denne fanen markerer bare appens høyeste viste timemerke.";
"theory_chapter_10000_mechanism_title" = "Hvordan tallet reiste";
"theory_chapter_10000_mechanism" = "Malcolm Gladwells Outliers (2008) gjorde det runde tallet vidt kjent. Den bygde på forskning om ekspertprestasjon, inkludert artikkelen fra 1993 av Ericsson, Krampe og Tesch-Römer om bevisst øving blant musikere. Macnamara og Maitra (2019) diskuterer hvordan den populære regelen skiller seg fra forskningen. Den populære versjonen presset et komplisert argument sammen til én terskel som skulle garantere mestring.";
"theory_chapter_10000_example" = "To personer kan registrere samme total og likevel ha brukt tiden forskjellig. Den ene hadde kanskje en lærer som rettet en bestemt feil. Den andre gjentok kanskje et stykke de allerede spiller. Timetotalen registrerer ikke den forskjellen.";
