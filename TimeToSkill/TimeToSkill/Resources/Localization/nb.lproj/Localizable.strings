"theory_topic_spacing_summary" = "Forskning på fordelt øving støtter å spre læring over flere økter i stedet for bare massert øving. Beste avstand avhenger av materialet og av hvor lenge du vil huske det.";
"theory_topic_spacing_takeaway" = "Prøv å komme tilbake til en ferdighet over flere dager, og se hva du husker og hva som trenger mer øving.";
"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "Metaanalysen gikk gjennom 317 eksperimenter i 184 artikler, med 839 vurderinger av fordelt øving.";
"theory_topic_spacing_limitation" = "Disse resultatene gjelder lærings- og gjenkallingsoppgaver. De presenterer ikke én optimal plan for hver fysisk, sosial, kunstnerisk eller profesjonell ferdighet.";
"theory_topic_habit_title" = "En vane har ingen universell frist";
"theory_topic_habit_summary" = "Å gjenta en handling i samme kontekst kan gjøre den mer automatisk over tid. Den nødvendige tiden varierer imidlertid mellom mennesker og atferd. Å miste én dag betyr ikke at all fremgang er tapt.";
"theory_topic_habit_takeaway" = "Knytt en aktivitet til en situasjon du møter regelmessig, og gjenoppta uten skyld når en økt faller bort.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "Nittiseks frivillige valgte en spise-, drikke- eller aktivitetsatferd å gjenta i samme kontekst i 12 uker. Åttito deltakere leverte tilstrekkelige data. Den modellerte tiden til 95 % av det asymptotiske automatiseringsestimatet varierte fra 18 til 254 dager.";
"theory_topic_habit_limitation" = "Det var en studie av vanedannelse, ikke en studie av hvor mange timer som trengs for å mestre en ferdighet. Den støtter verken en 21-timers mestringsterskel eller en universell 21-dagers vaneregel.";
"theory_milestones_title" = "Fremdriftsmilepæler";
"theory_milestones_note" = "The 100-hour, 1,000-hour, and 10,000-hour marks in Time4Skill record time you have spent. They are progress milestones, not scientifically validated stages, and they do not predict when you will become an expert.";
"theory_milestone_100_title" = "100 timer";
