/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Ten ekran pokazuje umiejętności dołączone do aplikacji: dotychczasowy zestaw oraz pozycje przyjęte z opracowanego zbioru. Pliki propozycji pilotażowych same nie są katalogiem.";
"theory_compendium_intro" = "Svaka kartica je satna oznaka koju traka napretka već koristi. Kristal je boja te oznake. Tekst objašnjava što oznaka znači — i što ne znači.";
"theory_hour_unit" = "sati";
"theory_callout_example" = "Primjer";
"theory_callout_caveat" = "Ograničenje";
"theory_callout_takeaway" = "Zaključak";
"theory_chapter_21_title" = "Prijeći početak";
"theory_chapter_21_lead" = "Dvadeset i jedan sat mijenja boju trake napretka. To nije istraživački nalaz. Najbliža objavljena metoda je Kaufmanov okvir od 20 sati za preživljavanje nezgrapnog početka, i ta dva broja nisu ista tvrdnja.";
"theory_chapter_21_mechanism_title" = "Metoda za početak";
"theory_chapter_21_mechanism" = "Kaufman tretira početak kao praktičan problem. Podijelite vještinu na manje dijelove, naučite dovoljno da primijetite vlastite pogreške, uklonite prepreke koje otežavaju vježbu i posvetite usredotočeno vrijeme jednom rezultatu. Knjiga to predstavlja kao autorovu metodu za početak.";
"theory_chapter_21_example" = "Osoba koja želi da tri akorda zvuče čisto može vježbati upravo taj rezultat. „Naučiti gitaru“ veći je cilj, a prvi sati ga ne rješavaju.";
"theory_chapter_100_title" = "Sto sati kao oznaka aplikacije";
"theory_chapter_100_lead" = "Sto sati je milja Time4Skilla za već zabilježeno vrijeme. Nijedna studija u ovom kompendiju ne definira 100 sati kao trenutak u kojem netko postaje kompetentan.";
"theory_chapter_100_mechanism_title" = "Što je blisko istraživanje zapravo mjerilo";
"theory_chapter_100_mechanism" = "Dvije istraživačke linije leže blizu ovog razdoblja bez da ga mjere u satima. Cepeda, Pashler, Vul, Wixted i Rohrer pregledali su 317 eksperimenata o verbalnom prisjećanju. Raspršene sesije u toj literaturi pobjeđivale su bubanje, a koristan razmak ovisio je o tome koliko dugo materijal treba pamtiti. Lally, van Jaarsveld, Potts i Wardle tražili su od dobrovoljaca da ponavljaju ponašanje jedenja, pijenja ili aktivnosti u istom kontekstu. Modelirano vrijeme do 95 posto vlastitog platoa svake osobe široko je variralo. Propuštanje jednog dana nije brisalo krivulju.";
"theory_chapter_100_example" = "Sviranje kratkog odlomka u tri različita dana pokazuje koji je takt stvarno ostao u pamćenju. Jedna duga večer ponavljanja ne odgovara na to pitanje.";
"theory_chapter_100_caveat" = "Pregled o razmacima tiče se verbalnog prisjećanja. Studija navike tiče se automatizma odabranog ponašanja, a raspon u modelu uz članak bio je od 18 do 254 dana, a ne linija kompetencije na 100 sati. Nijedan rezultat ne kaže da 100 sati čini nekoga kompetentnim u fotografiji, vožnji ili bilo kojoj drugoj vještini.";
"theory_chapter_100_takeaway" = "Koristite oznaku da primijetite vraćate li se. Nemojte je tretirati kao zarađenu razinu.";
"theory_chapter_1000_title" = "Vježba usmjerena na jednu prazninu";
"theory_chapter_1000_lead" = "Kristal od 1000 sati bilježi potrošeno vrijeme. Ne znači da je osoba sada profesionalac, učitelj ili netko tko može živjeti od vještine.";
"theory_chapter_1000_mechanism_title" = "Namjerna praksa i koliko je objašnjavala";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe i Tesch-Römer opisali su namjernu praksu kao aktivnost uređenu za poboljšanje određenog aspekta, s povratnom informacijom i korekcijom, umjesto pukog ponavljanja već ugodnog. Njihov članak iz 1993. razvio je taj okvir na studijama glazbenika. Nije objavio broj sati koji stvara eksperte u svakom području. Macnamara, Hambrick i Oswald kasnije su procijenili koliki dio razlika u izvedbi bio je povezan s namjernom praksom. Udjeli su se razlikovali po domenama: viši u igrama, glazbi i sportu nego u obrazovanju i profesijama.";
"theory_chapter_1000_example" = "Sat na odlomku koji se još lomi drugačija je aktivnost od sata sviranja komada koji već idu dobro. Traka napretka bilježi vrijeme u oba slučaja.";
"theory_chapter_1000_caveat" = "Postoci po domenama udjeli su varijance u metaanalizi iz 2014. Nisu dio vještine koji se može naučiti niti čija šansa uspjeha. Članak ne postavlja 1000 sati kao profesionalni prag. Starija formulacija u aplikaciji koja je 1000 sati tretirala kao trenutak postajanja profesionalcem pretjerivala je dokaze.";
"theory_chapter_10000_title" = "Poznati broj, ne zakon";
"theory_chapter_10000_lead" = "Deset tisuća sati postalo je poznato kao pravilo majstorstva. Istraživanje iz kojeg je izvedeno nije uspostavilo zakon, a kristal na ovoj kartici samo označava najvišu prikazanu satnu oznaku aplikacije.";
"theory_chapter_10000_mechanism_title" = "Kako je broj putovao";
"theory_chapter_10000_mechanism" = "Outliers (2008) Malcolma Gladwella učinio je okrugli broj široko poznatim. Oslanjavao se na istraživanje ekspertske izvedbe, uključujući članak Ericssona, Krampea i Tesch-Römera iz 1993. o namjernoj praksi glazbenika. Macnamara i Maitra (2019) raspravljaju čime se to popularno pravilo razlikuje od istraživanja. Popularna verzija sažela je složeni argument u jedan prag koji bi jamčio majstorstvo.";
"theory_chapter_10000_example" = "Dvoje ljudi može zabilježiti isti zbroj i ipak potrošiti vrijeme drugačije. Jedan je možda imao učitelja koji ispravlja određeni nedostatak. Drugi je možda ponavljao komad koji već svira. Zbroj sati tu razliku ne bilježi.";
