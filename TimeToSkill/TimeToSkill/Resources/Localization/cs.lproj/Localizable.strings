"theory_topic_deliberate_title" = "Cvičit s cílem";
"theory_topic_deliberate_summary" = "Opakovat činnost není totéž jako ji záměrně zlepšovat. Vyberte konkrétní aspekt, cvičte s jasným cílem, všímejte si chyb a upravte další pokus. Sledovat čas je užitečné, ale záleží i na způsobu cvičení.";
"theory_topic_deliberate_takeaway" = "Před session rozhodněte, co jednu věc chcete zlepšit.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
