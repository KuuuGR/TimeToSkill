/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "この画面はアプリ同梱のスキルを示します。当初のセットと、作成済みカタログからの項目です。";
"theory_compendium_intro" = "各タブは、進捗バーですでに使われている時間の目印です。クリスタルはその目印の色です。文章は、目印が意味することと意味しないことを説明します。";
"theory_hour_unit" = "時間";
"theory_callout_example" = "例";
"theory_callout_caveat" = "注意点";
"theory_callout_takeaway" = "要点";
"theory_chapter_21_title" = "最初の壁を越える";
"theory_chapter_21_lead" = "21時間は進捗バーの色を変えます。これは研究上の発見ではありません。最も近い公表された方法は、ぎこちない始まりを乗り越えるための Josh Kaufman の20時間の枠組みであり、この二つの数字は同じ主張ではありません。";
"theory_chapter_21_mechanism_title" = "始め方の方法";
"theory_chapter_21_mechanism" = "Kaufman は始まりを実践的な問題として扱います。技能を小さな部分に分け、自分の誤りに気づけるだけ学び、練習を不便にする障害を除き、一つの結果に集中した時間を使います。本はこれを始めるための著者の方法として示しています。";
"theory_chapter_21_example" = "三つのコードをきれいに鳴らしたい人は、まさにその結果を練習できます。「ギターを学ぶ」はより大きな目標であり、最初の数時間では決まりません。";
"theory_chapter_100_title" = "アプリの目印としての100時間";
"theory_chapter_100_lead" = "100時間は、すでに記録された時間についての Time4Skill の節目です。この概説に集めたどの研究も、100時間を誰かが熟練する時点としては定義していません。";
"theory_chapter_100_mechanism_title" = "近い研究が実際に測ったこと";
"theory_chapter_100_mechanism" = "二つの研究の流れはこの時期の近くにありますが、時間数では測っていません。Cepeda、Pashler、Vul、Wixted、Rohrer は言語的想起に関する317の実験を検討しました。その文献ではセッションを分散した方が詰め込みより良く、有用な間隔は材料をどれだけ長く覚えたいかによりました。Lally、van Jaarsveld、Potts、Wardle は、同じ文脈で飲食や活動の行動を繰り返すようボランティアに依頼しました。各人自身の高原の95パーセントに達するまでのモデル化時間は大きくばらつきました。一日欠けても曲線は消えませんでした。";
"theory_chapter_100_example" = "短い曲を別々の三日に弾くと、どの小節が本当に記憶に残ったかが分かります。長い一夜の反復ではその問いに答えられません。";
"theory_chapter_100_caveat" = "間隔の概観は言語的想起についてです。習慣の研究は選んだ行動の自動化についてで、論文とともに報告されたモデルの範囲は18〜254日であり、100時間での熟練ラインではありません。どの結果も、100時間が写真・運転・その他の技能で誰かを熟練させるとは述べていません。";
"theory_chapter_100_takeaway" = "目印を、戻ってきているかに気づくために使ってください。得たレベルとして扱わないでください。";
"theory_chapter_1000_title" = "一つのすき間に向けた練習";
"theory_chapter_1000_lead" = "1000時間のクリスタルは使った時間を記録します。その人がいま専門家や教師、その技能で生計を立てられる人になったことは意味しません。";
"theory_chapter_1000_mechanism_title" = "熟慮した練習と、それが説明した割合";
"theory_chapter_1000_mechanism" = "Ericsson、Krampe、Tesch-Römer は、すでに楽なことの単なる反復ではなく、フィードバックと修正を伴い特定の側面を改善するよう組み立てた活動として熟慮した練習を述べました。1993年の論文はその枠組みを音楽家の研究で展開しました。あらゆる分野で専門家を生む時間数は公表していません。Macnamara、Hambrick、Oswald は後に、成績差のどれだけが熟慮した練習と関連するかを推定しました。割合は領域で異なり、教育や専門職よりゲーム・音楽・スポーツで高かったです。";
"theory_chapter_1000_example" = "いつも崩れる箇所に使う一時間は、すでにうまくいく曲を弾く一時間とは別の活動です。進捗バーはどちらも時間を記録します。";
"theory_chapter_1000_caveat" = "領域の百分率は2014年のメタ分析における分散の割合です。学べる技能の割合でも、誰かの成功確率でもありません。論文は1000時間を職業的閾値としてはいません。1000時間を専門家になる時点として扱ったアプリの古い文言は根拠を過大に述べていました。";
"theory_chapter_10000_title" = "有名な数字であって法則ではない";
"theory_chapter_10000_lead" = "1万時間は熟達の規則として有名になりました。それが依拠した研究は法則を確立しておらず、このタブのクリスタルはアプリが表示する最高の時間目印を示すだけです。";
"theory_chapter_10000_mechanism_title" = "数字がどう伝わったか";
"theory_chapter_10000_mechanism" = "Malcolm Gladwell の Outliers（2008）が丸い数字を広く知らしめました。専門家のパフォーマンス研究、とりわけ音楽家の熟慮した練習に関する Ericsson、Krampe、Tesch-Römer の1993年論文に依拠していました。Macnamara と Maitra（2019）は、その通俗的規則が研究とどう異なるかを論じています。通俗版は複雑な議論を、熟達を保証する一つの閾値に圧縮しました。";
"theory_chapter_10000_example" = "二人は同じ合計を記録しても、時間の使い方は違い得ます。一方は特定の欠点を直す教師がいたかもしれません。他方はすでに弾ける曲を繰り返していたかもしれません。時間の合計はその違いを記録しません。";
