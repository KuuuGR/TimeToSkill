/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Dit scherm toont de vaardigheden die bij de app horen: de oorspronkelijke set plus items uit de uitgewerkte catalogus.";
"theory_compendium_intro" = "Varje flik är ett timmärke som förloppsraden redan använder. Kristallen är märkets färg. Texten förklarar vad märket betyder — och vad det inte betyder.";
"theory_hour_unit" = "timmar";
"theory_callout_example" = "Exempel";
"theory_callout_caveat" = "Förbehåll";
"theory_callout_takeaway" = "Att ta med";
"theory_chapter_21_title" = "Förbi början";
"theory_chapter_21_lead" = "Tjugoen timmar ändrar förloppsradens färg. Det är inte ett forskningsfynd. Den närmaste publicerade metoden är Josh Kaufmans 20-timmarsram för att överleva den trevande starten, och de två siffrorna är inte samma påstående.";
"theory_chapter_21_mechanism_title" = "En metod för starten";
"theory_chapter_21_mechanism" = "Kaufman behandlar början som ett praktiskt problem. Dela upp färdigheten i mindre delar, lär dig tillräckligt för att märka egna misstag, ta bort hinder som gör övning obekväm och lägg fokuserad tid på ett resultat. Boken presenterar det som en författarmetod för att komma igång.";
"theory_chapter_21_example" = "Den som vill att tre ackord ska låta rena kan öva just det resultatet. ”Lära sig gitarr” är ett större mål, och de första timmarna avgör det inte.";
"theory_chapter_100_title" = "Hundra timmar som app-märke";
"theory_chapter_100_lead" = "Hundra timmar är en Time4Skill-milstolpe för redan registrerad tid. Ingen av studierna i detta kompendium definierar 100 timmar som den punkt då någon blir kompetent.";
"theory_chapter_100_mechanism_title" = "Vad närliggande forskning faktiskt mätte";
"theory_chapter_100_mechanism" = "Två forskningslinjer ligger nära denna period utan att mäta den i timmar. Cepeda, Pashler, Vul, Wixted och Rohrer gick igenom 317 experiment om verbalt återkallande. Spridda sessioner slog proppning i den litteraturen, och det användbara avståndet berodde på hur länge materialet skulle minnas. Lally, van Jaarsveld, Potts och Wardle bad frivilliga upprepa ett ät-, dryckes- eller aktivitetsbeteende i samma kontext. Den modellerade tiden till 95 procent av varje persons eget platåvärde varierade kraftigt. Att missa en dag raderade inte kurvan.";
"theory_chapter_100_example" = "Att spela ett kort stycke på tre olika dagar visar vilken takt som verkligen stannade i minnet. En lång kväll av upprepning besvarar inte den frågan.";
"theory_chapter_100_caveat" = "Översikten om spridning handlar om verbalt återkallande. Vanestudien handlar om automatisering av ett valt beteende, och intervallet i modellen med artikeln var 18 till 254 dagar — inte en kompetenslinje vid 100 timmar. Inget resultat säger att 100 timmar gör någon kompetent i fotografi, bilkörning eller någon annan färdighet.";
"theory_chapter_100_takeaway" = "Använd märket för att märka om du kommer tillbaka. Behandla det inte som en förtjänad nivå.";
"theory_chapter_1000_title" = "Övning riktad mot ett gap";
"theory_chapter_1000_lead" = "1000-timmarskristallen registrerar använd tid. Den betyder inte att personen nu är professionell, lärare eller någon som kan leva på färdigheten.";
"theory_chapter_1000_mechanism_title" = "Medveten övning, och hur mycket den förklarade";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe och Tesch-Römer beskrev medveten övning som aktivitet upplagd för att förbättra en specifik aspekt, med feedback och korrigering, snarare än att bara upprepa det redan bekväma. Deras artikel från 1993 utvecklade ramen med studier av musiker. Den publicerade inte ett timtal som skapar experter inom varje område. Macnamara, Hambrick och Oswald uppskattade senare hur mycket av prestationsskillnaderna hängde samman med medveten övning. Andelarna skilde sig efter domän: högre i spel, musik och sport än i utbildning och yrken.";
"theory_chapter_1000_example" = "En timme på passagen som fortfarande faller isär är en annan aktivitet än en timme med stycken som redan går bra. Förloppsraden registrerar tiden i båda fallen.";
"theory_chapter_1000_caveat" = "Domänprocenten är andelar av varians i metaanalysen från 2014. De är inte den del av en färdighet man kan lära sig, och inte någons chans till framgång. Artikeln sätter inte 1000 timmar som professionell tröskel. Äldre formulering i appen som behandlade 1000 timmar som punkten för att bli professionell överdrev evidensen.";
"theory_chapter_10000_title" = "Ett berömt tal, inte en lag";
"theory_chapter_10000_lead" = "Ti tusen timmar blev berömda som en mästarregel. Forskningen den hämtades från etablerade ingen lag, och kristallen på denna flik markerar bara appens högsta visade timmärke.";
"theory_chapter_10000_mechanism_title" = "Hur talet reste";
"theory_chapter_10000_mechanism" = "Malcolm Gladwells Outliers (2008) gjorde det runda talet vitt känt. Den byggde på forskning om expertprestation, inklusive artikeln från 1993 av Ericsson, Krampe och Tesch-Römer om medveten övning bland musiker. Macnamara och Maitra (2019) diskuterar hur den populära regeln skiljer sig från forskningen. Den populära versionen pressade ihop ett komplicerat argument till en tröskel som skulle garantera mästerskap.";
"theory_chapter_10000_example" = "Två personer kan registrera samma total och ändå ha använt tiden olika. Den ene hade kanske en lärare som rättade ett specifikt fel. Den andre upprepade kanske ett stycke de redan spelar. Timtotalen registrerar inte den skillnaden.";
