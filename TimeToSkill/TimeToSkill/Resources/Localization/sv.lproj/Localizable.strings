"theory_topic_spacing_summary" = "Forskning om fördelad övning stödjer att sprida lärande över flera sessioner i stället för att bara förlita sig på massad övning. Bästa avståndet beror på materialet och på hur länge du vill behålla det.";
"theory_topic_spacing_takeaway" = "Försök återvända till en färdighet under flera dagar och se vad du minns och vad som behöver mer övning.";
"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "Metaanalysen gick igenom 317 experiment i 184 artiklar, med 839 bedömningar av fördelad övning.";
"theory_topic_spacing_limitation" = "Dessa resultat rör inlärnings- och återkallningsuppgifter. De presenterar inte ett optimalt schema för varje fysisk, social, konstnärlig eller professionell färdighet.";
"theory_topic_habit_title" = "En vana har ingen universell deadline";
"theory_topic_habit_summary" = "Att upprepa en handling i samma kontext kan göra den mer automatisk över tid. Den nödvändiga tiden skiljer sig dock mellan människor och beteenden. Att missa en dag betyder inte att all framsteg är förlorad.";
"theory_topic_habit_takeaway" = "Koppla en aktivitet till en situation du möter regelbundet, och återuppta utan skuld när en session faller bort.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "Nittiosex frivilliga valde ett ät-, dryckes- eller aktivitetsbeteende att upprepa i samma kontext i 12 veckor. Åttiotvå deltagare lämnade tillräckliga data. Den modellerade tiden till 95 % av det asymptotiska automatiseringsestimatet varierade från 18 till 254 dagar.";
"theory_topic_habit_limitation" = "Det var en studie av vanebildning, inte en studie av hur många timmar som krävs för att bemästra en färdighet. Den stöder varken en 21-timmars mästartröskel eller en universell 21-dagars vaneregel.";
"theory_milestones_title" = "Framstegsmilstolpar";
"theory_milestones_note" = "The 100-hour, 1,000-hour, and 10,000-hour marks in Time4Skill record time you have spent. They are progress milestones, not scientifically validated stages, and they do not predict when you will become an expert.";
