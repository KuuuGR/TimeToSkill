"theory_topic_spacing_title" = "Zur Fähigkeit zurückkehren statt alles auf einmal zu pauken";
"theory_topic_spacing_summary" = "Forschung zur verteilten Praxis spricht dafür, Lernen auf mehrere Sitzungen zu verteilen statt nur auf massiertes Üben zu setzen. Der beste Abstand hängt vom Stoff und davon ab, wie lange du ihn behalten willst.";
"theory_topic_spacing_takeaway" = "Kehre über mehrere Tage zu einer Fähigkeit zurück und beobachte, was du behältst und was mehr Übung braucht.";
"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "Die Metaanalyse wertete 317 Experimente in 184 Artikeln mit 839 Einschätzungen verteilter Praxis aus.";
"theory_topic_spacing_limitation" = "Diese Ergebnisse betreffen Lern- und Erinnerungsaufgaben. Sie bieten keinen für jede körperliche, soziale, künstlerische oder berufliche Fähigkeit optimalen Zeitplan.";
"theory_topic_habit_title" = "Eine Gewohnheit hat keine universelle Frist";
"theory_topic_habit_summary" = "Eine Handlung im gleichen Kontext zu wiederholen kann sie mit der Zeit automatischer machen. Die benötigte Zeit unterscheidet sich jedoch zwischen Personen und Verhaltensweisen. Ein verpasster Tag bedeutet nicht, dass aller Fortschritt verloren ist.";
"theory_topic_habit_takeaway" = "Verbinde eine Tätigkeit mit einer Situation, der du regelmäßig begegnest, und setze ohne Schuldgefühle fort, wenn eine Sitzung ausfällt.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "Sechsundneunzig Freiwillige wählten ein Ess-, Trink- oder Aktivitätsverhalten, das sie zwölf Wochen im gleichen Kontext wiederholen sollten. Zweiundachtzig Teilnehmende lieferten ausreichende Daten. Die modellierte Zeit bis 95 % der asymptotischen Automatizitätsschätzung schwankte von 18 bis 254 Tagen.";
"theory_topic_habit_limitation" = "Das war eine Studie zur Gewohnheitsbildung, keine Studie darüber, wie viele Stunden bis zur Meisterschaft nötig sind. Sie stützt weder eine 21-Stunden-Meisterschaftsschwelle noch eine universelle 21-Tage-Gewohnheitsregel.";
"theory_milestones_title" = "Fortschrittsmeilensteine";
"theory_milestones_note" = "The 100-hour, 1,000-hour, and 10,000-hour marks in Time4Skill record time you have spent. They are progress milestones, not scientifically validated stages, and they do not predict when you will become an expert.";
