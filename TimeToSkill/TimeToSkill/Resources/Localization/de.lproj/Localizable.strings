"theory_topic_first20_title" = "Die ersten 20 Stunden: Am Anfang vorbeikommen";
"theory_topic_first20_summary" = "Der Start einer Fähigkeit ist oft frustrierend, weil alles ungewohnt ist. Josh Kaufman schlägt einen praktischen Ansatz vor: die Fähigkeit in kleinere Teile zerlegen, sich auf das Wesentliche konzentrieren, Übungshindernisse entfernen und konzentrierte Zeit zum Verbessern nutzen. Sein 20-Stunden-Rahmen ist eine Startmethode, keine wissenschaftliche Garantie, dass jede Fähigkeit in 20 Stunden beherrscht wird.";
"theory_topic_first20_takeaway" = "Wähle eine konkrete Sache, die du nach den ersten 20 Stunden besser können willst.";
"theory_topic_first20_citation" = "Josh Kaufman. The First 20 Hours: How to Learn Anything… Fast! Ebook published in 2013; paperback published in 2014.";
"theory_topic_first20_context" = "Praktischer Rahmen und Buch des Autors, keine kontrollierte wissenschaftliche Studie.";
"theory_topic_first20_limitation" = "Der 20-Stunden-Rahmen ist eine Startmethode. Er ist keine wissenschaftlich etablierte Zeit bis zur Meisterschaft.";
"theory_topic_deliberate_title" = "Mit Absicht üben";
"theory_topic_deliberate_summary" = "Eine Tätigkeit zu wiederholen ist nicht dasselbe wie sie gezielt zu verbessern. Wähle einen konkreten Aspekt, übe mit klarem Ziel, bemerke Fehler und passe den nächsten Versuch an. Zeit zu erfassen ist nützlich, aber die Art des Übens zählt ebenfalls.";
"theory_topic_deliberate_takeaway" = "Entscheide vor einer Sitzung, was eine Sache ist, die du verbessern willst.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "Der Artikel entwickelte einen Rahmen für Expertenleistung und berichtete Studien mit Musikerinnen und Musikern, darunter Geigerinnen, Geiger und Pianistinnen und Pianisten.";
"theory_topic_deliberate_limitation" = "Der Artikel legt keine feste Übungsstundenzahl fest, die Meisterschaft in allen Fähigkeiten garantiert.";
"theory_topic_10k_title" = "10.000 Stunden: Eine populäre Regel, kein Gesetz";
"theory_topic_10k_summary" = "Die 10.000-Stunden-Regel wurde durch Malcolm Gladwells Outliers (2008) weithin bekannt. Sie stützte sich auf Forschung zu Expertenleistung, doch die populäre Fassung vereinfachte das ursprüngliche Argument. Es gibt keine universelle magische Stundenzahl, die Meisterschaft garantiert.";
"theory_topic_10k_takeaway" = "Nutze langfristige Meilensteine, um Ausdauer zu feiern — nicht um vorherzusagen, wann du Expertin oder Experte wirst.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "Die 10.000-Stunden-Regel wurde durch Malcolm Gladwells Outliers (2008) weithin bekannt. Der Artikel von 2019 erörtert, wie sich diese populäre Regel von der Forschung von 1993 unterscheidet.";
"theory_topic_10k_limitation" = "Ericsson und Kolleginnen und Kollegen etablierten kein universelles 10.000-Stunden-Meisterschaftsgesetz. Es gibt keine universelle Stundenzahl, die Meisterschaft garantiert.";
"theory_topic_variance_title" = "Übung zählt, aber sie ist nicht alles";
"theory_topic_variance_summary" = "Eine Metaanalyse von 2014 untersuchte gezielte Praxis in mehreren Feldern. Praxis hing mit Leistung zusammen, aber ihr Beitrag unterschied sich erheblich nach Domäne.";
"theory_topic_variance_takeaway" = "Übung ist etwas, das du beeinflussen kannst. Ergebnisse hängen auch von anderen Faktoren ab, die je nach Tätigkeit unterschiedlich sind.";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick, and Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "Eine Metaanalyse von 2014 untersuchte gezielte Praxis in mehreren Feldern. Praxis hing mit Leistung zusammen, aber ihr Beitrag unterschied sich erheblich nach Domäne.";
"theory_topic_variance_findings_intro" = "Der geschätzte Anteil der Leistungsunterschiede, den gezielte Praxis in dieser Analyse erklärte, war:";
