/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Dieser Bildschirm listet die mit der App gelieferten Fähigkeiten: den ursprünglichen Satz plus Einträge aus dem erarbeiteten Katalog.";
"theory_compendium_intro" = "Jeder Reiter ist eine Stundenmarke, die der Fortschrittsbalken bereits nutzt. Der Kristall ist die Farbe dieser Marke. Der Text erklärt, was die Marke bedeutet — und was nicht.";
"theory_hour_unit" = "Stunden";
"theory_callout_example" = "Beispiel";
"theory_callout_caveat" = "Einschränkung";
"theory_callout_takeaway" = "Fazit";
"theory_chapter_21_title" = "Am Anfang vorbeikommen";
"theory_chapter_21_lead" = "Einundzwanzig Stunden ändern die Farbe des Fortschrittsbalkens. Das ist kein Forschungsergebnis. Die nächstliegende veröffentlichte Methode ist Josh Kaufmans 20-Stunden-Rahmen für den unbeholfenen Start — und diese beiden Zahlen sind nicht dieselbe Behauptung.";
"theory_chapter_21_mechanism_title" = "Eine Methode für den Start";
"theory_chapter_21_mechanism" = "Kaufman behandelt den Anfang als praktisches Problem. Teile die Fähigkeit in kleinere Teile, lerne genug, um eigene Fehler zu bemerken, entferne Hindernisse, die das Üben unbequem machen, und nimm dir konzentrierte Zeit für ein Ergebnis. Das Buch stellt das als Methode des Autors vor, um loszulegen.";
"theory_chapter_21_example" = "Wer möchte, dass drei Akkorde sauber klingen, kann genau dieses Ergebnis üben. „Gitarre lernen“ ist ein größeres Ziel, und die ersten Stunden entscheiden es nicht.";
"theory_chapter_100_title" = "Hundert Stunden als App-Marke";
"theory_chapter_100_lead" = "Hundert Stunden sind ein Time4Skill-Meilenstein für bereits erfasste Zeit. Keine der in diesem Kompendium gesammelten Studien definiert 100 Stunden als den Punkt, an dem jemand kompetent wird.";
"theory_chapter_100_mechanism_title" = "Was nahe Forschung tatsächlich gemessen hat";
"theory_chapter_100_mechanism" = "Zwei Forschungsstränge liegen nahe an diesem Zeitraum, ohne ihn in Stunden zu messen. Cepeda, Pashler, Vul, Wixted und Rohrer werteten 317 Experimente zum verbalen Erinnern aus. Verteilte Sitzungen schlugen dort das Pauken, und der nützliche Abstand hing davon ab, wie lange das Material behalten werden sollte. Lally, van Jaarsveld, Potts und Wardle ließen Freiwillige ein Ess-, Trink- oder Aktivitätsverhalten im gleichen Kontext wiederholen. Die modellierte Zeit bis 95 Prozent des eigenen Plateaus jeder Person schwankte stark. Ein verpasster Tag löschte die Kurve nicht.";
"theory_chapter_100_example" = "Ein kurzes Stück an drei verschiedenen Tagen zu spielen zeigt, welcher Takt wirklich im Gedächtnis blieb. Ein langer Abend Wiederholung beantwortet diese Frage nicht.";
"theory_chapter_100_caveat" = "Der Überblick zur Verteilung betrifft verbales Erinnern. Die Gewohnheitsstudie betrifft die Automatizität eines gewählten Verhaltens; die Spanne im mit dem Artikel berichteten Modell lag bei 18 bis 254 Tagen — nicht bei einer Kompetenzlinie nach 100 Stunden. Keines der Ergebnisse sagt, dass 100 Stunden jemanden in Fotografie, Autofahren oder einer anderen Fähigkeit kompetent machen.";
"theory_chapter_100_takeaway" = "Nutze die Marke, um zu merken, ob du zurückkommst. Behandle sie nicht als verdienten Level.";
"theory_chapter_1000_title" = "Übung auf eine Lücke gerichtet";
"theory_chapter_1000_lead" = "Der 1000-Stunden-Kristall erfasst verbrachte Zeit. Er bedeutet nicht, dass die Person jetzt Profi, Lehrkraft oder jemand ist, der von der Fähigkeit leben kann.";
"theory_chapter_1000_mechanism_title" = "Gezielte Praxis und wie viel sie erklärte";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe und Tesch-Römer beschrieben gezielte Praxis als Tätigkeit, die einen bestimmten Aspekt verbessern soll — mit Rückmeldung und Korrektur statt bloßem Wiederholen des bereits Vertrauten. Ihr Artikel von 1993 entwickelte diesen Rahmen anhand von Studien mit Musikerinnen und Musikern. Er veröffentlichte keine Stundenanzahl, die in jedem Feld Expertinnen und Experten erzeugt. Macnamara, Hambrick und Oswald schätzten später, wie viel der Leistungsunterschiede mit gezielter Praxis zusammenhing. Die Anteile unterschieden sich nach Domäne: höher in Spielen, Musik und Sport als in Bildung und Berufen.";
"theory_chapter_1000_example" = "Eine Stunde an der Passage, die immer wieder bricht, ist eine andere Tätigkeit als eine Stunde Stücke, die schon gut laufen. Der Fortschrittsbalken erfasst die Zeit in beiden Fällen.";
"theory_chapter_1000_caveat" = "Die Domänenprozentwerte sind Anteile der Varianz in jener Metaanalyse von 2014. Sie sind nicht der Anteil einer Fähigkeit, den man lernen kann, und nicht jemandes Erfolgschance. Der Artikel setzt 1000 Stunden nicht als Berufsschwelle. Ältere Formulierungen in der App, die 1000 Stunden als den Moment zum Profi behandelten, überzogen die Evidenz.";
"theory_chapter_10000_title" = "Eine berühmte Zahl, kein Gesetz";
"theory_chapter_10000_lead" = "Zehntausend Stunden wurden als Meisterschaftsregel berühmt. Die Forschung, aus der sie gezogen wurde, etablierte kein Gesetz, und der Kristall auf diesem Reiter kennzeichnet nur die höchste angezeigte Stundenmarke der App.";
"theory_chapter_10000_mechanism_title" = "Wie die Zahl wanderte";
"theory_chapter_10000_mechanism" = "Malcolm Gladwells Outliers (2008) machte die runde Zahl weithin bekannt. Sie stützte sich auf Forschung zu Expertenleistung, darunter den Artikel von Ericsson, Krampe und Tesch-Römer von 1993 zur gezielten Praxis bei Musikerinnen und Musikern. Macnamara und Maitra (2019) erörtern, wie sich diese populäre Regel von der Forschung unterscheidet. Die populäre Fassung verdichtete ein komplexes Argument zu einer Schwelle, die Meisterschaft garantieren sollte.";
"theory_chapter_10000_example" = "Zwei Personen können dieselbe Summe erfassen und die Zeit dennoch anders verbracht haben. Die eine hatte vielleicht eine Lehrkraft, die einen konkreten Fehler korrigierte. Die andere wiederholte vielleicht ein Stück, das sie schon spielt. Die Stundensumme speichert diesen Unterschied nicht.";
