"theory_topic_spacing_title" = "한꺼번에 몰아넣기보다 기술로 돌아오기";
"theory_topic_spacing_summary" = "분산 연습 연구는 집중 연습에만 의존하기보다 여러 세션에 학습을 나누는 것을 지지합니다. 최적 간격은 자료와 얼마나 오래 유지하고 싶은지에 달립니다.";
"theory_topic_spacing_takeaway" = "며칠에 걸쳐 기술로 돌아와 무엇을 기억하고 더 연습이 필요한지 관찰해 보세요.";
"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "메타분석은 184개 논문의 317개 실험을 검토했으며 분산 연습 평가 839건을 포함했습니다.";
"theory_topic_spacing_limitation" = "이 결과는 학습과 회상 과제에 관한 것입니다. 모든 신체·사회·예술·직업 기술에 최적인 하나의 일정은 제시하지 않습니다.";
"theory_topic_habit_title" = "습관에는 보편적 기한이 없다";
"theory_topic_habit_summary" = "같은 맥락에서 행동을 반복하면 시간이 지나며 더 자동적일 수 있습니다. 다만 필요한 시간은 사람과 행동마다 다릅니다. 하루를 놓친다고 모든 진전이 사라진 것은 아닙니다.";
"theory_topic_habit_takeaway" = "정기적으로 만나는 상황에 활동을 연결하고, 세션을 놓쳐도 죄책감 없이 다시 시작하세요.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "96명의 자원봉사자가 같은 맥락에서 12주 동안 반복할 먹기·마시기·활동 행동을 골랐습니다. 82명이 충분한 데이터를 제공했습니다. 점근 자동화 추정의 95%에 도달하는 모델 시간은 18~254일이었습니다.";
"theory_topic_habit_limitation" = "이는 습관 형성 연구이지, 숙달에 몇 시간이 걸리는지에 대한 연구가 아닙니다. 21시간 숙달 임계값이나 보편적 21일 습관 규칙을 지지하지 않습니다.";
"theory_milestones_title" = "진행 이정표";
"theory_milestones_note" = "The 100-hour, 1,000-hour, and 10,000-hour marks in Time4Skill record time you have spent. They are progress milestones, not scientifically validated stages, and they do not predict when you will become an expert.";
