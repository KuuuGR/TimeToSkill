"theory_topic_first20_summary" = "Bắt đầu một kỹ năng thường gây nản vì mọi thứ đều lạ. Josh Kaufman đề xuất cách thực tế: chia kỹ năng, tập trung vào điều quan trọng, bỏ rào cản luyện tập, và dành thời gian tập trung để cải thiện. Khung 20 giờ của ông là phương pháp khởi đầu, không phải bảo đảm khoa học rằng mọi kỹ năng đều thành thạo trong 20 giờ.";
"theory_topic_first20_takeaway" = "Chọn một việc cụ thể bạn muốn làm tốt hơn sau 20 giờ đầu.";
"theory_topic_first20_citation" = "Josh Kaufman. The First 20 Hours: How to Learn Anything… Fast! Ebook published in 2013; paperback published in 2014.";
"theory_topic_first20_context" = "Khung thực tiễn và sách của tác giả, không phải nghiên cứu khoa học có đối chứng.";
"theory_topic_first20_limitation" = "Khung 20 giờ là phương pháp khởi đầu. Không phải thời gian được khoa học xác lập để thành thạo.";
"theory_topic_deliberate_title" = "Luyện tập có mục đích";
"theory_topic_deliberate_summary" = "Lặp lại một hoạt động không giống cải thiện có chủ đích. Chọn một khía cạnh cụ thể, luyện với mục tiêu rõ, nhận ra lỗi và điều chỉnh lần thử sau. Theo dõi thời gian hữu ích, nhưng cách luyện cũng quan trọng.";
"theory_topic_deliberate_takeaway" = "Trước một phiên, quyết định một việc bạn muốn cải thiện.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "Bài báo phát triển khung hiệu suất chuyên gia và báo cáo nghiên cứu với nhạc sĩ, gồm nghệ sĩ violin và piano.";
"theory_topic_deliberate_limitation" = "Bài báo không thiết lập một số giờ luyện cố định bảo đảm thành thạo mọi kỹ năng.";
"theory_topic_10k_title" = "10.000 giờ: quy tắc phổ biến, không phải quy luật";
"theory_topic_10k_summary" = "Quy tắc 10.000 giờ trở nên phổ biến rộng qua Outliers (2008) của Malcolm Gladwell. Nó dựa trên nghiên cứu hiệu suất chuyên gia, nhưng phiên bản phổ biến đã đơn giản hóa lập luận gốc. Không có số giờ thần kỳ phổ quát bảo đảm thành thạo.";
"theory_topic_10k_takeaway" = "Dùng cột mốc dài hạn để ăn mừng sự kiên trì, không phải để dự đoán khi nào bạn trở thành chuyên gia.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "Quy tắc 10.000 giờ trở nên phổ biến rộng qua Outliers (2008) của Malcolm Gladwell. Bài 2019 bàn quy tắc phổ biến đó khác nghiên cứu 1993 ra sao.";
"theory_topic_10k_limitation" = "Ericsson và đồng nghiệp không thiết lập quy luật thành thạo phổ quát 10.000 giờ. Không có số giờ phổ quát bảo đảm thành thạo.";
"theory_topic_variance_title" = "Luyện tập quan trọng, nhưng không phải tất cả";
"theory_topic_variance_summary" = "Một meta-phân tích năm 2014 xem xét luyện tập có chủ đích ở nhiều lĩnh vực. Luyện tập liên quan đến hiệu suất, nhưng đóng góp khác nhau rõ rệt theo lĩnh vực.";
"theory_topic_variance_takeaway" = "Luyện tập là điều bạn có thể ảnh hưởng. Kết quả cũng phụ thuộc yếu tố khác, khác nhau giữa các hoạt động.";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick, and Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "Một meta-phân tích năm 2014 xem xét luyện tập có chủ đích ở nhiều lĩnh vực. Luyện tập liên quan đến hiệu suất, nhưng đóng góp khác nhau rõ rệt theo lĩnh vực.";
"theory_topic_variance_findings_intro" = "Tỷ phần ước lượng của khác biệt hiệu suất được giải thích bởi luyện tập có chủ đích trong phân tích này là:";
"theory_topic_variance_limitation" = "Các phần trăm này đề cập phương sai hiệu suất được giải thích trong meta-phân tích này. Không phải phần trăm kỹ năng một người có thể học, cũng không phải xác suất thành công cá nhân.";
