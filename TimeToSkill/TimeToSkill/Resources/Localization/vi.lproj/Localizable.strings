"theory_topic_spacing_title" = "Quay lại kỹ năng thay vì nhồi tất cả một lúc";
"theory_topic_spacing_summary" = "Nghiên cứu về luyện tập phân tán ủng hộ trải việc học qua nhiều phiên thay vì chỉ dựa vào luyện tập dồn. Khoảng tốt nhất phụ thuộc vật liệu và bạn muốn giữ bao lâu.";
"theory_topic_spacing_takeaway" = "Hãy thử quay lại một kỹ năng trong vài ngày và quan sát bạn nhớ gì cũng như điều cần luyện thêm.";
"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "Meta-phân tích xem xét 317 thí nghiệm trong 184 bài báo, với 839 đánh giá luyện tập phân tán.";
"theory_topic_spacing_limitation" = "Các kết quả này liên quan nhiệm vụ học và nhớ lại. Chúng không đưa một lịch tối ưu cho mọi kỹ năng thể chất, xã hội, nghệ thuật hay nghề nghiệp.";
"theory_topic_habit_title" = "Thói quen không có hạn chót phổ quát";
"theory_topic_habit_summary" = "Lặp một hành động trong ngữ cảnh nhất quán có thể làm nó tự động hơn theo thời gian. Tuy nhiên thời gian cần thiết khác nhau giữa người và hành vi. Bỏ lỡ một ngày không nghĩa là mọi tiến bộ đã mất.";
"theory_topic_habit_takeaway" = "Gắn một hoạt động với tình huống bạn gặp thường xuyên, và tiếp tục không tội lỗi khi bỏ một phiên.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "Chín mươi sáu tình nguyện viên chọn hành vi ăn, uống hoặc hoạt động để lặp trong cùng ngữ cảnh trong 12 tuần. Tám mươi hai người tham gia cung cấp đủ dữ liệu. Thời gian mô hình để đạt 95% ước lượng tự động tiệm cận dao động từ 18 đến 254 ngày.";
"theory_topic_habit_limitation" = "Đây là nghiên cứu hình thành thói quen, không phải nghiên cứu cần bao nhiêu giờ để thành thạo kỹ năng. Nó không ủng hộ ngưỡng thành thạo 21 giờ hay quy tắc thói quen phổ quát 21 ngày.";
"theory_milestones_title" = "Mốc tiến độ";
"theory_milestones_note" = "The 100-hour, 1,000-hour, and 10,000-hour marks in Time4Skill record time you have spent. They are progress milestones, not scientifically validated stages, and they do not predict when you will become an expert.";
