/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Esta pantalla lista las habilidades incluidas con la aplicación: el conjunto original más las entradas aceptadas de la colección desarrollada. Los archivos de propuestas piloto no son, por sí solos, el catálogo.";
"theory_compendium_intro" = "Mỗi tab là một mốc giờ mà thanh tiến độ đã dùng. Tinh thể là màu của mốc đó. Văn bản giải thích mốc nghĩa là gì — và không nghĩa là gì.";
"theory_hour_unit" = "giờ";
"theory_callout_example" = "Ví dụ";
"theory_callout_caveat" = "Lưu ý";
"theory_callout_takeaway" = "Điểm chính";
"theory_chapter_21_title" = "Vượt qua giai đoạn đầu";
"theory_chapter_21_lead" = "Hai mươi mốt giờ đổi màu thanh tiến độ. Đó không phải phát hiện nghiên cứu. Phương pháp công bố gần nhất là khung 20 giờ của Josh Kaufman để vượt qua khởi đầu vụng về, và hai con số đó không phải cùng một khẳng định.";
"theory_chapter_21_mechanism_title" = "Một phương pháp để bắt đầu";
"theory_chapter_21_mechanism" = "Kaufman coi khởi đầu là vấn đề thực tiễn. Chia kỹ năng thành phần nhỏ hơn, học đủ để nhận ra lỗi của mình, bỏ rào cản làm việc luyện bất tiện, và dành thời gian tập trung cho một kết quả. Sách trình bày đó như phương pháp của tác giả để bắt đầu.";
"theory_chapter_21_example" = "Người muốn ba hợp âm nghe sạch có thể luyện đúng kết quả đó. \"Học guitar\" là mục tiêu lớn hơn, và những giờ đầu không quyết định nó.";
"theory_chapter_100_title" = "Một trăm giờ như mốc của ứng dụng";
"theory_chapter_100_lead" = "Một trăm giờ là cột mốc Time4Skill cho thời gian đã ghi. Không nghiên cứu nào trong tập này định nghĩa 100 giờ là lúc ai đó trở nên thành thạo.";
"theory_chapter_100_mechanism_title" = "Nghiên cứu gần đó thực sự đo gì";
"theory_chapter_100_mechanism" = "Hai dòng công việc nằm gần giai đoạn này mà không đo bằng giờ. Cepeda, Pashler, Vul, Wixted và Rohrer xem xét 317 thí nghiệm về nhớ lại lời nói. Phân tán phiên thắng nhồi nhét trong tài liệu đó, và khoảng hữu ích phụ thuộc vào việc cần nhớ vật liệu bao lâu. Lally, van Jaarsveld, Potts và Wardle nhờ tình nguyện viên lặp hành vi ăn, uống hoặc hoạt động trong cùng ngữ cảnh. Thời gian mô hình để đạt 95 phần trăm cao nguyên của mỗi người khác nhau rất nhiều. Bỏ lỡ một ngày không xóa đường cong.";
"theory_chapter_100_example" = "Chơi một đoạn ngắn trong ba ngày khác nhau cho thấy nhịp nào thật sự còn trong trí nhớ. Một buổi tối dài lặp lại không trả lời câu hỏi đó.";
"theory_chapter_100_caveat" = "Tổng quan về khoảng cách liên quan đến nhớ lại lời nói. Nghiên cứu thói quen liên quan đến tính tự động của hành vi đã chọn, và phạm vi trong mô hình kèm bài báo là 18 đến 254 ngày, không phải đường thành thạo ở 100 giờ. Không kết quả nào nói 100 giờ khiến ai đó thành thạo nhiếp ảnh, lái xe hay kỹ năng khác.";
"theory_chapter_100_takeaway" = "Dùng mốc để nhận ra bạn có quay lại hay không. Đừng coi đó là cấp độ đã kiếm được.";
"theory_chapter_1000_title" = "Luyện tập nhắm vào một khoảng trống";
"theory_chapter_1000_lead" = "Tinh thể 1.000 giờ ghi thời gian đã dành. Nó không nghĩa là người đó giờ là chuyên gia, giáo viên, hoặc ai có thể sống bằng kỹ năng.";
"theory_chapter_1000_mechanism_title" = "Luyện tập có chủ đích, và nó giải thích bao nhiêu";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe và Tesch-Römer mô tả luyện tập có chủ đích là hoạt động được sắp để cải thiện một khía cạnh cụ thể, có phản hồi và chỉnh sửa, thay vì chỉ lặp lại điều đã thoải mái. Bài 1993 của họ phát triển khung đó với nghiên cứu nhạc sĩ. Họ không công bố số giờ tạo chuyên gia ở mọi lĩnh vực. Macnamara, Hambrick và Oswald sau đó ước lượng bao nhiêu khác biệt hiệu suất liên quan đến luyện tập có chủ đích. Tỷ phần khác theo lĩnh vực: cao hơn ở trò chơi, âm nhạc và thể thao so với giáo dục và nghề nghiệp.";
"theory_chapter_1000_example" = "Một giờ cho đoạn vẫn còn vỡ khác với một giờ chơi những bản đã ổn. Thanh tiến độ ghi thời gian ở cả hai trường hợp.";
"theory_chapter_1000_caveat" = "Phần trăm theo lĩnh vực là tỷ phần phương sai trong meta-phân tích 2014. Chúng không phải phần kỹ năng có thể học, cũng không phải cơ hội thành công của ai đó. Bài báo không đặt 1.000 giờ làm ngưỡng nghề nghiệp. Cách diễn đạt cũ trong ứng dụng coi 1.000 giờ là lúc trở thành chuyên gia đã phóng đại bằng chứng.";
"theory_chapter_10000_title" = "Một con số nổi tiếng, không phải quy luật";
"theory_chapter_10000_lead" = "Mười nghìn giờ trở nên nổi tiếng như quy tắc thành thạo. Nghiên cứu nó dựa vào không thiết lập quy luật, và tinh thể trên tab này chỉ đánh dấu mốc giờ cao nhất mà ứng dụng hiển thị.";
"theory_chapter_10000_mechanism_title" = "Con số đã lan truyền thế nào";
"theory_chapter_10000_mechanism" = "Outliers (2008) của Malcolm Gladwell làm con số tròn được biết rộng. Nó dựa trên nghiên cứu hiệu suất chuyên gia, gồm bài 1993 của Ericsson, Krampe và Tesch-Römer về luyện tập có chủ đích ở nhạc sĩ. Macnamara và Maitra (2019) bàn quy tắc phổ biến đó khác nghiên cứu ra sao. Phiên bản phổ biến nén lập luận phức tạp thành một ngưỡng được cho là bảo đảm thành thạo.";
"theory_chapter_10000_example" = "Hai người có thể ghi cùng tổng mà vẫn dùng thời gian khác nhau. Một người có thể có giáo viên sửa một lỗi cụ thể. Người kia có thể lặp lại bản đã chơi được. Tổng giờ không ghi khác biệt đó.";
