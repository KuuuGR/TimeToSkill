"theory_topic_spacing_title" = "Térjen vissza a készséghez ahelyett, hogy mindent egyszerre magolna";
"theory_topic_spacing_summary" = "Az elosztott gyakorlat kutatása támogatja a tanulás több ülésre terjesztését ahelyett, hogy csak tömeges gyakorlatra támaszkodna. A legjobb távolság az anyagtól és attól függ, meddig akarja megtartani.";
"theory_topic_spacing_takeaway" = "Próbáljon több napon át visszatérni egy készséghez, és figyelje meg, mit emlékszik, és mi igényel több gyakorlatot.";
"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "A metaanalízis 184 cikk 317 kísérletét tekintette át, 839 elosztott gyakorlat-értékeléssel.";
"theory_topic_spacing_limitation" = "Ezek az eredmények tanulási és felidézési feladatokra vonatkoznak. Nem adnak egyetlen optimális ütemtervet minden fizikai, társadalmi, művészi vagy szakmai készséghez.";
"theory_topic_habit_title" = "A szokásnak nincs univerzális határideje";
"theory_topic_habit_summary" = "Egy cselekvés ismétlése ugyanabban a kontextusban idővel automatikusabbá teheti. A szükséges idő azonban személyenként és viselkedésenként különbözik. Egy nap kihagyása nem azt jelenti, hogy minden előrehaladás elveszett.";
"theory_topic_habit_takeaway" = "Kapcsoljon egy tevékenységet olyan helyzethez, amellyel rendszeresen találkozik, és folytassa bűntudat nélkül, ha egy ülés kimarad.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "Kilencvenhat önkéntes választott étkezési, ivási vagy aktivitási viselkedést, amelyet ugyanabban a kontextusban 12 héten át ismételtek. Nyolcvankét résztvevő adott elegendő adatot. Az aszimptotikus automatizáltság-becslés 95%-ához modellezett idő 18 és 254 nap között változott.";
"theory_topic_habit_limitation" = "Ez szokásképzési vizsgálat volt, nem arról, hány óra kell egy készség elsajátításához. Nem támogat 21 órás mesterségküszöböt, sem univerzális 21 napos szokásszabályt.";
"theory_milestones_title" = "Haladási mérföldkövek";
"theory_milestones_note" = "The 100-hour, 1,000-hour, and 10,000-hour marks in Time4Skill record time you have spent. They are progress milestones, not scientifically validated stages, and they do not predict when you will become an expert.";
