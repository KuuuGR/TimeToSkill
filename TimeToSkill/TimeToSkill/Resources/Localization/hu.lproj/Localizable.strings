/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Dieser Bildschirm listet die mit der App gelieferten Fähigkeiten: den ursprünglichen Satz plus Einträge aus dem erarbeiteten Katalog.";
"theory_compendium_intro" = "Minden lap egy órajegy, amelyet a haladásjelző már használ. A kristály ennek a jegynek a színe. A szöveg megmagyarázza, mit jelent a jegy — és mit nem.";
"theory_hour_unit" = "óra";
"theory_callout_example" = "Példa";
"theory_callout_caveat" = "Megjegyzés";
"theory_callout_takeaway" = "Tanulság";
"theory_chapter_21_title" = "Túljutni a kezdeten";
"theory_chapter_21_lead" = "Huszonegy óra megváltoztatja a haladásjelző színét. Ez nem kutatási eredmény. A legközelebbi közölt módszer Josh Kaufman 20 órás kerete a kényelmetlen kezdet átvészelésére, és ez a két szám nem ugyanaz az állítás.";
"theory_chapter_21_mechanism_title" = "Módszer a kezdéshez";
"theory_chapter_21_mechanism" = "Kaufman a kezdetet gyakorlati problémaként kezeli. Ossza a készséget kisebb részekre, tanuljon eleget, hogy észrevegye saját hibáit, távolítsa el a gyakorlást nehezítő akadályokat, és szánjon koncentrált időt egy eredményre. A könyv ezt a szerző kezdési módszereként mutatja be.";
"theory_chapter_21_example" = "Aki azt szeretné, hogy három akkord tisztán szóljon, pontosan azt az eredményt gyakorolhatja. A „gitártanulni” nagyobb cél, és az első órák nem döntik el.";
"theory_chapter_100_title" = "Száz óra mint alkalmazásjegy";
"theory_chapter_100_lead" = "Száz óra a Time4Skill mérföldköve a már rögzített időhöz. A kompendium egyik tanulmánya sem határozza meg a 100 órát úgy, mint amikor valaki kompetenssé válik.";
"theory_chapter_100_mechanism_title" = "Mit mért valójában a közeli kutatás";
"theory_chapter_100_mechanism" = "Két kutatási vonal közel van ehhez az időszakhoz anélkül, hogy órákban mérné. Cepeda, Pashler, Vul, Wixted és Rohrer 317 verbális felidézési kísérletet tekintett át. Az elosztott ülések abban az irodalomban legyőzték a magolást, és a hasznos távolság attól függött, meddig kell emlékezni az anyagra. Lally, van Jaarsveld, Potts és Wardle önkénteseket kért, hogy étkezési, ivási vagy aktivitási viselkedést ismételjenek ugyanabban a kontextusban. Az egyes személyek saját platójának 95 százalékához modellezett idő erősen változott. Egy nap kihagyása nem törölte a görbét.";
"theory_chapter_100_example" = "Egy rövid darab három különböző napon való eljátszása megmutatja, melyik ütem maradt ténylegesen az emlékezetben. Egy hosszú ismétlő este nem válaszolja meg ezt a kérdést.";
"theory_chapter_100_caveat" = "A távolság áttekintése a verbális felidézésről szól. A szokáskutatás a választott viselkedés automatizálódásáról, és a cikkel közölt modell tartománya 18–254 nap volt — nem 100 órás kompetenciavonal. Semmilyen eredmény nem mondja, hogy 100 óra kompetensé tesz valakit fényképezésben, vezetésben vagy más készségben.";
"theory_chapter_100_takeaway" = "Használja a jegyet annak észrevételére, hogy visszatér-e. Ne kezelje megszerzett szintként.";
"theory_chapter_1000_title" = "Egy résre irányuló gyakorlat";
"theory_chapter_1000_lead" = "Az 1000 órás kristály a ráfordított időt rögzíti. Nem azt jelenti, hogy a személy most már szakember, tanár, vagy valaki, aki a készségből megélhet.";
"theory_chapter_1000_mechanism_title" = "Szándékos gyakorlat, és mennyit magyarázott";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe és Tesch-Römer a szándékos gyakorlatot olyan tevékenységként írta le, amely egy konkrét szempont javítására van rendezve, visszajelzéssel és javítással, ahelyett hogy csak az már kényelmeset ismételné. 1993-as cikkük zenészek tanulmányaival fejlesztette a keretet. Nem közölt olyan óraszámot, amely minden területen szakértőket teremt. Macnamara, Hambrick és Oswald később becsülte, a teljesítménykülönbségek mekkora része kapcsolódott a szándékos gyakorlathoz. Az arányok területenként különböztek: magasabbak játékokban, zenében és sportban, mint oktatásban és szakmákban.";
"theory_chapter_1000_example" = "Egy óra a még mindig széteső szakaszon más tevékenység, mint egy óra már jól menő darabokkal. A haladásjelző mindkét esetben rögzíti az időt.";
"theory_chapter_1000_caveat" = "A területenkénti százalékok a 2014-es metaanalízis varianciahányadai. Nem a megtanulható készség része, és nem bárki sikerének esélye. A cikk nem állít 1000 órás szakmai küszöböt. Az alkalmazás korábbi szövege, amely a 1000 órát a szakemberré válás pontjaként kezelte, túlértékelte a bizonyítékot.";
"theory_chapter_10000_title" = "Híres szám, nem törvény";
"theory_chapter_10000_lead" = "Tízezer óra mesterségszabályként vált híressé. A kutatás, amelyből származott, nem állított fel törvényt, és ezen a lapon a kristály csak az alkalmazás legmagasabb megjelenített órajejét jelöli.";
"theory_chapter_10000_mechanism_title" = "Hogyan utazott a szám";
"theory_chapter_10000_mechanism" = "Malcolm Gladwell Outliers (2008) című könyve tette széles körben ismertté a kerek számot. Szakértői teljesítménykutatásra támaszkodott, köztük Ericsson, Krampe és Tesch-Römer 1993-as cikkére a zenészek szándékos gyakorlatáról. Macnamara és Maitra (2019) tárgyalja, miben tér el ez a népszerű szabály a kutatástól. A népszerű változat összetett érvet egy mesterséget garantáló küszöbbé sűrített.";
"theory_chapter_10000_example" = "Két ember rögzítheti ugyanazt az összeget, és mégis másképp töltheti az időt. Az egyiknek lehetett tanára, aki konkrét hibát javított. A másik már játszott darabot ismételhetett. Az órák összege nem rögzíti ezt a különbséget.";
