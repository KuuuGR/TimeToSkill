"theory_topic_first20_limitation" = "A 20 órás keret kezdési módszer. Nem tudományosan megállapított idő a mesterséghez.";
"theory_topic_deliberate_title" = "Célzott gyakorlás";
"theory_topic_deliberate_summary" = "Egy tevékenység ismétlése nem ugyanaz, mint szándékosan javítani. Válasszon konkrét szempontot, gyakoroljon világos céllal, vegye észre a hibákat, és igazítsa a következő próbát. Az idő követése hasznos, de a gyakorlás módja is számít.";
"theory_topic_deliberate_takeaway" = "Egy ülés előtt döntse el, mit az egyetlen dolog, amit javítani akar.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "A cikk szakértői teljesítménykeretet fejlesztett, és hegedűsökkel valamint zongoristákkal végzett tanulmányokról számolt be.";
"theory_topic_deliberate_limitation" = "A cikk nem állapít meg egyetlen rögzített gyakorlóóraszámot, amely minden készségben garantálja a mesterséget.";
"theory_topic_10k_title" = "10 000 óra: népszerű szabály, nem törvény";
"theory_topic_10k_summary" = "A 10 000 órás szabály Malcolm Gladwell Outliers (2008) című könyve révén vált széles körben népszerűvé. Szakértői teljesítménykutatásra támaszkodott, de a népszerű változat leegyszerűsítette az eredeti érvet. Nincs univerzális mágikus óraszám, amely mesterséget garantál.";
"theory_topic_10k_takeaway" = "Használjon hosszú távú mérföldköveket a kitartás ünneplésére, ne arra, hogy megjósolja, mikor lesz szakértő.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "A 10 000 órás szabály Malcolm Gladwell Outliers (2008) című könyve révén vált széles körben népszerűvé. A 2019-es cikk tárgyalja, miben tér el ez a népszerű szabály az 1993-as kutatástól.";
"theory_topic_10k_limitation" = "Ericsson és kollégái nem állítottak fel univerzális 10 000 órás mesterségtörvényt. Nincs univerzális óraszám, amely mesterséget garantál.";
"theory_topic_variance_title" = "A gyakorlat számít, de nem minden";
"theory_topic_variance_summary" = "Egy 2014-es metaanalízis több területen vizsgálta a szándékos gyakorlatot. A gyakorlat összefüggött a teljesítménnyel, de hozzájárulása területenként jelentősen különbözött.";
"theory_topic_variance_takeaway" = "A gyakorlat olyasmi, amire hatással lehet. Az eredmények más tényezőktől is függenek, amelyek tevékenységenként különböznek.";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick, and Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "Egy 2014-es metaanalízis több területen vizsgálta a szándékos gyakorlatot. A gyakorlat összefüggött a teljesítménnyel, de hozzájárulása területenként jelentősen különbözött.";
"theory_topic_variance_findings_intro" = "A teljesítménykülönbségek becsült hányada, amelyet a szándékos gyakorlat ebben az elemzésben magyarázott:";
"theory_topic_variance_limitation" = "Ezek a százalékok az ebben a metaanalízisben magyarázott teljesítményvarianciára vonatkoznak. Nem annak a készségnek a százaléka, amelyet valaki megtanulhat, és nem egyéni siker valószínűsége.";
