"theory_topic_first20_title" = "Les 20 premières heures : passer le début";
"theory_topic_first20_summary" = "Commencer une compétence est souvent frustrant parce que tout est inconnu. Josh Kaufman propose une approche pratique : découper la compétence, se concentrer sur l'essentiel, retirer les obstacles à la pratique et consacrer du temps concentré à s'améliorer. Son cadre de 20 heures est une méthode de démarrage, pas une garantie scientifique qu'on maîtrise une compétence en 20 heures.";
"theory_topic_first20_takeaway" = "Choisissez une chose précise que vous voulez mieux faire après vos 20 premières heures.";
"theory_topic_first20_citation" = "Josh Kaufman. The First 20 Hours: How to Learn Anything… Fast! Ebook published in 2013; paperback published in 2014.";
"theory_topic_first20_context" = "Cadre pratique et livre de l'auteur, pas une étude scientifique contrôlée.";
"theory_topic_first20_limitation" = "Le cadre de 20 heures est une méthode de démarrage. Ce n'est pas un temps scientifiquement établi pour maîtriser une compétence.";
"theory_topic_deliberate_title" = "Pratiquer avec un but";
"theory_topic_deliberate_summary" = "Répéter une activité n'est pas la même chose que l'améliorer délibérément. Choisissez un aspect précis, pratiquez avec un objectif clair, remarquez les erreurs et ajustez la tentative suivante. Suivre le temps est utile, mais la façon de pratiquer compte aussi.";
"theory_topic_deliberate_takeaway" = "Avant une séance, décidez d'une seule chose que vous voulez améliorer.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "L'article a développé un cadre pour la performance d'expert et rapporté des études auprès de musiciens, dont des violonistes et des pianistes.";
"theory_topic_deliberate_limitation" = "L'article n'établit pas un nombre fixe d'heures de pratique qui garantit la maîtrise pour toutes les compétences.";
"theory_topic_10k_title" = "10 000 heures : une règle populaire, pas une loi";
"theory_topic_10k_summary" = "La règle des 10 000 heures est devenue largement populaire via Outliers (2008) de Malcolm Gladwell. Elle s'appuyait sur la recherche sur la performance d'expert, mais la version populaire a simplifié l'argument d'origine. Il n'existe pas de nombre magique universel d'heures qui garantit la maîtrise.";
"theory_topic_10k_takeaway" = "Servez-vous des jalons à long terme pour célébrer la persévérance, pas pour prédire quand vous deviendrez expert.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "La règle des 10 000 heures est devenue largement populaire via Outliers (2008) de Malcolm Gladwell. L'article de 2019 discute en quoi cette règle populaire diffère de la recherche de 1993.";
"theory_topic_10k_limitation" = "Ericsson et ses collègues n'ont pas établi une loi universelle de maîtrise à 10 000 heures. Il n'existe pas de nombre universel d'heures qui garantit la maîtrise.";
"theory_topic_variance_title" = "La pratique compte, mais ce n'est pas tout";
"theory_topic_variance_summary" = "Une méta-analyse de 2014 a examiné la pratique délibérée dans plusieurs domaines. La pratique était associée à la performance, mais sa contribution différait fortement selon le domaine.";
"theory_topic_variance_takeaway" = "La pratique est quelque chose que vous pouvez influencer. Les résultats dépendent aussi d'autres facteurs, qui diffèrent selon les activités.";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick, and Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "Une méta-analyse de 2014 a examiné la pratique délibérée dans plusieurs domaines. La pratique était associée à la performance, mais sa contribution différait fortement selon le domaine.";
"theory_topic_variance_findings_intro" = "La part estimée des différences de performance expliquée par la pratique délibérée dans cette analyse était :";
