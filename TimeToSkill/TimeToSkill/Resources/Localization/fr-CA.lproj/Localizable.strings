/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Cet écran liste les compétences livrées avec l’app : l’ensemble d’origine plus les entrées du catalogue élaboré.";
"theory_compendium_intro" = "Chaque onglet est un seuil d'heures déjà utilisé par la barre de progression. Le cristal est la couleur de ce seuil. Le texte explique ce que le seuil signifie — et ce qu'il ne signifie pas.";
"theory_hour_unit" = "heures";
"theory_callout_example" = "Exemple";
"theory_callout_caveat" = "Réserve";
"theory_callout_takeaway" = "À retenir";
"theory_chapter_21_title" = "Passer le début";
"theory_chapter_21_lead" = "Vingt et une heures changent la couleur de la barre de progression. Ce n'est pas un résultat de recherche. La méthode publiée la plus proche est le cadre de 20 heures de Josh Kaufman pour survivre au début maladroit, et ces deux chiffres ne sont pas la même affirmation.";
"theory_chapter_21_mechanism_title" = "Une méthode pour démarrer";
"theory_chapter_21_mechanism" = "Kaufman traite le début comme un problème pratique. Découpez la compétence en parties plus petites, apprenez assez pour remarquer vos propres erreurs, retirez les obstacles qui rendent la pratique incommode, et consacrez du temps concentré à un résultat. Le livre présente cela comme une méthode d'auteur pour commencer.";
"theory_chapter_21_example" = "Une personne qui veut que trois accords sonnent propres peut pratiquer exactement ce résultat. « Apprendre la guitare » est un but plus large, et les premières heures ne le tranchent pas.";
"theory_chapter_100_title" = "Cent heures, comme marque de l'app";
"theory_chapter_100_lead" = "Cent heures sont un jalon Time4Skill pour le temps déjà enregistré. Aucune des études rassemblées dans ce compendium ne définit 100 heures comme le moment où quelqu'un devient compétent.";
"theory_chapter_100_mechanism_title" = "Ce que la recherche proche a réellement mesuré";
"theory_chapter_100_mechanism" = "Deux lignes de travail se situent près de cette période sans la mesurer en heures. Cepeda, Pashler, Vul, Wixted et Rohrer ont passé en revue 317 expériences sur le rappel verbal. Espacer les séances battait le bachotage dans cette littérature, et l'écart utile dépendait de la durée pendant laquelle le matériel devait être retenu. Lally, van Jaarsveld, Potts et Wardle ont demandé à des volontaires de répéter un comportement alimentaire, de boisson ou d'activité dans le même contexte. Le temps modélisé pour atteindre 95 pour cent du plateau propre à chaque personne variait fortement. Manquer un jour n'effaçait pas la courbe.";
"theory_chapter_100_example" = "Jouer un court morceau sur trois jours différents montre quelle mesure est vraiment restée en mémoire. Une longue soirée de répétition ne répond pas à cette question.";
"theory_chapter_100_caveat" = "La revue sur l'espacement concerne le rappel verbal. L'étude sur l'habitude concerne l'automaticité d'un comportement choisi, et sa plage était de 18 à 254 jours dans le modèle rapporté avec l'article, pas une ligne de compétence à 100 heures. Aucun résultat ne dit que 100 heures rendent compétent en photographie, en conduite ou dans toute autre compétence.";
"theory_chapter_100_takeaway" = "Servez-vous de la marque pour remarquer si vous revenez. Ne la traitez pas comme un niveau gagné.";
"theory_chapter_1000_title" = "Une pratique visant une lacune";
"theory_chapter_1000_lead" = "Le cristal de 1 000 heures enregistre le temps passé. Il ne signifie pas que la personne est désormais un professionnel, un enseignant, ou quelqu'un qui peut vivre de la compétence.";
"theory_chapter_1000_mechanism_title" = "La pratique délibérée, et ce qu'elle expliquait";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe et Tesch-Römer ont décrit la pratique délibérée comme une activité arrangée pour améliorer un aspect précis, avec retour et correction, plutôt que de simplement répéter ce qui est déjà confortable. Leur article de 1993 a développé ce cadre avec des études de musiciens. Il n'a pas publié un nombre d'heures qui crée des experts dans chaque domaine. Macnamara, Hambrick et Oswald ont ensuite estimé quelle part des différences de performance était associée à la pratique délibérée. Les parts différaient selon le domaine : plus élevées dans les jeux, la musique et le sport que dans l'éducation et les professions.";
"theory_chapter_1000_example" = "Une heure passée sur le passage qui casse encore est une activité différente d'une heure à jouer des pièces qui vont déjà bien. La barre de progression enregistre le temps dans les deux cas.";
"theory_chapter_1000_caveat" = "Les pourcentages par domaine sont des parts de variance dans cette méta-analyse de 2014. Ce ne sont pas la portion d'une compétence qu'une personne peut apprendre, ni la chance de succès de quiconque. L'article ne fixe pas 1 000 heures comme seuil professionnel. Un ancien libellé de l'app qui traitait 1 000 heures comme le moment de devenir professionnel surestimait les preuves.";
"theory_chapter_10000_title" = "Un nombre célèbre, pas une loi";
"theory_chapter_10000_lead" = "Dix mille heures sont devenues célèbres comme règle de maîtrise. La recherche dont elles sont tirées n'a pas établi de loi, et le cristal de cet onglet identifie seulement le seuil d'heures le plus élevé affiché par l'app.";
"theory_chapter_10000_mechanism_title" = "Comment le nombre a voyagé";
"theory_chapter_10000_mechanism" = "Outliers (2008) de Malcolm Gladwell a rendu le nombre rond largement connu. Il s'appuyait sur la recherche sur la performance d'expert, y compris l'article de 1993 d'Ericsson, Krampe et Tesch-Römer sur la pratique délibérée chez les musiciens. Macnamara et Maitra (2019) discutent en quoi cette règle populaire diffère de la recherche. La version populaire a compressé un argument complexe en un seuil qui garantirait la maîtrise.";
"theory_chapter_10000_example" = "Deux personnes peuvent enregistrer le même total et avoir passé le temps autrement. L'une a pu avoir un enseignant corrigeant un défaut précis. L'autre a pu répéter une pièce qu'elle joue déjà. Le total d'heures n'enregistre pas cette différence.";
