"theory_topic_first20_title" = "Les primeres 20 hores: superar el començament";
"theory_topic_first20_summary" = "Començar una habilitat sovint frustra perquè tot és desconegut. Josh Kaufman proposa un enfocament pràctic: dividiu l'habilitat, centreu-vos en el que importa, traieu obstacles a la pràctica i dediqueu temps concentrat a millorar. El seu marc de 20 hores és un mètode d'inici, no una garantia científica que qualsevol habilitat es domini en 20 hores.";
"theory_topic_first20_takeaway" = "Trieu una cosa concreta que vulgueu fer millor després de les primeres 20 hores.";
"theory_topic_first20_citation" = "Josh Kaufman. The First 20 Hours: How to Learn Anything… Fast! Ebook published in 2013; paperback published in 2014.";
"theory_topic_first20_context" = "Marc pràctic i llibre de l'autor, no un estudi científic controlat.";
"theory_topic_first20_limitation" = "El marc de 20 hores és un mètode d'inici. No és un temps científicament establert necessari per a la mestria.";
"theory_topic_deliberate_title" = "Practicar amb un propòsit";
"theory_topic_deliberate_summary" = "Repetir una activitat no és el mateix que millorar-la deliberadament. Trieu un aspecte concret, practiqueu amb un objectiu clar, noteu els errors i ajusteu el següent intent. Fer el seguiment del temps és útil, però també importa la manera de practicar.";
"theory_topic_deliberate_takeaway" = "Abans d'una sessió, decidiu una sola cosa que vulgueu millorar.";
"theory_topic_deliberate_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer. The Role of Deliberate Practice in the Acquisition of Expert Performance. Psychological Review, 1993, 100(3), 363–406.";
"theory_topic_deliberate_context" = "L'article va desenvolupar un marc per al rendiment expert i va informar estudis amb músics, inclosos violinistes i pianistes.";
"theory_topic_deliberate_limitation" = "L'article no estableix un nombre fix d'hores de pràctica que garanteixi la mestria en totes les habilitats.";
"theory_topic_10k_title" = "10.000 hores: una regla popular, no una llei";
"theory_topic_10k_summary" = "La regla de les 10.000 hores es va fer àmpliament popular mitjançant Outliers (2008) de Malcolm Gladwell. Es basava en la recerca sobre el rendiment expert, però la versió popular va simplificar l'argument original. No hi ha un nombre màgic universal d'hores que garanteixi la mestria.";
"theory_topic_10k_takeaway" = "Feu servir fites a llarg termini per celebrar la perseverança, no per predir quan us fareu experts.";
"theory_topic_10k_citation" = "K. Anders Ericsson, Ralf T. Krampe, and Clemens Tesch-Römer (1993). The Role of Deliberate Practice in the Acquisition of Expert Performance. Brooke N. Macnamara and Megha Maitra (2019). The Role of Deliberate Practice in Expert Performance: Revisiting Ericsson, Krampe & Tesch-Römer (1993).";
"theory_topic_10k_context" = "La regla de les 10.000 hores es va fer àmpliament popular mitjançant Outliers (2008) de Malcolm Gladwell. L'article de 2019 discuteix com aquesta regla popular difereix de la recerca de 1993.";
"theory_topic_10k_limitation" = "Ericsson i col·legues no van establir una llei universal de mestria de 10.000 hores. No hi ha un nombre universal d'hores que garanteixi la mestria.";
"theory_topic_variance_title" = "La pràctica importa, però no ho és tot";
"theory_topic_variance_summary" = "Una metaanàlisi de 2014 va examinar la pràctica deliberada en diversos camps. La pràctica s'associava al rendiment, però la seva contribució diferia substancialment per domini.";
"theory_topic_variance_takeaway" = "La pràctica és una cosa que podeu influir. Els resultats també depenen d'altres factors, que diferixen entre activitats.";
"theory_topic_variance_citation" = "Brooke N. Macnamara, David Z. Hambrick, and Frederick L. Oswald. Deliberate Practice and Performance in Music, Games, Sports, Education, and Professions: A Meta-Analysis. Psychological Science, 2014, 25(8), 1608–1618.";
"theory_topic_variance_context" = "Una metaanàlisi de 2014 va examinar la pràctica deliberada en diversos camps. La pràctica s'associava al rendiment, però la seva contribució diferia substancialment per domini.";
