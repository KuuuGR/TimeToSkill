/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Esta pantalla lista las habilidades incluidas con la aplicación: el conjunto original más las entradas aceptadas de la colección desarrollada. Los archivos de propuestas piloto no son, por sí solos, el catálogo.";
"theory_compendium_intro" = "Cada pestanya és una marca d'hores que ja fa servir la barra de progrés. El cristall és el color d'aquesta marca. El text explica què significa la marca — i què no significa.";
"theory_hour_unit" = "hores";
"theory_callout_example" = "Exemple";
"theory_callout_caveat" = "Matís";
"theory_callout_takeaway" = "Conclusió pràctica";
"theory_chapter_21_title" = "Superar el començament";
"theory_chapter_21_lead" = "Vint-i-una hores canvien el color de la barra de progrés. No és un resultat de recerca. El mètode publicat més proper és el marc de 20 hores de Josh Kaufman per sobreviure al començament engorroso, i aquests dos nombres no són la mateixa afirmació.";
"theory_chapter_21_mechanism_title" = "Un mètode per començar";
"theory_chapter_21_mechanism" = "Kaufman tracta el començament com un problema pràctic. Dividiu l'habilitat en parts més petites, apreneu prou per notar els propis errors, traieu obstacles que fan la pràctica incòmoda i dediqueu temps concentrat a un resultat. El llibre ho presenta com un mètode de l'autor per començar.";
"theory_chapter_21_example" = "Qui vulgui que tres acords sonin nets pot practicar justament aquest resultat. «Aprendre la guitarra» és un objectiu més gran, i les primeres hores no el resolen.";
"theory_chapter_100_title" = "Cent hores com a marca de l'app";
"theory_chapter_100_lead" = "Cent hores són un fita de Time4Skill per al temps ja registrat. Cap dels estudis d'aquest compendi defineix 100 hores com el moment en què algú esdevé competent.";
"theory_chapter_100_mechanism_title" = "Què mesurava realment la recerca propera";
"theory_chapter_100_mechanism" = "Dues línies de treball se situen a prop d'aquest període sense mesurar-lo en hores. Cepeda, Pashler, Vul, Wixted i Rohrer van revisar 317 experiments sobre record verbal. Espaiar les sessions guanyava a l'atapeïment en aquella literatura, i l'interval útil depenia de quant de temps calia recordar el material. Lally, van Jaarsveld, Potts i Wardle van demanar a voluntaris que repetissin un comportament de menjar, beure o activitat en el mateix context. El temps modelat per arribar al 95 per cent de l'altiplà propi de cada persona va variar molt. Perdre un dia no esborrava la corba.";
"theory_chapter_100_example" = "Tocar un fragment curt en tres dies diferents mostra quin compàs va quedar realment a la memòria. Una llarga nit de repeticions no respon a aquesta pregunta.";
"theory_chapter_100_caveat" = "La revisió sobre l'espaiat tracta del record verbal. L'estudi de l'hàbit tracta de l'automaticitat d'un comportament escollit, i l'interval del model reportat amb l'article va ser de 18 a 254 dies, no una línia de competència a les 100 hores. Cap resultat diu que 100 hores facin algú competent en fotografia, conducció o qualsevol altra habilitat.";
"theory_chapter_100_takeaway" = "Feu servir la marca per notar si torneu. No la tracteu com un nivell guanyat.";
"theory_chapter_1000_title" = "Pràctica dirigida a un forat";
"theory_chapter_1000_lead" = "El cristall de 1.000 hores registra el temps dedicat. No vol dir que la persona ara sigui professional, professor o algú que pugui viure de l'habilitat.";
"theory_chapter_1000_mechanism_title" = "La pràctica deliberada i quant va explicar";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe i Tesch-Römer van descriure la pràctica deliberada com una activitat organitzada per millorar un aspecte concret, amb retorn i correcció, en lloc de només repetir el que ja és còmode. El seu article de 1993 va desenvolupar aquest marc amb estudis de músics. No va publicar un recompte d'hores que crea experts en cada camp. Macnamara, Hambrick i Oswald van estimar després quanta part de la diferència de rendiment s'associava a la pràctica deliberada. Les quotes diferien per domini: més altes en jocs, música i esport que en educació i professions.";
"theory_chapter_1000_example" = "Una hora al passatge que encara es trenca és una activitat diferent d'una hora de peces que ja van bé. La barra de progrés registra el temps en ambdós casos.";
"theory_chapter_1000_caveat" = "Els percentatges per domini són quotes de variància en aquella metaanàlisi de 2014. No són la porció d'habilitat que es pot aprendre ni la probabilitat d'èxit de ningú. L'article no fixa 1.000 hores com a llindar professional. Una redacció antiga de l'app que tractava 1.000 hores com el moment de convertir-se en professional exagerava les proves.";
"theory_chapter_10000_title" = "Un nombre famós, no una llei";
"theory_chapter_10000_lead" = "Deu mil hores es van fer famoses com a regla de mestria. La recerca d'on es va treure no va establir una llei, i el cristall d'aquesta pestanya només identifica la marca d'hores més alta que mostra l'app.";
"theory_chapter_10000_mechanism_title" = "Com va viatjar el nombre";
"theory_chapter_10000_mechanism" = "Outliers (2008) de Malcolm Gladwell va fer àmpliament conegut el nombre rodó. Es basava en la recerca sobre el rendiment expert, inclòs l'article de 1993 d'Ericsson, Krampe i Tesch-Römer sobre la pràctica deliberada entre músics. Macnamara i Maitra (2019) discuteixen com aquesta regla popular difereix de la recerca. La versió popular va comprimir un argument complicat en un llindar que garantia la mestria.";
"theory_chapter_10000_example" = "Dues persones poden registrar el mateix total i haver passat el temps de manera diferent. Una pot haver tingut un professor que corregia un defecte concret. L'altra pot haver repetit una peça que ja toca. El total d'hores no registra aquesta diferència.";
