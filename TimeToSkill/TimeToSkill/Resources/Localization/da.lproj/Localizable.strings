"theory_topic_spacing_title" = "Vend tilbage til en færdighed i stedet for at proppe det hele";
"theory_topic_spacing_summary" = "Forskning i fordelt øvelse støtter at sprede læring over flere sessioner frem for kun masseret øvelse. Den bedste afstand afhænger af materialet og af, hvor længe du vil huske det.";
"theory_topic_spacing_takeaway" = "Prøv at vende tilbage til en færdighed over flere dage, og se hvad du husker, og hvad der kræver mere øvelse.";
"theory_topic_spacing_citation" = "Nicholas J. Cepeda, Harold Pashler, Edward Vul, John T. Wixted, and Doug Rohrer. Distributed Practice in Verbal Recall Tasks: A Review and Quantitative Synthesis. Psychological Bulletin, 2006, 132(3), 354–380.";
"theory_topic_spacing_context" = "Metaanalysen gennemgik 317 eksperimenter på tværs af 184 artikler med 839 vurderinger af fordelt øvelse.";
"theory_topic_spacing_limitation" = "Disse resultater vedrører lærings- og genkaldelsesopgaver. De præsenterer ikke én optimal plan for hver fysisk, social, kunstnerisk eller professionel færdighed.";
"theory_topic_habit_title" = "En vane har ingen universel deadline";
"theory_topic_habit_summary" = "At gentage en handling i samme kontekst kan gøre den mere automatisk over tid. Den nødvendige tid varierer dog mellem mennesker og adfærd. At missede én dag betyder ikke, at al fremgang er tabt.";
"theory_topic_habit_takeaway" = "Knyt en aktivitet til en situation, du møder regelmæssigt, og genoptag uden skyld, når en session falder væk.";
"theory_topic_habit_citation" = "Phillippa Lally, Cornelia H. M. van Jaarsveld, Henry W. W. Potts, and Jane Wardle. How Are Habits Formed: Modelling Habit Formation in the Real World. European Journal of Social Psychology, 2010, 40, 998–1009.";
"theory_topic_habit_context" = "Seksoghalvfems frivillige valgte en spise-, drikke- eller aktivitetsadfærd at gentage i samme kontekst i 12 uger. Toogfirs deltagere leverede tilstrækkelige data. Den modellerede tid til 95 % af det asymptotiske automatiseringsestimat varierede fra 18 til 254 dage.";
"theory_topic_habit_limitation" = "Det var et studie af vanedannelse, ikke et studie af, hvor mange timer der kræves for at mestre en færdighed. Det støtter ikke en 21-timers mestringstærskel eller en universel 21-dages vaneregel.";
"theory_milestones_title" = "Fremskridtsmilepæle";
"theory_milestones_note" = "The 100-hour, 1,000-hour, and 10,000-hour marks in Time4Skill record time you have spent. They are progress milestones, not scientifically validated stages, and they do not predict when you will become an expert.";
"theory_milestone_100_title" = "100 timer";
"theory_milestone_1000_title" = "1000 timer";
"theory_milestone_10000_title" = "10.000 timer";
"theory_milestone_note" = "Fremskridtsmilepæl, ikke et universelt ekspertisetrin.";

