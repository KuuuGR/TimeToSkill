/* T4S-036 compendium, counters, catalog note */
"catalog_exemplary_note" = "Dit scherm toont de vaardigheden die bij de app horen: de oorspronkelijke set plus items uit de uitgewerkte catalogus.";
"theory_compendium_intro" = "Hver fane er et timemærke, som fremskridtsbjælken allerede bruger. Krystallen er mærkets farve. Teksten forklarer, hvad mærket betyder — og hvad det ikke betyder.";
"theory_hour_unit" = "timer";
"theory_callout_example" = "Eksempel";
"theory_callout_caveat" = "Forbehold";
"theory_callout_takeaway" = "Konklusion";
"theory_chapter_21_title" = "Forbi begyndelsen";
"theory_chapter_21_lead" = "Enogtyve timer ændrer fremskridtsbjælkens farve. Det er ikke et forskningsfund. Den nærmeste offentliggjorte metode er Josh Kaufmans 20-timers ramme for at overleve den akavede start, og de to tal er ikke den samme påstand.";
"theory_chapter_21_mechanism_title" = "En metode til starten";
"theory_chapter_21_mechanism" = "Kaufman behandler begyndelsen som et praktisk problem. Del færdigheden i mindre dele, lær nok til at opdage egne fejl, fjern barrierer der gør øvelse besværlig, og brug fokuseret tid på ét resultat. Bogen præsenterer det som en forfattermetode til at komme i gang.";
"theory_chapter_21_example" = "En person, der vil have tre akkorder til at lyde rene, kan øve netop det resultat. „Lær guitar“ er et større mål, og de første timer afgør det ikke.";
"theory_chapter_100_title" = "Hundrede timer som app-mærke";
"theory_chapter_100_lead" = "Hundrede timer er et Time4Skill-mål for allerede registreret tid. Ingen af studierne i dette kompendium definerer 100 timer som det punkt, hvor nogen bliver kompetent.";
"theory_chapter_100_mechanism_title" = "Hvad nærliggende forskning faktisk målte";
"theory_chapter_100_mechanism" = "To forskningslinjer ligger nær denne periode uden at måle den i timer. Cepeda, Pashler, Vul, Wixted og Rohrer gennemgik 317 eksperimenter om verbal genkaldelse. Spredte sessioner slog propning i den litteratur, og det nyttige mellemrum afhang af, hvor længe materialet skulle huskes. Lally, van Jaarsveld, Potts og Wardle bad frivillige gentage en spise-, drikke- eller aktivitetsadfærd i samme kontekst. Den modellerede tid til 95 procent af hver persons eget plateau varierede stærkt. At missede én dag slettede ikke kurven.";
"theory_chapter_100_example" = "At spille et kort stykke på tre forskellige dage viser, hvilken takt der faktisk blev i hukommelsen. En lang aften med gentagelse besvarer ikke det spørgsmål.";
"theory_chapter_100_caveat" = "Oversigten om spredning handler om verbal genkaldelse. Vaneundersøgelsen handler om automatisering af en valgt adfærd, og intervallet i modellen med artiklen var 18 til 254 dage — ikke en kompetencelinje ved 100 timer. Intet resultat siger, at 100 timer gør nogen kompetent i fotografi, bilkørsel eller en anden færdighed.";
"theory_chapter_100_takeaway" = "Brug mærket til at bemærke, om du kommer tilbage. Behandl det ikke som et fortjent niveau.";
"theory_chapter_1000_title" = "Øvelse rettet mod ét hul";
"theory_chapter_1000_lead" = "1000-timerskrystallen registrerer brugt tid. Den betyder ikke, at personen nu er professionel, lærer eller nogen, der kan leve af færdigheden.";
"theory_chapter_1000_mechanism_title" = "Bevidst øvelse, og hvor meget den forklarede";
"theory_chapter_1000_mechanism" = "Ericsson, Krampe og Tesch-Römer beskrev bevidst øvelse som aktivitet arrangeret for at forbedre et bestemt aspekt, med feedback og korrektion, frem for blot at gentage det allerede behagelige. Deres artikel fra 1993 udviklede rammen med studier af musikere. Den offentliggjorde ikke et timetal, der skaber eksperter på ethvert felt. Macnamara, Hambrick og Oswald estimerede senere, hvor meget af forskellen i præstation hang sammen med bevidst øvelse. Andelene varierede efter domæne: højere i spil, musik og sport end i uddannelse og professioner.";
"theory_chapter_1000_example" = "En time på passagen, der stadig falder fra hinanden, er en anden aktivitet end en time med stykker, der allerede går godt. Fremskridtsbjælken registrerer tiden i begge tilfælde.";
"theory_chapter_1000_caveat" = "Domæneprocenterne er andele af varians i metaanalysen fra 2014. De er ikke den del af en færdighed, man kan lære, og ikke nogens chance for succes. Artiklen sætter ikke 1000 timer som professionel tærskel. Ældre ordlyd i appen, der behandlede 1000 timer som punktet for at blive professionel, overdrev evidensen.";
"theory_chapter_10000_title" = "Et berømt tal, ikke en lov";
"theory_chapter_10000_lead" = "Tit tusinde timer blev berømte som mesterskabsregel. Forskningen, den kom fra, etablerede ikke en lov, og krystallen på denne fane markerer kun appens højeste viste timemærke.";
"theory_chapter_10000_mechanism_title" = "Hvordan tallet rejste";
"theory_chapter_10000_mechanism" = "Malcolm Gladwells Outliers (2008) gjorde det runde tal vidt kendt. Den byggede på forskning om ekspertpræstation, herunder artiklen fra 1993 af Ericsson, Krampe og Tesch-Römer om bevidst øvelse blandt musikere. Macnamara og Maitra (2019) drøfter, hvordan den populære regel adskiller sig fra forskningen. Den populære version sammenpressede et kompliceret argument til én tærskel, der skulle garantere mestring.";
"theory_chapter_10000_example" = "To personer kan registrere det samme total og alligevel have brugt tiden forskelligt. Den ene havde måske en lærer, der rettede en bestemt fejl. Den anden gentog måske et stykke, de allerede spiller. Timetotalen registrerer ikke den forskel.";
