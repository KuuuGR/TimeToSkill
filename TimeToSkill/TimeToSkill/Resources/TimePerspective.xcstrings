          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons nådde Pluto på omtrent ni og et halvt år."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons bereikte Pluto in ongeveer negen en een half jaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonda New Horizons dotarła do Plutona po około dziewięciu i pół roku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
