        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια πτήση με ελικόπτερο για περιήγηση στα αξιοθέατα συνήθως διαρκεί περίπου δύο ώρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vuelo turístico en helicóptero suele durar unas dos horas."
          }
        },
