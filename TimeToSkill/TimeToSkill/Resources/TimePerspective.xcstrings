    "perspective.pluto_journey.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons reached Pluto in about nine and a half years."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت نيوهورايزنز إلى كوكب بلوتو في حوالي تسع سنوات ونصف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons va arribar a Plutó en uns nou anys i mig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons dosáhla Pluta asi za devět a půl roku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons nåede Pluto på omkring ni et halvt år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons erreichte Pluto in etwa neuneinhalb Jahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το New Horizons έφτασε στον Πλούτωνα σε περίπου εννιάμισι χρόνια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons llegó a Plutón en unos nueve años y medio."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons llegó a Plutón en unos nueve años y medio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons saavutti Pluton noin yhdeksässä ja puolessa vuodessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons a atteint Pluton en neuf ans et demi environ."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons a atteint Pluton en neuf ans et demi environ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אופק חדש הגיע לפלוטו תוך כתשע שנים וחצי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न्यू होराइजन्स लगभग साढ़े नौ साल में प्लूटो तक पहुंच गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons je stigao do Plutona za oko devet i pol godina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A New Horizons körülbelül kilenc és fél év alatt érte el a Plútót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons mencapai Pluto dalam waktu sekitar sembilan setengah tahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons raggiunse Plutone in circa nove anni e mezzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ニューホライズンズは約9年半かけて冥王星に到達した。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뉴 호라이즌스는 약 9년 반 만에 명왕성에 도달했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
