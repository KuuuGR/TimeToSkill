    "perspective.vega_pole_star.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega naturally shifts to become Earth's North Star."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحول فيجا بشكل طبيعي ليصبح نجم الشمال للأرض."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega canvia naturalment per convertir-se en l'estrella polar de la Terra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega se přirozeně posouvá, aby se stala Polární hvězdou Země."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega skifter naturligt til at blive Jordens Nordstjerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wega verwandelt sich auf natürliche Weise in den Nordstern der Erde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Vega μετατοπίζεται φυσικά για να γίνει ο Βόρειος Αστέρας της Γης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega cambia naturalmente para convertirse en la Estrella Polar de la Tierra."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega cambia naturalmente para convertirse en la Estrella Polar de la Tierra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega muuttuu luonnollisesti Maan Pohjantähdeksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega se transforme naturellement pour devenir l'étoile polaire de la Terre."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega se transforme naturellement pour devenir l'étoile polaire de la Terre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "וגה עובר באופן טבעי להפוך לכוכב הצפון של כדור הארץ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वेगा स्वाभाविक रूप से पृथ्वी का उत्तरी सितारा बन जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega se prirodno pomiče i postaje Zemljina zvijezda Sjevernjača."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vega természetesen átváltozik a Föld északi csillagává."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega secara alami berubah menjadi Bintang Utara Bumi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega si sposta naturalmente per diventare la Stella Polare della Terra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベガは自然に変化して地球の北極星になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "베가는 자연스럽게 지구의 북극성이 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega secara semula jadi berubah menjadi Bintang Utara Bumi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega skifter naturlig til å bli jordens nordstjerne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega verandert op natuurlijke wijze en wordt de Noordster van de aarde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega w naturalny sposób zmienia się, stając się Gwiazdą Północną Ziemi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega muda naturalmente para se tornar a Estrela do Norte da Terra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega muda naturalmente para se tornar a Estrela do Norte da Terra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega se schimbă în mod natural pentru a deveni Steaua Polară a Pământului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вега естественным образом превращается в Полярную звезду Земли."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega sa prirodzene posúva, aby sa stala Severnou hviezdou Zeme."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega skiftar naturligt för att bli jordens nordstjärna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวก้าจะเปลี่ยนไปเป็นดาวเหนือของโลกโดยธรรมชาติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega doğal olarak Dünya'nın Kuzey Yıldızı olacak şekilde değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вега природним чином змінюється, щоб стати Полярною зіркою Землі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vega tự nhiên chuyển đổi để trở thành Sao Bắc Đẩu của Trái đất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "织女星自然地转变为地球的北极星。"
          }
        },
        "zh-Hant": {
