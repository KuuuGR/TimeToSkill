          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa bambuarter når full höjd på cirka två år."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไผ่บางชนิดจะโตเต็มที่ในเวลาประมาณสองปี"
