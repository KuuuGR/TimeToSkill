    "perspective.apple_tree.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An apple tree usually reaches full fruit production after about ten years."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادة ما تصل شجرة التفاح إلى إنتاج الفاكهة الكامل بعد حوالي عشر سنوات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pomer acostuma a arribar a la producció plena de fruits després d'uns deu anys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plné plodnosti jabloň obvykle dosáhne zhruba po deseti letech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et æbletræ når normalt fuld frugtproduktion efter cirka ti år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die volle Fruchtproduktion erreicht ein Apfelbaum in der Regel nach etwa zehn Jahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια μηλιά συνήθως φτάνει σε πλήρη παραγωγή καρπού μετά από περίπου δέκα χρόνια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un manzano suele alcanzar la plena producción de frutos al cabo de unos diez años."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un manzano suele alcanzar la plena producción de frutos al cabo de unos diez años."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omenapuu saavuttaa täyden hedelmän yleensä noin kymmenen vuoden kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pommier atteint généralement sa pleine production de fruits après une dizaine d’années."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pommier atteint généralement sa pleine production de fruits après une dizaine d’années."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עץ תפוח בדרך כלל מגיע לייצור פרי מלא לאחר כעשר שנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सेब का पेड़ आमतौर पर लगभग दस वर्षों के बाद पूर्ण फल उत्पादन तक पहुंचता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stablo jabuke obično postigne punu rodnost nakon desetak godina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az almafa általában körülbelül tíz év után éri el a teljes gyümölcstermést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohon apel biasanya mencapai produksi buah penuh setelah sekitar sepuluh tahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un melo raggiunge solitamente la piena produzione di frutti dopo circa dieci anni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンゴの木は通常、約 10 年後に完全に実を結ぶようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사과나무는 보통 약 10년이 지나면 완전한 열매를 맺게 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokok epal biasanya mencapai pengeluaran buah penuh selepas kira-kira sepuluh tahun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et epletre når vanligvis full fruktproduksjon etter omtrent ti år."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een appelboom bereikt gewoonlijk na ongeveer tien jaar de volledige fruitproductie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jabłoń osiąga pełną produkcję owoców zwykle po około dziesięciu latach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma macieira geralmente atinge a produção plena de frutos após cerca de dez anos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma macieira geralmente atinge a produção plena de frutos após cerca de dez anos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un măr ajunge, de obicei, la producția completă de fructe după aproximativ zece ani."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полного плодоношения яблоня обычно достигает примерно через десять лет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plnú produkciu ovocia jabloň zvyčajne dosiahne približne po desiatich rokoch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett äppelträd når vanligtvis full fruktproduktion efter cirka tio år."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้นแอปเปิ้ลมักจะออกผลเต็มที่หลังจากผ่านไปประมาณสิบปี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir elma ağacı genellikle yaklaşık on yıl sonra tam meyve üretimine ulaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зазвичай яблуня досягає повного плодоношення приблизно через десять років."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cây táo thường đạt sản lượng đầy đủ sau khoảng mười năm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "苹果树通常在大约十年后才能完全结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蘋果樹通常在大約十年後才能完全結果。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "An apple tree usually reaches full fruit production after about ten years."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "An apple tree usually reaches full fruit production after about ten years."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "An apple tree usually reaches full fruit production after about ten years."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "An apple tree usually reaches full fruit production after about ten years."
          }
        }
      }
    },
