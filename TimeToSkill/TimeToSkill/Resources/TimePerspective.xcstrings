          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Brisket masak perlahan mengambil masa kira-kira sepuluh jam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Saktekoking av brisket tar omtrent ti timer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het langzaam koken van borststuk duurt ongeveer tien uur."
