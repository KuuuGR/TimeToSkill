    "perspective.giant_sequoia_lifespan.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Giant sequoias can live for more than two thousand years."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن تعيش نباتات السكويا العملاقة لأكثر من ألفي عام."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sequoies gegants poden viure més de dos mil anys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekvoje obrovské mohou žít více než dva tisíce let."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kæmpe sequoiaer kan leve i mere end to tusinde år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Riesenmammutbäume können mehr als zweitausend Jahre alt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι γιγάντιες σεκόγιες μπορούν να ζήσουν για περισσότερα από δύο χιλιάδες χρόνια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las secuoyas gigantes pueden vivir más de dos mil años."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las secuoyas gigantes pueden vivir más de dos mil años."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jättiläiset sekvoiat voivat elää yli kaksituhatta vuotta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séquoias géants peuvent vivre plus de deux mille ans."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séquoias géants peuvent vivre plus de deux mille ans."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סקווי ענק יכולים לחיות יותר מאלפיים שנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विशाल सिकोइया दो हजार से अधिक वर्षों तक जीवित रह सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Divovske sekvoje mogu živjeti više od dvije tisuće godina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az óriás sequoiák több mint kétezer évig élhetnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sequoia raksasa dapat hidup lebih dari dua ribu tahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sequoie giganti possono vivere più di duemila anni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャイアントセコイアは2000年以上生きることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자이언트 세쿼이아는 2천년 이상 살 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sequoia gergasi boleh hidup selama lebih daripada dua ribu tahun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gigantiske sequoiaer kan leve i mer enn to tusen år."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mammoetbomen kunnen meer dan tweeduizend jaar oud worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gigantyczne sekwoje mogą żyć ponad dwa tysiące lat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sequóias gigantes podem viver mais de dois mil anos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As sequóias gigantes podem viver mais de dois mil anos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sequoia gigant poate trăi mai mult de două mii de ani."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гигантские секвойи могут жить более двух тысяч лет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekvoje obrovské môžu žiť viac ako dvetisíc rokov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätte sequoia kan leva i mer än två tusen år."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้นซีคัวญ่ายักษ์สามารถมีชีวิตอยู่ได้นานกว่าสองพันปี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dev sekoyalar iki bin yıldan fazla yaşayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гігантські секвойї можуть жити більше двох тисяч років."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sequoias khổng lồ có thể sống hơn hai nghìn năm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "巨型红杉可以活两千多年。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "巨型紅杉可以活兩千多年。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Giant sequoias can live for more than two thousand years."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Giant sequoias can live for more than two thousand years."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Giant sequoias can live for more than two thousand years."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Giant sequoias can live for more than two thousand years."
          }
        }
      }
