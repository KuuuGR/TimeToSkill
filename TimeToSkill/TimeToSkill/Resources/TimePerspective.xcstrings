    "perspective.interstellar_space.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 has traveled through interstellar space for nearly half a century."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سافرت فوييجر 1 عبر الفضاء بين النجوم لمدة نصف قرن تقريبًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La Voyager 1 ha viatjat per l'espai interestel·lar durant gairebé mig segle."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 cestoval mezihvězdným prostorem téměř půl století."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 har rejst gennem det interstellare rum i næsten et halvt århundrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 reist seit fast einem halben Jahrhundert durch den interstellaren Raum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Voyager 1 έχει ταξιδέψει στο διαστρικό διάστημα για σχεδόν μισό αιώνα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Voyager 1 ha viajado por el espacio interestelar durante casi medio siglo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La Voyager 1 ha viajado por el espacio interestelar durante casi medio siglo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 on matkustanut tähtienvälisessä avaruudessa lähes puoli vuosisataa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 voyage dans l'espace interstellaire depuis près d'un demi-siècle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 voyage dans l'espace interstellaire depuis près d'un demi-siècle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "וויאג'ר 1 עברה בחלל הבין-כוכבי במשך כמעט חצי מאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वोयाजर 1 ने लगभग आधी शताब्दी तक अंतरतारकीय अंतरिक्ष की यात्रा की है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 je putovao kroz međuzvjezdani prostor gotovo pola stoljeća."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Voyager 1 közel fél évszázada utazott a csillagközi űrben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 telah melakukan perjalanan melalui ruang antarbintang selama hampir setengah abad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Voyager 1 viaggia nello spazio interstellare da quasi mezzo secolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボイジャー1号は半世紀近くにわたって星間空間を旅してきた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보이저 1호는 거의 반세기 동안 성간 공간을 여행했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 telah mengembara melalui ruang antara bintang selama hampir setengah abad."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 har reist gjennom det interstellare rommet i nesten et halvt århundre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 heeft bijna een halve eeuw door de interstellaire ruimte gereisd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 podróżuje w przestrzeni międzygwiezdnej od prawie pół wieku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Voyager 1 viajou pelo espaço interestelar durante quase meio século."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Voyager 1 viajou pelo espaço interestelar durante quase meio século."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 a călătorit prin spațiul interstelar timp de aproape jumătate de secol."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Вояджер-1» путешествовал по межзвездному пространству почти полвека."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 cestoval medzihviezdnym priestorom takmer pol storočia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 har färdats genom det interstellära rymden i nästan ett halvt sekel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยานโวเอเจอร์ 1 เดินทางผ่านอวกาศระหว่างดวงดาวมาเกือบครึ่งศตวรรษแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 neredeyse yarım yüzyıldır yıldızlararası uzayda yolculuk yapıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Вояджер-1» подорожував міжзоряним простором майже півстоліття."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hành 1 đã du hành xuyên không gian giữa các vì sao trong gần nửa thế kỷ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行者一号已经在星际空间中航行了近半个世纪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行者一號已經在星際空間中航行了近半個世紀。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 has traveled through interstellar space for nearly half a century."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 has traveled through interstellar space for nearly half a century."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 has traveled through interstellar space for nearly half a century."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 has traveled through interstellar space for nearly half a century."
          }
        }
      }
    },
