            "value": "Misja do Jowisza trwa około pięciu lat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma missão a Júpiter leva cerca de cinco anos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma missão a Júpiter leva cerca de cinco anos."
          }
        },
        "ro": {
