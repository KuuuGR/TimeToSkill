    "perspective.transatlantic_flight.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nonstop flight across the Atlantic takes about eight hours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستغرق الرحلة الجوية بدون توقف عبر المحيط الأطلسي حوالي ثماني ساعات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol sense escales a través de l'Atlàntic triga unes vuit hores."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Let bez mezipřistání přes Atlantik trvá asi osm hodin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En direkte flyvning over Atlanten tager omkring otte timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Nonstop-Flug über den Atlantik dauert etwa acht Stunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια απευθείας πτήση πέρα ​​από τον Ατλαντικό διαρκεί περίπου οκτώ ώρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vuelo sin escalas a través del Atlántico dura unas ocho horas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vuelo sin escalas a través del Atlántico dura unas ocho horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suora lento Atlantin yli kestää noin kahdeksan tuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol sans escale à travers l’Atlantique prend environ huit heures."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol sans escale à travers l’Atlantique prend environ huit heures."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיסה ללא הפסקה מעבר לאוקיינוס ​​האטלנטי אורכת כשמונה שעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अटलांटिक के पार एक नॉनस्टॉप उड़ान में लगभग आठ घंटे लगते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Direktan let preko Atlantika traje oko osam sati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy megállás nélküli repülés az Atlanti-óceánon körülbelül nyolc órát vesz igénybe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerbangan nonstop melintasi Atlantik memakan waktu sekitar delapan jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un volo diretto attraverso l'Atlantico dura circa otto ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大西洋を直行便で横断する場合、所要時間は約 8 時間です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대서양을 직항으로 횡단하는 데 약 8시간이 걸립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerbangan tanpa henti merentasi Atlantik mengambil masa kira-kira lapan jam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En direkte flytur over Atlanterhavet tar omtrent åtte timer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een non-stopvlucht over de Atlantische Oceaan duurt ongeveer acht uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lot bez przesiadek przez Atlantyk trwa około ośmiu godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um voo direto através do Atlântico leva cerca de oito horas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um voo direto através do Atlântico leva cerca de oito horas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un zbor fără escală peste Atlantic durează aproximativ opt ore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Беспосадочный перелет через Атлантику занимает около восьми часов."
          }
        },
        "sk": {
          "stringUnit": {
