    "perspective.black_belt.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earning a martial arts black belt takes about ten years of practice."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق الحصول على الحزام الأسود للفنون القتالية حوالي عشر سنوات من الممارسة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aconseguir un cinturó negre d'arts marcials requereix uns deu anys de pràctica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Získání černého pásu bojových umění trvá asi deset let praxe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At tjene et sort bælte for kampsport tager omkring ti års træning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Erwerb eines schwarzen Gürtels im Kampfsport erfordert etwa zehn Jahre Übung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απόκτηση μιας μαύρης ζώνης πολεμικών τεχνών απαιτεί περίπου δέκα χρόνια εξάσκησης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtener un cinturón negro en artes marciales requiere unos diez años de práctica."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtener un cinturón negro en artes marciales requiere unos diez años de práctica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamppailulajien mustan vyön ansaitseminen vaatii noin kymmenen vuoden harjoittelua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagner une ceinture noire en arts martiaux demande environ dix ans de pratique."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagner une ceinture noire en arts martiaux demande environ dix ans de pratique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להרוויח חגורה שחורה של אומנויות לחימה לוקח כעשר שנים של תרגול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मार्शल आर्ट ब्लैक बेल्ट अर्जित करने के लिए लगभग दस साल का अभ्यास करना पड़ता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za stjecanje crnog pojasa borilačkih vještina potrebno je desetak godina vježbanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A harcművészeti fekete öv megszerzése körülbelül tíz év gyakorlást igényel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghasilkan sabuk hitam seni bela diri membutuhkan sekitar sepuluh tahun latihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guadagnare una cintura nera di arti marziali richiede circa dieci anni di pratica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "武道の黒帯を取得するには、約10年の練習が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무술 검은 띠를 획득하려면 약 10년의 연습이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memperoleh tali pinggang hitam seni mempertahankan diri mengambil masa kira-kira sepuluh tahun latihan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å tjene et svart belte for kampsport tar omtrent ti år med trening."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het behalen van een zwarte band in vechtsporten vergt ongeveer tien jaar oefening."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdobycie czarnego pasa w sztukach walki wymaga około dziesięciu lat ćwiczeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganhar a faixa preta em artes marciais leva cerca de dez anos de prática."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganhar a faixa preta em artes marciais leva cerca de dez anos de prática."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Câștigarea unei centuri negre de arte marțiale necesită aproximativ zece ani de practică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для получения черного пояса по боевым искусствам требуется около десяти лет практики."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Získanie čierneho pásu bojových umení si vyžaduje približne desať rokov praxe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att tjäna ett svart bälte för kampsport tar ungefär tio års träning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การได้รับเข็มขัดหนังสีดำด้านศิลปะการต่อสู้ใช้เวลาประมาณสิบปีในการฝึกฝน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dövüş sanatlarında siyah kuşak kazanmak yaklaşık on yıllık pratik gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб отримати чорний пояс бойових мистецтв, потрібно близько десяти років практики."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đạt được đai đen võ thuật phải mất khoảng mười năm luyện tập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获得武术黑带需要大约十年的练习。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獲得武術黑帶需要大約十年的練習。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Earning a martial arts black belt takes about ten years of practice."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Earning a martial arts black belt takes about ten years of practice."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Earning a martial arts black belt takes about ten years of practice."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Earning a martial arts black belt takes about ten years of practice."
          }
        }
      }
    },
