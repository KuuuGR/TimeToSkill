          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cascada Niagara durează aproximativ cincizeci de ani pentru a eroda un metru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниагарскому водопаду требуется около пятидесяти лет, чтобы разрушить один метр."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niagarským vodopádom trvá asi päťdesiat rokov, kým erodujú jeden meter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Niagarafallen tar ungefär femtio år att erodera en meter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำตกไนแองการาใช้เวลาประมาณห้าสิบปีในการกัดเซาะหนึ่งเมตร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niagara Şelalesi'nin bir metreyi aşındırması yaklaşık elli yıl sürüyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніагарському водоспаду потрібно приблизно п'ятдесят років, щоб розмити його на один метр."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thác Niagara mất khoảng năm mươi năm để xói mòn một mét."
          }
        },
        "zh-Hans": {
          "stringUnit": {
