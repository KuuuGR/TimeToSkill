    "perspective.short_haul_flight.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A typical short-haul flight lasts about three hours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستغرق الرحلة القصيرة النموذجية حوالي ثلاث ساعات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol típic de curta distància dura unes tres hores."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Typický let na krátkou vzdálenost trvá asi tři hodiny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En typisk kortdistanceflyvning varer omkring tre timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein typischer Kurzstreckenflug dauert etwa drei Stunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια τυπική πτήση μικρών αποστάσεων διαρκεί περίπου τρεις ώρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vuelo típico de corta distancia dura aproximadamente tres horas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vuelo típico de corta distancia dura aproximadamente tres horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyypillinen lyhyen matkan lento kestää noin kolme tuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol court-courrier typique dure environ trois heures."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol court-courrier typique dure environ trois heures."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיסה טיפוסית לטווח קצר נמשכת כשלוש שעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सामान्य छोटी दूरी की उड़ान लगभग तीन घंटे तक चलती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipičan let na kratkim relacijama traje oko tri sata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy tipikus rövid távú repülés körülbelül három óráig tart."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerbangan jarak pendek biasanya memakan waktu sekitar tiga jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tipico volo a corto raggio dura circa tre ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の短距離フライトの所要時間は約 3 時間です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반적인 단거리 비행은 약 3시간 정도 소요됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerbangan jarak pendek biasa mengambil masa kira-kira tiga jam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En typisk kortdistanseflyvning varer i omtrent tre timer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een typische korteafstandsvlucht duurt ongeveer drie uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typowy lot krótkodystansowy trwa około trzech godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um voo típico de curta distância dura cerca de três horas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um voo típico de curta distância dura cerca de três horas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un zbor tipic pe distanțe scurte durează aproximativ trei ore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Типичный ближнемагистральный рейс длится около трех часов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Typický let na krátke vzdialenosti trvá približne tri hodiny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En typisk kortdistansflygning tar cirka tre timmar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เที่ยวบินระยะสั้นทั่วไปใช้เวลาประมาณสามชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipik bir kısa mesafeli uçuş yaklaşık üç saat sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типовий короткомагістральний політ триває близько трьох годин."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một chuyến bay đường ngắn thông thường kéo dài khoảng ba giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "典型的短途航班持续约三个小时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "典型的短程航班持續約三個小時。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A typical short-haul flight lasts about three hours."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A typical short-haul flight lasts about three hours."
          }
        },
        "en-GB": {
          "stringUnit": {
