    "perspective.proxima_centauri.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light from Earth reaches Proxima Centauri in about 4.25 years."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصل الضوء من الأرض إلى بروكسيما سنتوري في حوالي 4.25 سنة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La llum de la Terra arriba a Pròxima Centauri en uns 4,25 anys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Světlo ze Země dosáhne Proxima Centauri asi za 4,25 roku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lys fra Jorden når Proxima Centauri på omkring 4,25 år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht von der Erde erreicht Proxima Centauri in etwa 4,25 Jahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φως από τη Γη φτάνει στο Proxima Centauri σε περίπου 4,25 χρόνια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz de la Tierra llega a Próxima Centauri en unos 4,25 años."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz de la Tierra llega a Próxima Centauri en unos 4,25 años."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maan valo saavuttaa Proxima Centaurin noin 4,25 vuodessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière provenant de la Terre atteint Proxima Centauri en 4,25 ans environ."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière provenant de la Terre atteint Proxima Centauri en 4,25 ans environ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אור מכדור הארץ מגיע לפרוקסימה קנטאורי בעוד כ-4.25 שנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पृथ्वी से प्रकाश प्रॉक्सिमा सेंटॉरी तक लगभग 4.25 वर्षों में पहुंचता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svjetlost sa Zemlje doseže Proximu Centauri za oko 4,25 godina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Földről érkező fény körülbelül 4,25 év alatt éri el a Proxima Centaurit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya dari Bumi mencapai Proxima Centauri dalam waktu sekitar 4,25 tahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce dalla Terra raggiunge Proxima Centauri in circa 4,25 anni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地球からの光は約 4.25 年かけてプロキシマ ケンタウリに到達します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지구에서 오는 빛은 약 4.25년 만에 프록시마 센타우리(Proxima Centauri)에 도달합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya dari Bumi mencapai Proxima Centauri dalam masa kira-kira 4.25 tahun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lys fra jorden når Proxima Centauri på omtrent 4,25 år."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht van de aarde bereikt Proxima Centauri in ongeveer 4,25 jaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Światło z Ziemi dociera do Proxima Centauri w ciągu około 4,25 lat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz da Terra atinge Proxima Centauri em cerca de 4,25 anos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz da Terra atinge Proxima Centauri em cerca de 4,25 anos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumina de pe Pământ ajunge la Proxima Centauri în aproximativ 4,25 ani."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свет с Земли достигает Проксимы Центавра примерно за 4,25 года."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Svetlo zo Zeme dosiahne Proxima Centauri asi za 4,25 roka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljus från jorden når Proxima Centauri på cirka 4,25 år."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสงจากโลกมาถึงพรอกซิมา เซนทอรี ในเวลาประมาณ 4.25 ปี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünya'dan gelen ışık Proxima Centauri'ye yaklaşık 4,25 yılda ulaşıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Світло від Землі досягає Проксими Центавра приблизно за 4,25 року."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ánh sáng từ Trái đất tới Proxima Centauri trong khoảng 4,25 năm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自地球的光大约需要 4.25 年才能到达比邻星。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自地球的光大約需要 4.25 年才能到達比鄰星。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Light from Earth reaches Proxima Centauri in about 4.25 years."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Light from Earth reaches Proxima Centauri in about 4.25 years."
          }
        },
        "en-GB": {
