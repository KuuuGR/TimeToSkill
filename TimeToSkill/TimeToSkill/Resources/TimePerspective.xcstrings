    "perspective.video_game.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completing many video games takes about fifteen hours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق إكمال العديد من ألعاب الفيديو حوالي خمسة عشر ساعة."
          }
        },
        "ca": {
