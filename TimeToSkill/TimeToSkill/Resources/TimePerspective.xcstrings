            "value": "वास्तविक दुनिया में समय की तुलना खोजने के लिए किसी भी अवधि को रूपांतरित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretvorite bilo koje trajanje da biste otkrili usporedbe vremena u stvarnom svijetu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármely időtartam konvertálásával valós idejű összehasonlításokat fedezhet fel."
