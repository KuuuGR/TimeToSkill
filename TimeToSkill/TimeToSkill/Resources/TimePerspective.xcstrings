        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα χριστουγεννιάτικο δέντρο μεγαλώνει σε μέγεθος συγκομιδής σε περίπου πέντε χρόνια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un árbol de Navidad alcanza el tamaño de cosecha en unos cinco años."
          }
        },
        "es-419": {
          "stringUnit": {
