    "perspective.coffee_break.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking a short coffee break usually takes about fifteen minutes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادة ما يستغرق أخذ استراحة قصيرة لتناول القهوة حوالي خمسة عشر دقيقة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fer una petita pausa per al cafè sol durar uns quinze minuts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátká přestávka na kávu obvykle trvá asi patnáct minut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At holde en kort kaffepause tager normalt omkring femten minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Kaffeepause dauert in der Regel etwa fünfzehn Minuten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το να κάνετε ένα σύντομο διάλειμμα για καφέ συνήθως διαρκεί περίπου δεκαπέντε λεπτά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomar un breve descanso para tomar café suele durar unos quince minutos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomar un breve descanso para tomar café suele durar unos quince minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyhyen kahvitauon pitäminen kestää yleensä noin viisitoista minuuttia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre une courte pause-café prend généralement une quinzaine de minutes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre une courte pause-café prend généralement une quinzaine de minutes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפסקת קפה קצרה אורכת בדרך כלל כחמש עשרה דקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक छोटा कॉफ़ी ब्रेक लेने में आमतौर पर लगभग पंद्रह मिनट लगते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kratka stanka za kavu obično traje oko petnaest minuta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy rövid kávészünet általában körülbelül tizenöt percig tart."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehat kopi singkat biasanya memakan waktu sekitar lima belas menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare una breve pausa caffè dura solitamente circa quindici minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短いコーヒーブレイクには通常 15 分ほどかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 커피 휴식 시간은 일반적으로 약 15분 정도 소요됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengambil rehat kopi yang singkat biasanya mengambil masa kira-kira lima belas minit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å ta en kort kaffepause tar vanligvis omtrent femten minutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een korte koffiepauze duurt doorgaans ongeveer een kwartier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótka przerwa na kawę trwa zwykle około piętnastu minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fazer uma pequena pausa para o café geralmente leva cerca de quinze minutos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fazer uma pequena pausa para o café geralmente leva cerca de quinze minutos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Luarea unei scurte pauze de cafea durează de obicei aproximativ cincisprezece minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткий перерыв на кофе обычно занимает около пятнадцати минут."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátka prestávka na kávu zvyčajne trvá asi pätnásť minút."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att ta en kort fikapaus tar vanligtvis cirka femton minuter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพักดื่มกาแฟช่วงสั้นๆ มักจะใช้เวลาประมาณสิบห้านาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa bir kahve molası vermek genellikle yaklaşık on beş dakika sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коротка перерва на каву зазвичай займає близько п’ятнадцяти хвилин."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghỉ giải lao ngắn thường mất khoảng mười lăm phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短暂喝咖啡休息通常需要大约十五分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短暫喝咖啡休息通常需要大約十五分鐘。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking a short coffee break usually takes about fifteen minutes."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking a short coffee break usually takes about fifteen minutes."
          }
        },
        "en-GB": {
          "stringUnit": {
