    "perspective.sunlight_pluto.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light from the Sun reaches Pluto in about five and a half hours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصل ضوء الشمس إلى بلوتو في حوالي خمس ساعات ونصف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La llum del Sol arriba a Plutó en unes cinc hores i mitja."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Světlo ze Slunce dosáhne Pluta asi za pět a půl hodiny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lys fra Solen når Pluto på omkring fem en halv time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Licht der Sonne erreicht Pluto in etwa fünfeinhalb Stunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φως από τον Ήλιο φτάνει στον Πλούτωνα σε περίπου πεντέμισι ώρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
