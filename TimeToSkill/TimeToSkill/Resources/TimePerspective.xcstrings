    "perspective.moon_journey.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apollo astronauts reached the Moon in about three days."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل رواد فضاء أبولو إلى القمر في حوالي ثلاثة أيام."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els astronautes de l'Apol·lo van arribar a la Lluna en uns tres dies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Astronauti Apolla dosáhli Měsíce asi za tři dny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apollo-astronauter nåede Månen på omkring tre dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apollo-Astronauten erreichten den Mond in etwa drei Tagen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αστροναύτες του Απόλλωνα έφτασαν στη Σελήνη σε περίπου τρεις ημέρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los astronautas del Apolo llegaron a la Luna en unos tres días."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los astronautas del Apolo llegaron a la Luna en unos tres días."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apollo-astronautit saavuttivat Kuun noin kolmessa päivässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les astronautes d'Apollo ont atteint la Lune en trois jours environ."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les astronautes d'Apollo ont atteint la Lune en trois jours environ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אסטרונאוטים של אפולו הגיעו לירח תוך כשלושה ימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपोलो अंतरिक्ष यात्री लगभग तीन दिनों में चंद्रमा पर पहुंचे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astronauti Apolla stigli su do Mjeseca za otprilike tri dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apollo űrhajósai körülbelül három nap alatt érték el a Holdat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Astronot Apollo mencapai Bulan dalam waktu sekitar tiga hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli astronauti dell'Apollo raggiunsero la Luna in circa tre giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アポロ宇宙飛行士は約3日で月に到着した。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아폴로 우주비행사들은 약 3일 만에 달에 도착했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkasawan Apollo sampai ke Bulan dalam masa kira-kira tiga hari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apollo-astronauter nådde månen på omtrent tre dager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apollo-astronauten bereikten de maan in ongeveer drie dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Astronauci programu Apollo dotarli na Księżyc w ciągu około trzech dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os astronautas da Apollo chegaram à Lua em cerca de três dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os astronautas da Apollo chegaram à Lua em cerca de três dias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Astronauții Apollo au ajuns pe Lună în aproximativ trei zile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Астронавты Аполлона достигли Луны примерно за три дня."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Astronauti Apolla dosiahli Mesiac asi za tri dni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apollo-astronauter nådde månen på cirka tre dagar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นักบินอวกาศ Apollo ไปถึงดวงจันทร์ในเวลาประมาณสามวัน"
          }
        },
        "tr": {
          "stringUnit": {
