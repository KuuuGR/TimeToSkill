          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En klassisk verdensreise tar rundt åtti dager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een klassieke reis rond de wereld duurt ongeveer tachtig dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasyczna podróż dookoła świata trwa około osiemdziesięciu dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
