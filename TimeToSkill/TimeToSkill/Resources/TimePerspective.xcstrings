    "perspective.sirius.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light from Earth reaches Sirius in about 8.6 years."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصل الضوء من الأرض إلى سيريوس في حوالي 8.6 سنة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La llum de la Terra arriba a Sírius en uns 8,6 anys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Světlo ze Země dosáhne Sirius za asi 8,6 roku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lys fra Jorden når Sirius på omkring 8,6 år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht von der Erde erreicht Sirius in etwa 8,6 Jahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φως από τη Γη φτάνει στον Σείριο σε περίπου 8,6 χρόνια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz de la Tierra llega a Sirio en unos 8,6 años."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz de la Tierra llega a Sirio en unos 8,6 años."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maan valo saavuttaa Siriuksen noin 8,6 vuodessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière de la Terre atteint Sirius en 8,6 ans environ."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière de la Terre atteint Sirius en 8,6 ans environ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אור מכדור הארץ מגיע לסיריוס תוך כ-8.6 שנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पृथ्वी से प्रकाश सीरियस तक लगभग 8.6 वर्षों में पहुंचता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svjetlost sa Zemlje do Sirijusa stiže za oko 8,6 godina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Földről érkező fény körülbelül 8,6 év alatt éri el a Szíriust."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya dari Bumi mencapai Sirius dalam waktu sekitar 8,6 tahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce dalla Terra raggiunge Sirio in circa 8,6 anni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地球からの光は約8.6年かけてシリウスに到達します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지구에서 오는 빛은 약 8.6년 후에 시리우스에 도달합니다."
          }
        },
        "ms": {
          "stringUnit": {
