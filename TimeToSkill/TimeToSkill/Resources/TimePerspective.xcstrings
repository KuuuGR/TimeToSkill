    "perspective.jupiter_journey.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mission to Jupiter takes about five years."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستغرق المهمة إلى كوكب المشتري حوالي خمس سنوات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una missió a Júpiter dura uns cinc anys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise k Jupiteru trvá asi pět let."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En mission til Jupiter tager omkring fem år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mission zum Jupiter dauert etwa fünf Jahre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια αποστολή στον Δία διαρκεί περίπου πέντε χρόνια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una misión a Júpiter dura unos cinco años."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una misión a Júpiter dura unos cinco años."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Matka Jupiteriin kestää noin viisi vuotta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mission vers Jupiter dure environ cinq ans."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mission vers Jupiter dure environ cinq ans."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משימה ליופיטר אורכת כחמש שנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बृहस्पति पर एक मिशन में लगभग पांच साल लगते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Misija do Jupitera traje oko pet godina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Jupiterhez vezető küldetés körülbelül öt évig tart."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Misi ke Jupiter memakan waktu sekitar lima tahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una missione su Giove dura circa cinque anni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "木星へのミッションには約5年かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목성 탐사에는 약 5년이 걸립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Misi ke Musytari mengambil masa kira-kira lima tahun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et oppdrag til Jupiter tar omtrent fem år."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een missie naar Jupiter duurt ongeveer vijf jaar."
          }
        },
        "pl": {
          "stringUnit": {
