    "perspective.novel.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading an average novel takes about ten hours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستغرق قراءة الرواية المتوسطة حوالي عشر ساعات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La lectura d'una novel·la mitjana triga unes deu hores."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čtení průměrného románu trvá asi deset hodin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det tager i gennemsnit ti timer at læse en roman."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lesen eines Romans dauert durchschnittlich etwa zehn Stunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ανάγνωση ενός μέσου μυθιστορήματος διαρκεί περίπου δέκα ώρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer una novela media lleva unas diez horas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer una novela media lleva unas diez horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskimääräisen romaanin lukeminen kestää noin kymmenen tuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture d’un roman prend en moyenne une dizaine d’heures."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture d’un roman prend en moyenne une dizaine d’heures."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת רומן ממוצעת אורכת כעשר שעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक औसत उपन्यास पढ़ने में लगभग दस घंटे लगते हैं।"
          }
        },
