          "stringUnit": {
            "state": "translated",
            "value": "Joulukuusi kasvaa satokokoon noin viidessä vuodessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un arbre de Noël atteint sa taille de récolte en cinq ans environ."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un arbre de Noël atteint sa taille de récolte en cinq ans environ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עץ חג המולד גדל לגודל הקציר בעוד כחמש שנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक क्रिसमस पेड़ लगभग पाँच वर्षों में फसल के आकार का हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Božićno drvce naraste do žetvene veličine za oko pet godina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A karácsonyfa körülbelül öt év alatt éri be a termést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah pohon Natal tumbuh hingga mencapai ukuran panen dalam waktu sekitar lima tahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
