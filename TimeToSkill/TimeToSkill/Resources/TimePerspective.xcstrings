          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierta cualquier duración para descubrir comparaciones de tiempo del mundo real."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muunna mikä tahansa kesto löytääksesi reaaliaikaisia ​​vertailuja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertissez n'importe quelle durée pour découvrir des comparaisons de temps réels."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertissez n'importe quelle durée pour découvrir des comparaisons de temps réels."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המר כל משך זמן כדי לגלות השוואות זמן בעולם האמיתי."
