    "perspective.coconut_palm.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A coconut palm reaches full productivity after about thirty years."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصل نخلة جوز الهند إلى إنتاجيتها الكاملة بعد حوالي ثلاثين عامًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palmera de coco assoleix la productivitat total després d'uns trenta anys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plné produktivity dosáhne kokosová palma asi po třiceti letech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En kokospalme når fuld produktivitet efter omkring tredive år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kokospalme erreicht ihre volle Produktivität nach etwa dreißig Jahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας φοίνικας καρύδας φτάνει σε πλήρη παραγωγικότητα μετά από περίπου τριάντα χρόνια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palma de coco alcanza su plena productividad después de unos treinta años."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palma de coco alcanza su plena productividad después de unos treinta años."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kookospalmu saavuttaa täyden tuottavuuden noin kolmenkymmenen vuoden kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cocotier atteint sa pleine productivité au bout d’une trentaine d’années."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cocotier atteint sa pleine productivité au bout d’une trentaine d’années."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דקל קוקוס מגיע לתפוקה מלאה לאחר כשלושים שנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नारियल का ताड़ लगभग तीस वर्षों के बाद पूर्ण उत्पादकता तक पहुँचता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokosova palma postiže punu produktivnost nakon tridesetak godina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kókuszpálma körülbelül harminc év után éri el teljes termelékenységét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohon kelapa mencapai produktivitas penuh setelah sekitar tiga puluh tahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palma da cocco raggiunge la piena produttività dopo circa trent’anni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ココヤシは約 30 年後に完全な生産性を発揮します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코코넛 야자는 약 30년 후에 최대 생산성에 도달합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebatang kelapa mencapai produktiviti penuh selepas kira-kira tiga puluh tahun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En kokospalme når full produktivitet etter omtrent tretti år."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kokospalm bereikt na ongeveer dertig jaar zijn volledige productiviteit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Palma kokosowa osiąga pełną produktywność po około trzydziestu latach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O coqueiro atinge plena produtividade após cerca de trinta anos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O coqueiro atinge plena produtividade após cerca de trinta anos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un palmier de cocos atinge productivitatea maximă după aproximativ treizeci de ani."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кокосовая пальма достигает полной продуктивности примерно через тридцать лет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plnú produktivitu dosiahne kokosová palma asi po tridsiatich rokoch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kokospalm når full produktivitet efter cirka trettio år."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้นมะพร้าวจะมีผลผลิตเต็มที่หลังจากผ่านไปประมาณสามสิบปี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hindistancevizi hurması yaklaşık otuz yıl sonra tam verimliliğe ulaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кокосова пальма досягає повної продуктивності приблизно через тридцять років."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cây dừa đạt năng suất tối đa sau khoảng ba mươi năm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "椰子树大约三十年后才能达到完全生产力。"
          }
        },
        "zh-Hant": {
