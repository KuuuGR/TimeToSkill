    "perspective.slow_cooked_brisket.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow-cooking brisket takes about ten hours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق طهي لحم الصدر البطيء حوالي عشر ساعات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La costella de cocció lenta triga unes deu hores."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomalé vaření hrudí trvá asi deset hodin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsomt tilberedningsbryst tager omkring ti timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das langsame Garen von Rinderbrust dauert etwa zehn Stunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ψαρονέφρι αργού μαγειρέματος διαρκεί περίπου δέκα ώρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pechuga de cocción lenta tarda unas diez horas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La pechuga de cocción lenta tarda unas diez horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidas kypsennys kestää noin kymmenen tuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La poitrine de poitrine à cuisson lente prend environ dix heures."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La poitrine de poitrine à cuisson lente prend environ dix heures."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזה בבישול איטי לוקח כעשר שעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्रिस्केट को धीमी गति से पकाने में लगभग दस घंटे लगते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sporo kuhanje prsa traje oko deset sati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lassú főzésű szegy körülbelül tíz órát vesz igénybe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandung lamur yang dimasak perlahan membutuhkan waktu sekitar sepuluh jam."
          }
        },
        "it": {
