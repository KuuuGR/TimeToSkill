    "perspective.long_haul_flight.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A long-haul international flight often lasts about twelve hours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غالبًا ما تستغرق الرحلة الدولية الطويلة حوالي اثنتي عشرة ساعة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol internacional de llarg recorregut sovint dura unes dotze hores."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dálkový mezinárodní let často trvá kolem dvanácti hodin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En international langdistanceflyvning varer ofte omkring tolv timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein internationaler Langstreckenflug dauert oft etwa zwölf Stunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια διεθνής πτήση μεγάλων αποστάσεων συχνά διαρκεί περίπου δώδεκα ώρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vuelo internacional de larga distancia suele durar unas doce horas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vuelo internacional de larga distancia suele durar unas doce horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitkän matkan kansainvälinen lento kestää usein noin kaksitoista tuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol international long-courrier dure souvent environ douze heures."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol international long-courrier dure souvent environ douze heures."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיסה בינלאומית לטווח ארוך נמשכת לרוב כשתים עשרה שעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक लंबी दूरी की अंतरराष्ट्रीय उड़ान अक्सर लगभग बारह घंटे तक चलती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dugi međunarodni let često traje oko dvanaest sati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy hosszú távú nemzetközi járat gyakran körülbelül tizenkét óráig tart."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerbangan internasional jarak jauh sering kali memakan waktu sekitar dua belas jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un volo internazionale a lungo raggio dura spesso circa dodici ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長距離国際線の飛行時間は通常約 12 時間です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장거리 국제선 비행은 대개 12시간 정도 소요됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerbangan antarabangsa jarak jauh selalunya mengambil masa kira-kira dua belas jam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En langdistanse internasjonal flytur varer ofte rundt tolv timer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een internationale langeafstandsvlucht duurt vaak zo’n twaalf uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Międzynarodowy lot długodystansowy trwa często około dwunastu godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um voo internacional de longa distância geralmente dura cerca de doze horas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um voo internacional de longa distância geralmente dura cerca de doze horas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un zbor internațional pe distanță lungă durează adesea aproximativ douăsprezece ore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дальний международный рейс часто длится около двенадцати часов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Medzinárodný let na dlhé vzdialenosti často trvá približne dvanásť hodín."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En internationell långdistansflygning tar ofta cirka tolv timmar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เที่ยวบินระหว่างประเทศระยะไกลมักใช้เวลาประมาณสิบสองชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun mesafeli bir uluslararası uçuş genellikle yaklaşık on iki saat sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Далекий міжнародний рейс часто триває близько дванадцяти годин."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một chuyến bay quốc tế đường dài thường kéo dài khoảng mười hai giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长途国际航班通常持续约十二小时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長途國際航班通常持續約十二小時。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A long-haul international flight often lasts about twelve hours."
          }
        },
        "en-CA": {
          "stringUnit": {
