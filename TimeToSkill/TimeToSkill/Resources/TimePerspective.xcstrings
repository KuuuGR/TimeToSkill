            "state": "translated",
            "value": "Niagara Falls takes about fifty years to erode one meter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستغرق شلالات نياجرا حوالي خمسين عامًا لتتآكل مترًا واحدًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cascades del Niàgara triguen uns cinquanta anys a erosionar-se un metre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Niagarským vodopádům trvá asi padesát let, než erodují jeden metr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Niagara Falls tager omkring halvtreds år at erodere en meter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es dauert etwa fünfzig Jahre, bis die Niagarafälle einen Meter abgetragen haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι καταρράκτες του Νιαγάρα χρειάζονται περίπου πενήντα χρόνια για να διαβρωθούν ένα μέτρο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Cataratas del Niágara tardan unos cincuenta años en erosionarse un metro."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Cataratas del Niágara tardan unos cincuenta años en erosionarse un metro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Niagaran putouksella kuluu noin 50 vuotta yhden metrin syöpymiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chutes du Niagara mettent environ cinquante ans pour s'éroder d'un mètre."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chutes du Niagara mettent environ cinquante ans pour s'éroder d'un mètre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למפלי הניאגרה לוקח כחמישים שנה לשחוק מטר אחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियाग्रा फॉल्स को एक मीटर नष्ट होने में लगभग पचास साल लगते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slapovima Niagare potrebno je oko pedeset godina da erodiraju jedan metar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Niagara-vízesés körülbelül ötven évig tart egy méter erodálásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Air Terjun Niagara membutuhkan waktu sekitar lima puluh tahun untuk mengikis satu meternya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Cascate del Niagara impiegano circa cinquant'anni per erodere un metro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナイアガラの滝は1メートル浸食されるのに約50年かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나이아가라 폭포가 1m를 침식하는 데 약 50년이 걸립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Air Terjun Niagara mengambil masa kira-kira lima puluh tahun untuk menghakis satu meter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Niagara Falls tar omtrent femti år å erodere en meter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het duurt ongeveer vijftig jaar voordat de Niagarawatervallen één meter eroderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wodospad Niagara potrzebuje około pięćdziesięciu lat, aby zniszczyć jeden metr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As Cataratas do Niágara levam cerca de cinquenta anos para sofrer erosão de um metro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
