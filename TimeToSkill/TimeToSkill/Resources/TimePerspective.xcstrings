    "perspective.sunlight_neptune.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light from the Sun reaches Neptune in about 4 hours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصل ضوء الشمس إلى نبتون في حوالي 4 ساعات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La llum del Sol arriba a Neptú en unes 4 hores."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Světlo ze Slunce dosáhne Neptun asi za 4 hodiny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lys fra Solen når Neptun på omkring 4 timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Licht der Sonne erreicht Neptun in etwa 4 Stunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φως από τον Ήλιο φτάνει στον Ποσειδώνα σε περίπου 4 ώρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz del Sol llega a Neptuno en unas 4 horas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz del Sol llega a Neptuno en unas 4 horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auringosta tuleva valo saavuttaa Neptunuksen noin 4 tunnissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière du Soleil atteint Neptune en 4 heures environ."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière du Soleil atteint Neptune en 4 heures environ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אור השמש מגיע לנפטון תוך כ-4 שעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूर्य का प्रकाश नेपच्यून तक लगभग 4 घंटे में पहुंचता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunčeva svjetlost stiže do Neptuna za oko 4 sata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Nap fénye körülbelül 4 óra alatt éri el a Neptunust."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya dari Matahari mencapai Neptunus dalam waktu sekitar 4 jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce del Sole raggiunge Nettuno in circa 4 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "太陽からの光は約4時間で海王星に到達します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태양의 빛은 약 4시간 만에 해왕성에 도달합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya dari Matahari mencapai Neptun dalam masa kira-kira 4 jam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyset fra solen når Neptun på omtrent 4 timer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het licht van de zon bereikt Neptunus in ongeveer 4 uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Światło ze Słońca dociera do Neptuna w ciągu około 4 godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz do Sol atinge Netuno em cerca de 4 horas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz do Sol atinge Netuno em cerca de 4 horas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumina de la Soare ajunge la Neptun în aproximativ 4 ore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свет Солнца достигает Нептуна примерно за 4 часа."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Svetlo zo Slnka dosiahne Neptún asi za 4 hodiny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljus från solen når Neptunus på cirka 4 timmar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสงจากดวงอาทิตย์มาถึงดาวเนปจูนในเวลาประมาณ 4 ชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneş'ten gelen ışık Neptün'e yaklaşık 4 saatte ulaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Світло від Сонця досягає Нептуна приблизно за 4 години."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ánh sáng từ Mặt trời tới Sao Hải Vương trong khoảng 4 giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自太阳的光大约在 4 小时内到达海王星。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自太陽的光線大約在 4 小時內到達海王星。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Light from the Sun reaches Neptune in about 4 hours."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Light from the Sun reaches Neptune in about 4 hours."
          }
        },
        "en-GB": {
