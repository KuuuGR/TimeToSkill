        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A skót whiskynek legalább három évig kell érlelnie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiski Scotch harus matang setidaknya selama tiga tahun."
