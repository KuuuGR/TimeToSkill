    "perspective.sleep.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting a healthy night's sleep lasts about eight hours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحصول على ليلة نوم صحية تدوم حوالي ثماني ساعات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aconseguir una nit de son saludable dura unes vuit hores."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdravý spánek trvá asi osm hodin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At få en sund nattesøvn varer omkring otte timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gesunde Nachtruhe dauert etwa acht Stunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο υγιεινός νυχτερινός ύπνος διαρκεί περίπου οκτώ ώρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormir bien por la noche dura unas ocho horas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormir bien por la noche dura unas ocho horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Terveet yöunet kestävät noin kahdeksan tuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bonne nuit de sommeil dure environ huit heures."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bonne nuit de sommeil dure environ huit heures."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שנת לילה בריאה נמשכת כשמונה שעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रात की स्वस्थ नींद लगभग आठ घंटे तक चलती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdravi noćni san traje oko osam sati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egészséges éjszakai alvás körülbelül nyolc óráig tart."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mendapatkan tidur malam yang sehat berlangsung sekitar delapan jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottenere una notte di sonno salutare dura circa otto ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "健康的な夜の睡眠は約 8 時間続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강한 밤의 수면은 약 8시간 동안 지속됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mendapat tidur malam yang sihat berlangsung kira-kira lapan jam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å få en sunn natts søvn varer omtrent åtte timer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gezonde nachtrust duurt ongeveer acht uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdrowy sen trwa około ośmiu godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ter uma noite de sono saudável dura cerca de oito horas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ter uma noite de sono saudável dura cerca de oito horas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Obținerea unui somn sănătos durează aproximativ opt ore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здоровый ночной сон длится около восьми часов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdravý spánok trvá približne osem hodín."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att få en hälsosam nattsömn varar ungefär åtta timmar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนอนหลับอย่างมีสุขภาพที่ดีจะใช้เวลาประมาณแปดชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlıklı bir gece uykusu almak yaklaşık sekiz saat sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Здоровий нічний сон триває близько восьми годин."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có được một giấc ngủ đêm lành mạnh kéo dài khoảng tám giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "晚上健康的睡眠大约需要八个小时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "晚上健康的睡眠大約需要八個小時。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting a healthy night's sleep lasts about eight hours."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting a healthy night's sleep lasts about eight hours."
          }
        },
        "en-GB": {
          "stringUnit": {
