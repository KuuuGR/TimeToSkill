          "stringUnit": {
            "state": "translated",
            "value": "Un vuelo turístico en helicóptero suele durar unas dos horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiertoajeluhelikopterilento kestää yleensä noin kaksi tuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol touristique en hélicoptère dure généralement environ deux heures."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol touristique en hélicoptère dure généralement environ deux heures."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיסת מסוק תיירות נמשכת בדרך כלל כשעתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक दर्शनीय स्थल हेलीकाप्टर की उड़ान आमतौर पर लगभग दो घंटे तक चलती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Let helikopterom za razgledavanje obično traje oko dva sata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy városnéző helikopter repülés általában körülbelül két óráig tart."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerbangan helikopter tamasya biasanya memakan waktu sekitar dua jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un volo panoramico in elicottero dura solitamente circa due ore."
          }
