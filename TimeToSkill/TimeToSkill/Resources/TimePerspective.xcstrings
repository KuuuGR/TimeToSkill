    "perspective.hard_boiled_egg.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hard-boiled egg is ready in about ten minutes."
          }
        },
        "ar": {
          "stringUnit": {
