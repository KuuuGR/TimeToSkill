    "perspective.cycling_adventure.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A two-week cycling tour can cross an entire country."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لجولة ركوب الدراجات لمدة أسبوعين أن تعبر دولة بأكملها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recorregut en bicicleta de dues setmanes pot travessar tot un país."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvoutýdenní cyklistický výlet může projet celou zemi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En to-ugers cykeltur kan krydse et helt land."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine zweiwöchige Radtour kann ein ganzes Land durchqueren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ποδηλατική περιήγηση δύο εβδομάδων μπορεί να διασχίσει μια ολόκληρη χώρα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recorrido en bicicleta de dos semanas puede atravesar un país entero."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recorrido en bicicleta de dos semanas puede atravesar un país entero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kahden viikon pyöräretkellä voi ylittää koko maan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voyage à vélo de deux semaines peut traverser tout un pays."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voyage à vélo de deux semaines peut traverser tout un pays."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיול אופניים של שבועיים יכול לחצות מדינה שלמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो सप्ताह की साइकिल यात्रा पूरे देश को पार कर सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvotjedna biciklistička tura može prijeći cijelu zemlju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy kéthetes kerékpártúra egy egész országot bejárhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tur bersepeda selama dua minggu dapat melintasi seluruh negara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour in bicicletta di due settimane può attraversare un intero paese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 週間のサイクリング ツアーでは国全体を横断できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2주간의 자전거 여행은 전국을 횡단할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawatan berbasikal selama dua minggu boleh merentasi seluruh negara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En to ukers sykkeltur kan krysse et helt land."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een fietstocht van twee weken kun je een heel land doorkruisen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwutygodniowa wycieczka rowerowa może przejechać cały kraj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um passeio de bicicleta de duas semanas pode atravessar um país inteiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um passeio de bicicleta de duas semanas pode atravessar um país inteiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tur de două săptămâni cu bicicleta poate traversa o țară întreagă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двухнедельный велотур может пересечь всю страну."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojtýždňová cyklotúra môže prejsť celú krajinu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En två veckor lång cykeltur kan korsa ett helt land."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทัวร์ปั่นจักรยานสองสัปดาห์สามารถข้ามทั้งประเทศได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki haftalık bir bisiklet turu bütün bir ülkeyi geçebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двотижневий велосипедний тур може перетнути всю країну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một chuyến đi xe đạp kéo dài hai tuần có thể đi qua cả một đất nước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两周的自行车旅行可以穿越整个国家。"
          }
        },
