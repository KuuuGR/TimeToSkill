    "perspective.wheat_harvest.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wheat grows from seed to harvest in about four months."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينمو القمح من البذرة إلى الحصاد في حوالي أربعة أشهر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El blat creix des de la llavor fins a la collita en uns quatre mesos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pšenice vyroste ze semene do sklizně asi za čtyři měsíce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvede vokser fra frø til høst på omkring fire måneder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weizen wächst vom Samen bis zur Ernte in etwa vier Monaten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σιτάρι μεγαλώνει από το σπόρο μέχρι τη συγκομιδή σε περίπου τέσσερις μήνες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trigo crece desde la semilla hasta la cosecha en unos cuatro meses."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El trigo crece desde la semilla hasta la cosecha en unos cuatro meses."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vehnä kasvaa siemenestä satoon noin neljässä kuukaudessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le blé pousse de la graine à la récolte en quatre mois environ."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le blé pousse de la graine à la récolte en quatre mois environ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיטה צומחת מזרע לבציר תוך כארבעה חודשים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेहूं बीज से कटाई तक लगभग चार महीने में उगता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pšenica naraste od sjemena do žetve za oko četiri mjeseca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A búza a magtól a betakarításig körülbelül négy hónap alatt nő."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gandum tumbuh dari biji hingga panen dalam waktu sekitar empat bulan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il grano passa dal seme al raccolto in circa quattro mesi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小麦は種から収穫まで約4か月かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밀은 씨앗부터 수확까지 약 4개월 동안 자랍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gandum tumbuh dari biji hingga dituai dalam masa kira-kira empat bulan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvete vokser fra frø til høsting på omtrent fire måneder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarwe groeit in ongeveer vier maanden van zaad tot oogst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pszenica rośnie od nasion do zbiorów w ciągu około czterech miesięcy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O trigo cresce da semente à colheita em cerca de quatro meses."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O trigo cresce da semente à colheita em cerca de quatro meses."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Grâul crește de la sămânță până la recoltare în aproximativ patru luni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пшеница вырастает от семян до урожая примерно за четыре месяца."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pšenica vyrastie zo semena do zberu asi za štyri mesiace."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vete växer från frö till skörd på cirka fyra månader."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้าวสาลีเติบโตตั้งแต่เมล็ดจนถึงเก็บเกี่ยวในเวลาประมาณสี่เดือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buğday tohumdan hasada kadar yaklaşık dört ayda yetişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пшениця росте від насіння до врожаю приблизно за чотири місяці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúa mì phát triển từ hạt đến khi thu hoạch trong khoảng bốn tháng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小麦从播种到收获大约需要四个月的时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
