    "perspective.gamma_cephei.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei naturally becomes Earth's North Star over time."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وبطبيعة الحال، تصبح جاما سيفي هي نجمة الشمال للأرض بمرور الوقت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei es converteix de manera natural en l'estrella polar de la Terra amb el temps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei se postupem času přirozeně stává Polární hvězdou Země."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei bliver naturligt Jordens Nordstjerne med tiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei wird im Laufe der Zeit auf natürliche Weise zum Nordstern der Erde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Gamma Cephei γίνεται φυσικά ο Βόρειος Αστέρας της Γης με την πάροδο του χρόνου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei se convierte naturalmente en la Estrella Polar de la Tierra con el tiempo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei se convierte naturalmente en la Estrella Polar de la Tierra con el tiempo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cepheistä tulee luonnollisesti Maan Pohjantähti ajan myötä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei devient naturellement l'étoile polaire de la Terre au fil du temps."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei devient naturellement l'étoile polaire de la Terre au fil du temps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei הופך באופן טבעי לכוכב הצפון של כדור הארץ עם הזמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गामा सेफेई समय के साथ स्वाभाविक रूप से पृथ्वी का उत्तरी सितारा बन जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei s vremenom prirodno postaje Zemljina zvijezda Sjevernjača."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gamma Cephei idővel természetesen a Föld északi csillagává válik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei secara alami menjadi Bintang Utara Bumi seiring berjalannya waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei diventa naturalmente la stella polare della Terra nel tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガンマ・ケファイは時間が経つと自然に地球の北極星になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감마 세페이드는 시간이 지나면 자연스럽게 지구의 북극성이 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei secara semula jadi menjadi Bintang Utara Bumi dari semasa ke semasa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei blir naturlig jordens nordstjerne over tid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei wordt in de loop van de tijd op natuurlijke wijze de Noordster van de aarde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei z biegiem czasu w naturalny sposób staje się Gwiazdą Północną Ziemi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei naturalmente se torna a Estrela do Norte da Terra com o tempo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei naturalmente se torna a Estrela do Norte da Terra com o tempo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei devine în mod natural Steaua Polară a Pământului în timp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гамма Цефеи естественным образом со временем становится Полярной звездой Земли."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei sa postupom času prirodzene stáva Polárkou Zeme."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei blir naturligt jordens nordstjärna med tiden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แกมมา เซเฟย์กลายเป็นดาวเหนือของโลกตามธรรมชาติเมื่อเวลาผ่านไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei zamanla doğal olarak Dünya'nın Kuzey Yıldızı olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гамма Цефей природним чином з часом стає Полярною зіркою Землі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamma Cephei tự nhiên trở thành Sao Bắc Đẩu của Trái đất theo thời gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随着时间的推移，仙王座伽马自然而然地成为地球的北极星。"
          }
        },
        "zh-Hant": {
