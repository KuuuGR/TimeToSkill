    "perspective.shinkansen.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A high-speed bullet train journey covers immense regional distances."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغطي رحلة القطار فائق السرعة مسافات إقليمية هائلة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viatge en tren bala d'alta velocitat cobreix distàncies regionals immenses."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cesta vysokorychlostním kulovým vlakem pokrývá obrovské regionální vzdálenosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En rejse med højhastighedstog dækker enorme regionale afstande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Fahrt mit dem Hochgeschwindigkeitszug überwindet riesige regionale Entfernungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα ταξίδι με τρένο υψηλής ταχύτητας καλύπτει τεράστιες περιφερειακές αποστάσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaje en tren bala de alta velocidad cubre inmensas distancias regionales."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaje en tren bala de alta velocidad cubre inmensas distancias regionales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopea luotijunamatka kattaa valtavia alueellisia etäisyyksiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voyage en train à grande vitesse couvre d’immenses distances régionales."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voyage en train à grande vitesse couvre d’immenses distances régionales."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסיעה ברכבת כדורי במהירות גבוהה מכסה מרחקים אזוריים עצומים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाई-स्पीड बुलेट ट्रेन यात्रा विशाल क्षेत्रीय दूरियाँ तय करती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Putovanje brzim brzim vlakom pokriva goleme regionalne udaljenosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nagysebességű golyósvonat hatalmas regionális távolságokat tesz meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perjalanan kereta peluru berkecepatan tinggi mencakup jarak regional yang sangat jauh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaggio in treno ad alta velocità copre immense distanze regionali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高速新幹線の旅は、地域内の膨大な距離をカバーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고속 초고속 열차 여행은 엄청난 지역적 거리를 커버합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perjalanan kereta api peluru berkelajuan tinggi meliputi jarak serantau yang jauh."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En høyhastighets kuletogreise dekker enorme regionale avstander."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een hogesnelheidstreinreis bestrijkt enorme regionale afstanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podróż szybkim pociągiem pociskowym pokonuje ogromne odległości regionalne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma viagem de trem-bala de alta velocidade cobre imensas distâncias regionais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma viagem de trem-bala de alta velocidade cobre imensas distâncias regionais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O călătorie cu trenul glonț de mare viteză acoperă distanțe regionale imense."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Путешествие на скоростном поезде преодолевает огромные региональные расстояния."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cesta vysokorýchlostným vlakom pokryje obrovské regionálne vzdialenosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En resa med höghastighetståg täcker enorma regionala avstånd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเดินทางด้วยรถไฟหัวกระสุนความเร็วสูงครอบคลุมระยะทางอันกว้างใหญ่ในภูมิภาค"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek hızlı bir hızlı tren yolculuğu, çok büyük bölgesel mesafeleri kapsar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подорож високошвидкісного поїзда-кулі долає величезні регіональні відстані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hành trình bằng tàu cao tốc bao phủ khoảng cách rộng lớn trong khu vực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高速子弹头列车旅程覆盖了广阔的区域距离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高速子彈列車旅程覆蓋了廣闊的區域距離。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A high-speed bullet train journey covers immense regional distances."
          }
        },
        "en-CA": {
