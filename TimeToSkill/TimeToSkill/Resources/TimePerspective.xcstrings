    "perspective.coast_to_coast.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Driving across a major continental landmass takes about five days."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستغرق القيادة عبر مساحة أرضية قارية كبيرة حوالي خمسة أيام."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Conduir a través d'una massa continental important triga uns cinc dies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jízda přes hlavní kontinentální pevninu trvá asi pět dní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At køre på tværs af en stor kontinental landmasse tager omkring fem dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fahrt über eine große kontinentale Landmasse dauert etwa fünf Tage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οδήγηση σε μια μεγάλη ηπειρωτική ξηρά διαρκεί περίπου πέντε ημέρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conducir a través de una gran masa continental lleva unos cinco días."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Conducir a través de una gran masa continental lleva unos cinco días."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajaminen suuren mannermaisen maan yli kestää noin viisi päivää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traverser une grande masse continentale prend environ cinq jours."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Traverser une grande masse continentale prend environ cinq jours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסיעה על פני שטח יבשתי גדול נמשכת כחמישה ימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक प्रमुख महाद्वीपीय भूभाग पर गाड़ी चलाने में लगभग पाँच दिन लगते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vožnja preko velike kontinentalne mase traje oko pet dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az autózás egy nagy kontinentális szárazföldön körülbelül öt napig tart."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkendara melintasi daratan kontinental besar membutuhkan waktu sekitar lima hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guidare attraverso una grande massa continentale richiede circa cinque giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主要な大陸陸地を車で横断するには約 5 日かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주요 대륙을 횡단하는 데는 약 5일이 걸립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memandu merentasi daratan besar benua mengambil masa kira-kira lima hari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å kjøre over en stor kontinental landmasse tar omtrent fem dager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het rijden over een grote continentale landmassa duurt ongeveer vijf dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podróż przez duży kontynent kontynentalny zajmuje około pięciu dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirigir por uma grande massa continental leva cerca de cinco dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirigir por uma grande massa continental leva cerca de cinco dias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conducerea printr-o masă continentală majoră durează aproximativ cinci zile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездка по крупному континентальному массиву занимает около пяти дней."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazda cez veľkú kontinentálnu pevninu trvá asi päť dní."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att köra över en stor kontinental landmassa tar cirka fem dagar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การขับรถข้ามทวีปที่สำคัญจะใช้เวลาประมาณห้าวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük bir kıtasal kara kütlesini geçmek yaklaşık beş gün sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поїздка через велику континентальну сушу займає близько п’яти днів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lái xe qua một lục địa lớn mất khoảng năm ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "驾车穿越主要大陆大约需要五天时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "駕車穿越主要大陸大約需要五天。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Driving across a major continental landmass takes about five days."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Driving across a major continental landmass takes about five days."
          }
        },
        "en-GB": {
          "stringUnit": {
