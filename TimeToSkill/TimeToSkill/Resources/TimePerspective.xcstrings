    "perspective.bread_dough.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bread dough usually rises in about one hour."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادة ما ترتفع عجينة الخبز خلال ساعة واحدة تقريبًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La massa de pa sol pujar en una hora aproximadament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chlebové těsto obvykle kyne asi za hodinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brøddej hæver normalt på cirka en time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brotteig geht normalerweise in etwa einer Stunde auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ζύμη του ψωμιού συνήθως φουσκώνει σε περίπου μία ώρα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La masa de pan suele crecer en aproximadamente una hora."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La masa de pan suele crecer en aproximadamente una hora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leipätaikina kohoaa yleensä noin tunnissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pâte à pain lève généralement en une heure environ."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La pâte à pain lève généralement en une heure environ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בצק לחם תופח בדרך כלל תוך כשעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्रेड का आटा आमतौर पर लगभग एक घंटे में फूल जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijesto za kruh obično se diže za oko jedan sat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kenyértészta általában körülbelül egy óra alatt megkel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Adonan roti biasanya mengembang dalam waktu sekitar satu jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'impasto del pane solitamente lievita in circa un'ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パン生地は通常1時間ほどで発酵します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빵 반죽은 보통 한 시간 정도 지나면 부풀어 오른다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Doh roti biasanya naik lebih kurang satu jam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brøddeig hever vanligvis i løpet av en time."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brooddeeg rijst meestal in ongeveer een uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciasto chlebowe zwykle rośnie w ciągu około godziny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A massa do pão geralmente cresce em cerca de uma hora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A massa do pão geralmente cresce em cerca de uma hora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aluatul de pâine crește de obicei în aproximativ o oră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тесто для хлеба обычно поднимается примерно за час."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chlebové cesto zvyčajne kysne asi za hodinu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bröddegen jäser vanligtvis på cirka en timme."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แป้งขนมปังมักจะขึ้นในเวลาประมาณหนึ่งชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekmek hamuru genellikle yaklaşık bir saat içinde kabarır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хлібне тісто зазвичай піднімається приблизно за годину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bột bánh mì thường nở trong khoảng một giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面团通常在一小时左右发酵。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麵團通常在一小時左右發酵。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Bread dough usually rises in about one hour."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Bread dough usually rises in about one hour."
          }
        },
        "en-GB": {
