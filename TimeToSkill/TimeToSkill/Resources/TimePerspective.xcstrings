    "perspective.kangaroo_joey.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A kangaroo joey leaves its mother's pouch after about five months."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يترك الكنغر كيس أمه بعد حوالي خمسة أشهر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cangur joey deixa la bossa de la seva mare després d'uns cinc mesos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokan joey asi po pěti měsících opustí matčin vak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En kænguru-joey forlader sin mors pose efter omkring fem måneder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Känguruh verlässt den Beutel seiner Mutter nach etwa fünf Monaten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα καγκουρό joey αφήνει το πουγκί της μητέρας του μετά από περίπου πέντε μήνες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un canguro joey abandona la bolsa de su madre después de unos cinco meses."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un canguro joey abandona la bolsa de su madre después de unos cinco meses."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kengurujoey jättää äitinsä pussin noin viiden kuukauden kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bébé kangourou quitte la poche de sa mère après environ cinq mois."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bébé kangourou quitte la poche de sa mère après environ cinq mois."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ג'ואי קנגורו עוזב את הכיס של אמו לאחר כחמישה חודשים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक कंगारू जॉय लगभग पाँच महीने के बाद अपनी माँ की थैली छोड़ देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokan Joey napušta majčinu vreću nakon otprilike pet mjeseci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kenguru joey körülbelül öt hónap után elhagyja anyja táskáját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seekor kanguru joey meninggalkan kantong induknya setelah sekitar lima bulan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un canguro lascia il marsupio della madre dopo circa cinque mesi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンガルージョーイは約5か月後に母親の袋から出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조이 캥거루는 약 5개월 후에 어미 주머니에서 나옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seekor kanggaru joey meninggalkan kantung ibunya selepas kira-kira lima bulan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En kenguru-joey forlater sin mors pose etter omtrent fem måneder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kangoeroe-joey verlaat na ongeveer vijf maanden de buidel van zijn moeder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kangur joey opuszcza worek matki po około pięciu miesiącach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um canguru deixa a bolsa da mãe depois de cerca de cinco meses."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um canguru deixa a bolsa da mãe depois de cerca de cinco meses."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cangur joey părăsește punga mamei sale după aproximativ cinci luni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кенгуру покидает сумку матери примерно через пять месяцев."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kengura joey asi po piatich mesiacoch opustí vačok svojej matky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kängurujoey lämnar sin mammas påse efter cirka fem månader."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จิงโจ้โจอี้ออกจากกระเป๋าของแม่หลังจากผ่านไปประมาณห้าเดือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kanguru yavrusu yaklaşık beş ay sonra annesinin kesesinden ayrılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кенгуру Джоуї залишає сумку своєї матері приблизно через п'ять місяців."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kangaroo Joey rời khỏi túi mẹ sau khoảng 5 tháng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大约五个月后，袋鼠幼崽就会离开母亲的育儿袋。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大約五個月後，袋鼠幼崽就會離開母親的育兒袋。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A kangaroo joey leaves its mother's pouch after about five months."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A kangaroo joey leaves its mother's pouch after about five months."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A kangaroo joey leaves its mother's pouch after about five months."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "A kangaroo joey leaves its mother's pouch after about five months."
          }
        }
      }
    },
