        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons a ajuns la Pluto în aproximativ nouă ani și jumătate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Новые горизонты» достигли Плутона примерно за девять с половиной лет."
          }
        },
        "sk": {
          "stringUnit": {
