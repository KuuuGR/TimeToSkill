    "perspective.blue_whale_calf.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A blue whale calf is usually weaned after about one year."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادة ما يتم فطام صغير الحوت الأزرق بعد حوالي عام واحد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vedell de balena blava se sol deslletar després d'un any aproximadament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mládě modré velryby je obvykle odstaveno přibližně po jednom roce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En blåhvalkalv vænnes normalt fra efter cirka et år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Blauwalkalb wird normalerweise nach etwa einem Jahr entwöhnt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα μοσχάρι μπλε φάλαινας συνήθως απογαλακτίζεται μετά από περίπου ένα χρόνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cría de ballena azul suele ser destetada al cabo de aproximadamente un año."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cría de ballena azul suele ser destetada al cabo de aproximadamente un año."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinivalasvasikka vieroitetaan yleensä noin vuoden kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un baleineau bleu est généralement sevré après environ un an."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un baleineau bleu est généralement sevré après environ un an."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עגל לווייתן כחול נגמל בדרך כלל לאחר כשנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लू व्हेल का बछड़ा आमतौर पर लगभग एक वर्ष के बाद दूध छुड़ा देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mladunče plavog kita obično se odbija od sise nakon otprilike godinu dana."
          }
        },
