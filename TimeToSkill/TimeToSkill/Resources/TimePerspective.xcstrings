        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wolno gotowanie mostka zajmuje około dziesięciu godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O peito de cozimento lento leva cerca de dez horas."
