            "state": "translated",
            "value": "Lys fra Jorden når Sirius på omtrent 8,6 år."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht van de aarde bereikt Sirius in ongeveer 8,6 jaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Światło z Ziemi dociera do Syriusza w ciągu około 8,6 lat."
          }
        },
        "pt-BR": {
          "stringUnit": {
