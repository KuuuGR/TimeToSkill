    "time_perspective.card.empty_prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert any duration to discover real-world time comparisons."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحويل أي مدة لاكتشاف مقارنات زمنية في العالم الحقيقي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Converteix qualsevol durada per descobrir comparacions en temps real."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Převeďte libovolnou dobu trvání, abyste objevili srovnání času v reálném světě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Konverter enhver varighed for at finde sammenligninger i den virkelige verden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konvertieren Sie eine beliebige Dauer, um reale Zeitvergleiche zu erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετατρέψτε οποιαδήποτε διάρκεια για να ανακαλύψετε συγκρίσεις σε πραγματικό χρόνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
