    "perspective.milky_way_center.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light from Earth reaches the center of the Milky Way in about 26,000 years."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصل الضوء من الأرض إلى مركز درب التبانة في حوالي 26000 سنة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La llum de la Terra arriba al centre de la Via Làctia en uns 26.000 anys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Světlo ze Země dosáhne středu Mléčné dráhy asi za 26 000 let."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lys fra Jorden når Mælkevejens centrum på omkring 26.000 år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Licht der Erde erreicht in etwa 26.000 Jahren das Zentrum der Milchstraße."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φως από τη Γη φτάνει στο κέντρο του Γαλαξία σε περίπου 26.000 χρόνια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz de la Tierra llega al centro de la Vía Láctea en unos 26.000 años."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz de la Tierra llega al centro de la Vía Láctea en unos 26.000 años."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maapallolta tuleva valo saavuttaa Linnunradan keskuksen noin 26 000 vuodessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière provenant de la Terre atteint le centre de la Voie lactée en 26 000 ans environ."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière provenant de la Terre atteint le centre de la Voie lactée en 26 000 ans environ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אור מכדור הארץ מגיע למרכז שביל החלב בעוד כ-26,000 שנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पृथ्वी से प्रकाश आकाशगंगा के केंद्र तक लगभग 26,000 वर्षों में पहुंचता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svjetlo sa Zemlje do središta Mliječne staze stiže za oko 26 000 godina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Földről érkező fény körülbelül 26 000 év alatt éri el a Tejútrendszer középpontját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya dari Bumi mencapai pusat Bima Sakti dalam waktu sekitar 26.000 tahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce proveniente dalla Terra raggiunge il centro della Via Lattea in circa 26.000 anni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地球からの光は約 26,000 年かけて天の川の中心に到達します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지구에서 나오는 빛은 약 26,000년 만에 은하수 중심에 도달합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya dari Bumi mencapai pusat Bima Sakti dalam kira-kira 26,000 tahun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lys fra Jorden når sentrum av Melkeveien på omtrent 26 000 år."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht van de aarde bereikt het centrum van de Melkweg over ongeveer 26.000 jaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Światło z Ziemi dociera do centrum Drogi Mlecznej po około 26 000 lat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz da Terra atinge o centro da Via Láctea em cerca de 26.000 anos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz da Terra atinge o centro da Via Láctea em cerca de 26.000 anos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumina de pe Pământ ajunge în centrul Căii Lactee în aproximativ 26.000 de ani."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свет Земли достигает центра Млечного Пути примерно за 26 000 лет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Svetlo zo Zeme dosiahne stred Mliečnej dráhy asi za 26 000 rokov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljus från jorden når mitten av Vintergatan på cirka 26 000 år."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสงจากโลกมาถึงใจกลางทางช้างเผือกในเวลาประมาณ 26,000 ปี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünya'dan gelen ışık Samanyolu'nun merkezine yaklaşık 26.000 yılda ulaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Світло від Землі досягає центру Чумацького Шляху приблизно за 26 000 років."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ánh sáng từ Trái đất đến trung tâm Dải Ngân hà trong khoảng 26.000 năm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自地球的光大约需要 26,000 年才能到达银河系中心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自地球的光大約需要 26,000 年才能到達銀河系中心。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Light from Earth reaches the center of the Milky Way in about 26,000 years."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Light from Earth reaches the center of the Milky Way in about 26,000 years."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Light from Earth reaches the center of the Milky Way in about 26,000 years."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Light from Earth reaches the center of the Milky Way in about 26,000 years."
          }
        }
      }
    },
