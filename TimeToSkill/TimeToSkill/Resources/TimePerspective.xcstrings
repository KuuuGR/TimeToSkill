    "perspective.solar_system_edge.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 reached the edge of the Solar System after about thirty-five years."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت فوييجر 1 إلى حافة النظام الشمسي بعد حوالي خمسة وثلاثين عامًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La Voyager 1 va arribar a la vora del Sistema Solar després d'uns trenta-cinc anys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 dosáhl okraje Sluneční soustavy asi po pětatřiceti letech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 nåede kanten af ​​solsystemet efter omkring femogtredive år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 erreichte nach etwa 35 Jahren den Rand des Sonnensystems."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Voyager 1 έφτασε στην άκρη του Ηλιακού Συστήματος μετά από περίπου τριάντα πέντε χρόνια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Voyager 1 llegó al borde del Sistema Solar después de unos treinta y cinco años."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La Voyager 1 llegó al borde del Sistema Solar después de unos treinta y cinco años."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 saavutti aurinkokunnan reunan noin 35 vuoden kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 a atteint les limites du système solaire après environ trente-cinq ans."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 a atteint les limites du système solaire après environ trente-cinq ans."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "וויאג'ר 1 הגיעה לקצה מערכת השמש לאחר כשלושים וחמש שנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वायेजर 1 लगभग पैंतीस वर्षों के बाद सौर मंडल के किनारे पर पहुंचा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 stigao je do ruba Sunčevog sustava nakon otprilike trideset i pet godina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Voyager 1 körülbelül harmincöt év után érte el a Naprendszer peremét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 mencapai tepi Tata Surya setelah sekitar tiga puluh lima tahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Voyager 1 raggiunse i confini del Sistema Solare dopo circa trentacinque anni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボイジャー1号は約35年をかけて太陽系の端に到達した。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보이저 1호는 약 35년 만에 태양계 가장자리에 도달했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 mencapai pinggir Sistem Suria selepas kira-kira tiga puluh lima tahun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 nådde kanten av solsystemet etter omtrent trettifem år."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 bereikte na ongeveer vijfendertig jaar de rand van het zonnestelsel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 dotarł do krawędzi Układu Słonecznego po około trzydziestu pięciu latach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Voyager 1 alcançou o limite do Sistema Solar após cerca de trinta e cinco anos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Voyager 1 alcançou o limite do Sistema Solar após cerca de trinta e cinco anos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 a ajuns la marginea Sistemului Solar după aproximativ treizeci și cinci de ani."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Вояджер-1» достиг края Солнечной системы примерно через тридцать пять лет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 dosiahol okraj slnečnej sústavy asi po tridsiatich piatich rokoch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 nådde kanten av solsystemet efter cirka trettiofem år."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยานโวเอเจอร์ 1 มาถึงขอบของระบบสุริยะในเวลาประมาณสามสิบห้าปี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 yaklaşık otuz beş yıl sonra Güneş Sisteminin sınırına ulaştı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Вояджер-1\" досяг краю Сонячної системи приблизно через тридцять п'ять років."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà du hành 1 đã đến rìa Hệ Mặt trời sau khoảng 35 năm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "航行者一号在大约三十五年后到达了太阳系的边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "航行者一號在大約三十五年後到達了太陽系的邊緣。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 reached the edge of the Solar System after about thirty-five years."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 reached the edge of the Solar System after about thirty-five years."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 reached the edge of the Solar System after about thirty-five years."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyager 1 reached the edge of the Solar System after about thirty-five years."
          }
        }
      }
