    "perspective.green_sahara.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Sahara naturally becomes green again as Earth's climate cycles continue."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وبطبيعة الحال، تصبح الصحراء خضراء مرة أخرى مع استمرار دورات مناخ الأرض."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Sàhara es torna verd de manera natural a mesura que continuen els cicles climàtics de la Terra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahara se přirozeně znovu zazelená, jak zemské klimatické cykly pokračují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahara bliver naturligt grønt igen, efterhånden som Jordens klimacyklusser fortsætter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sahara wird auf natürliche Weise wieder grün, wenn sich die Klimazyklen der Erde fortsetzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Σαχάρα γίνεται και πάλι πράσινη φυσικά καθώς συνεχίζονται οι κλιματικοί κύκλοι της Γης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Naturalmente, el Sahara vuelve a ser verde a medida que continúan los ciclos climáticos de la Tierra."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Naturalmente, el Sahara vuelve a ser verde a medida que continúan los ciclos climáticos de la Tierra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahara muuttuu luonnollisesti jälleen vihreäksi maapallon ilmastosyklien jatkuessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Sahara redevient naturellement vert à mesure que les cycles climatiques de la Terre se poursuivent."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Sahara redevient naturellement vert à mesure que les cycles climatiques de la Terre se poursuivent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסהרה הופכת שוב לירוקה באופן טבעי ככל שמחזורי האקלים של כדור הארץ ממשיכים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे-जैसे पृथ्वी का जलवायु चक्र जारी रहता है, सहारा प्राकृतिक रूप से फिर से हरा-भरा हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahara prirodno ponovno postaje zelena kako se Zemljini klimatski ciklusi nastavljaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Föld éghajlati ciklusaival a Szahara természetesen ismét zöldellni kezd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahara secara alami menjadi hijau kembali seiring dengan berlanjutnya siklus iklim bumi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Sahara diventa naturalmente di nuovo verde man mano che i cicli climatici della Terra continuano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地球の気候サイクルが続くと、サハラ砂漠は自然に再び緑になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지구의 기후 순환이 계속되면서 사하라 사막은 자연적으로 다시 녹색으로 변합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahara secara semula jadi menjadi hijau semula apabila kitaran iklim Bumi berterusan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahara blir naturlig grønt igjen ettersom jordens klimasykluser fortsetter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Sahara wordt op natuurlijke wijze weer groen naarmate de klimaatcycli op aarde voortduren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W miarę kontynuowania cykli klimatycznych na Ziemi Sahara w naturalny sposób ponownie staje się zielona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Saara torna-se naturalmente verde novamente à medida que os ciclos climáticos da Terra continuam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Saara torna-se naturalmente verde novamente à medida que os ciclos climáticos da Terra continuam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahara devine în mod natural din nou verde pe măsură ce ciclurile climatice ale Pământului continuă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сахара естественным образом снова становится зеленой, поскольку климатические циклы Земли продолжаются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahara sa prirodzene opäť stáva zelenou, keďže klimatické cykly Zeme pokračujú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahara blir naturligt grönt igen när jordens klimatcykler fortsätter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซาฮาราจะกลายเป็นสีเขียวตามธรรมชาติอีกครั้งเมื่อวัฏจักรสภาพภูมิอากาศของโลกดำเนินต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünya'nın iklim döngüleri devam ettikçe Sahra doğal olarak yeniden yeşile dönüyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сахара природним чином знову стає зеленою, оскільки кліматичні цикли Землі тривають."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahara tự nhiên trở nên xanh tươi trở lại khi chu kỳ khí hậu của Trái đất tiếp tục diễn ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随着地球气候循环的继续，撒哈拉沙漠自然会再次变绿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨著地球氣候循環的持續，撒哈拉沙漠自然會再次變綠。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The Sahara naturally becomes green again as Earth's climate cycles continue."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The Sahara naturally becomes green again as Earth's climate cycles continue."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Sahara naturally becomes green again as Earth's climate cycles continue."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "The Sahara naturally becomes green again as Earth's climate cycles continue."
          }
        }
      }
    },
