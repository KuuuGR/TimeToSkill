    "perspective.oak_tree_maturity.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An oak tree becomes mature after about twenty years."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصبح شجرة البلوط ناضجة بعد حوالي عشرين عامًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un roure madura després d'uns vint anys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dub dospívá asi po dvaceti letech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et egetræ bliver modent efter omkring tyve år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Eiche wird nach etwa zwanzig Jahren ausgewachsen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια βελανιδιά ωριμάζει μετά από είκοσι περίπου χρόνια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un roble alcanza la madurez al cabo de unos veinte años."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un roble alcanza la madurez al cabo de unos veinte años."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tammi on kypsä noin kahdenkymmenen vuoden kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chêne devient mature au bout d'une vingtaine d'années."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chêne devient mature au bout d'une vingtaine d'années."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עץ אלון מתבגר לאחר כעשרים שנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ओक का पेड़ लगभग बीस वर्षों के बाद परिपक्व होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hrast postaje zreo nakon dvadesetak godina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tölgy körülbelül húsz év múlva válik éretté."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohon ek menjadi dewasa setelah sekitar dua puluh tahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una quercia diventa matura dopo circa vent'anni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "樫の木は約20年を経て成熟します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참나무는 약 20년 정도 지나면 성숙해진다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokok oak menjadi matang selepas kira-kira dua puluh tahun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et eiketre blir modent etter omtrent tjue år."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een eik wordt na ongeveer twintig jaar volwassen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dąb dojrzewa po około dwudziestu latach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um carvalho amadurece depois de cerca de vinte anos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um carvalho amadurece depois de cerca de vinte anos."
          }
        },
        "ro": {
          "stringUnit": {
