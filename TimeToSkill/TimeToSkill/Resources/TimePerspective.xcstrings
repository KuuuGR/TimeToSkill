{
  "sourceLanguage": "en",
  "strings": {
    "perspective.ancient_oak.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some oak trees can live for more than five centuries."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لبعض أشجار البلوط أن تعيش لأكثر من خمسة قرون."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns roures poden viure més de cinc segles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé duby mohou žít déle než pět století."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle egetræer kan leve i mere end fem århundreder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Eichen können mehr als fünf Jahrhunderte alt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένες βελανιδιές μπορούν να ζήσουν για περισσότερους από πέντε αιώνες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos robles pueden vivir más de cinco siglos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos robles pueden vivir más de cinco siglos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotkut tammet voivat elää yli viisi vuosisataa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains chênes peuvent vivre plus de cinq siècles."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains chênes peuvent vivre plus de cinq siècles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה עצי אלון יכולים לחיות יותר מחמש מאות שנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ ओक के पेड़ पाँच शताब्दियों से भी अधिक समय तक जीवित रह सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neki hrastovi mogu živjeti više od pet stoljeća."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyes tölgyfák több mint öt évszázadig élhetnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa pohon ek dapat hidup lebih dari lima abad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune querce possono vivere più di cinque secoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オークの木の中には5世紀以上生きるものもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 참나무는 5세기 이상 살 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesetengah pokok oak boleh hidup selama lebih daripada lima abad."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen eiketrær kan leve i mer enn fem århundrer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige eikenbomen kunnen meer dan vijf eeuwen leven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre dęby mogą żyć dłużej niż pięć stuleci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns carvalhos podem viver mais de cinco séculos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns carvalhos podem viver mais de cinco séculos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unii stejari pot trăi mai mult de cinci secole."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые дубы могут жить более пяти столетий."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektoré duby môžu žiť viac ako päť storočí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa ekar kan leva i mer än fem århundraden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้นโอ๊กบางต้นสามารถมีชีวิตอยู่ได้นานกว่าห้าศตวรรษ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı meşe ağaçları beş yüzyıldan fazla yaşayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі дуби можуть жити більше п'яти століть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số cây sồi có thể sống hơn năm thế kỷ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些橡树可以存活五个多世纪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些橡樹可以存活五個多世紀。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Some oak trees can live for more than five centuries."
          }
        },
        "en-CA": {
          "stringUnit": {
