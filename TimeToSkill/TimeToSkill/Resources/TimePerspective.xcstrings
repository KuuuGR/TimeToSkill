    "perspective.elephant_pregnancy.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An elephant pregnancy lasts about 22 months."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر حمل الفيل حوالي 22 شهرًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'embaràs d'un elefant dura uns 22 mesos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sloní březost trvá asi 22 měsíců."
          }
        },
