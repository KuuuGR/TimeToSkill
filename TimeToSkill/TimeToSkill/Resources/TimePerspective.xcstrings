    "perspective.bamboo_growth.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some bamboo species reach full height in about two years."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصل بعض أنواع الخيزران إلى الارتفاع الكامل خلال عامين تقريبًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunes espècies de bambú aconsegueixen l'alçada total en uns dos anys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé druhy bambusu dosáhnou plné výšky asi za dva roky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle bambusarter når fuld højde på omkring to år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Bambusarten erreichen ihre volle Höhe nach etwa zwei Jahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μερικά είδη μπαμπού φτάνουν σε πλήρες ύψος σε περίπου δύο χρόνια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas especies de bambú alcanzan su altura máxima en unos dos años."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas especies de bambú alcanzan su altura máxima en unos dos años."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotkut bambulajit saavuttavat täyden korkeuden noin kahdessa vuodessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines espèces de bambous atteignent leur pleine hauteur en deux ans environ."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines espèces de bambous atteignent leur pleine hauteur en deux ans environ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק ממיני הבמבוק מגיעים לגובה מלא תוך כשנתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बांस की कुछ प्रजातियाँ लगभग दो वर्षों में पूरी ऊंचाई तक पहुँच जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neke vrste bambusa dosegnu punu visinu za oko dvije godine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyes bambuszfajok körülbelül két év alatt érik el a teljes magasságot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa spesies bambu mencapai ketinggian penuh dalam waktu sekitar dua tahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune specie di bambù raggiungono la massima altezza in circa due anni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "竹の種類によっては、約 2 年で完全な高さに達するものもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 대나무 종은 약 2년 안에 최대 높이에 도달합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesetengah spesies buluh mencapai ketinggian penuh dalam kira-kira dua tahun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen bambusarter når full høyde på omtrent to år."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige bamboesoorten bereiken hun volledige hoogte in ongeveer twee jaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre gatunki bambusa osiągają pełną wysokość po około dwóch latach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas espécies de bambu atingem a altura máxima em cerca de dois anos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas espécies de bambu atingem a altura máxima em cerca de dois anos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele specii de bambus ating înălțimea maximă în aproximativ doi ani."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые виды бамбука достигают полной высоты примерно за два года."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
