    "perspective.red_wine.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many red wines mature for about two years."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنضج العديد من أنواع النبيذ الأحمر لمدة عامين تقريبًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Molts vins negres maduren durant uns dos anys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mnoho červených vín zraje zhruba dva roky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mange rødvine modner i omkring to år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viele Rotweine reifen etwa zwei Jahre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πολλά κόκκινα κρασιά ωριμάζουν για περίπου δύο χρόνια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muchos vinos tintos maduran durante unos dos años."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Muchos vinos tintos maduran durante unos dos años."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Monet punaviinit kypsyvät noin kaksi vuotta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De nombreux vins rouges vieillissent pendant environ deux ans."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
