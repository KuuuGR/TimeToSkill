    "perspective.around_the_world.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A classic round-the-world journey takes about eighty days."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستغرق الرحلة الكلاسيكية حول العالم حوالي ثمانين يومًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clàssic viatge al voltant del món dura uns vuitanta dies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasická cesta kolem světa trvá asi osmdesát dní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En klassisk jordomrejse tager omkring firs dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine klassische Weltumrundung dauert etwa achtzig Tage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα κλασικό ταξίδι σε όλο τον κόσμο διαρκεί περίπου ογδόντα ημέρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clásica vuelta al mundo dura unos ochenta días."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La clásica vuelta al mundo dura unos ochenta días."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Klassinen maailmanympärimatka kestää noin kahdeksankymmentä päivää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour du monde classique dure environ quatre-vingts jours."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour du monde classique dure environ quatre-vingts jours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסע מסביב לעולם קלאסי אורך כשמונים יום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दुनिया भर की एक क्लासिक यात्रा में लगभग अस्सी दिन लगते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasično putovanje oko svijeta traje osamdesetak dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy klasszikus világkörüli utazás körülbelül nyolcvan napig tart."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perjalanan klasik keliling dunia memakan waktu sekitar delapan puluh hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un classico giro del mondo dura circa ottanta giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古典的な世界一周の旅には約 80 日かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전형적인 세계 일주 여행은 약 80일 정도 걸립니다."
          }
        },
        "ms": {
          "stringUnit": {
