    "perspective.sunlight_earth.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light from the Sun reaches Earth in about 8 minutes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصل ضوء الشمس إلى الأرض في حوالي 8 دقائق."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La llum del Sol arriba a la Terra en uns 8 minuts."
          }
