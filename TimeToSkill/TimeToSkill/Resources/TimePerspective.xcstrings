    "perspective.helicopter_flight.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sightseeing helicopter flight usually lasts about two hours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستغرق رحلة الهليكوبتر لمشاهدة معالم المدينة عادةً حوالي ساعتين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol turístic en helicòpter sol durar unes dues hores."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhlídkový let vrtulníkem obvykle trvá asi dvě hodiny."
