    "perspective.christmas_tree.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Christmas tree grows to harvest size in about five years."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنمو شجرة عيد الميلاد لتبلغ حجم الحصاد في حوالي خمس سنوات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un arbre de Nadal creix fins a la mida de la collita en uns cinc anys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vánoční stromek doroste do sklizňové velikosti asi za pět let."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et juletræ vokser til høststørrelse på cirka fem år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Weihnachtsbaum erreicht in etwa fünf Jahren Erntegröße."
