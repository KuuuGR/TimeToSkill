    "perspective.mars_journey.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A spacecraft typically reaches Mars in about seven months."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصل المركبة الفضائية عادة إلى المريخ في حوالي سبعة أشهر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nau espacial normalment arriba a Mart en uns set mesos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosmická loď obvykle dosáhne Marsu přibližně za sedm měsíců."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et rumfartøj når typisk Mars på omkring syv måneder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalerweise erreicht eine Raumsonde den Mars in etwa sieben Monaten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα διαστημόπλοιο συνήθως φτάνει στον Άρη σε περίπου επτά μήνες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente, una nave espacial llega a Marte en unos siete meses."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente, una nave espacial llega a Marte en unos siete meses."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaruusalus saavuttaa Marsin yleensä noin seitsemässä kuukaudessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vaisseau spatial atteint généralement Mars en sept mois environ."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vaisseau spatial atteint généralement Mars en sept mois environ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חללית מגיעה בדרך כלל למאדים תוך כשבעה חודשים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक अंतरिक्ष यान आम तौर पर लगभग सात महीने में मंगल ग्रह पर पहुंचता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svemirska letjelica obično stigne do Marsa za oko sedam mjeseci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy űrszonda általában körülbelül hét hónap alatt éri el a Marsot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah pesawat ruang angkasa biasanya mencapai Mars dalam waktu sekitar tujuh bulan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una navicella spaziale raggiunge tipicamente Marte in circa sette mesi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "宇宙船は通常、約 7 か月で火星に到着します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우주선은 일반적으로 약 7개월 만에 화성에 도착합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah kapal angkasa biasanya sampai ke Marikh dalam masa tujuh bulan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et romfartøy når vanligvis Mars på omtrent syv måneder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ruimtevaartuig bereikt Mars doorgaans binnen ongeveer zeven maanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statek kosmiczny zwykle dociera do Marsa w ciągu około siedmiu miesięcy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma espaçonave normalmente chega a Marte em cerca de sete meses."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma espaçonave normalmente chega a Marte em cerca de sete meses."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O navă spațială ajunge de obicei pe Marte în aproximativ șapte luni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Космический корабль обычно достигает Марса примерно за семь месяцев."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kozmická loď zvyčajne dosiahne Mars približne za sedem mesiacov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En rymdfarkost når vanligtvis Mars på cirka sju månader."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โดยทั่วไปยานอวกาศจะไปถึงดาวอังคารภายในเวลาประมาณเจ็ดเดือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uzay aracı genellikle yaklaşık yedi ayda Mars'a ulaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зазвичай космічний корабель досягає Марса приблизно за сім місяців."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
