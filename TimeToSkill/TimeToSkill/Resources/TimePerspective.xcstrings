    "perspective.scotch_whisky.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scotch whisky must mature for at least three years."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن ينضج الويسكي الاسكتلندي لمدة ثلاث سنوات على الأقل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El whisky escocès ha de madurar almenys tres anys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skotská whisky musí zrát minimálně tři roky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skotsk whisky skal modnes i mindst tre år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scotch Whisky muss mindestens drei Jahre reifen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σκωτσέζικο ουίσκι πρέπει να ωριμάσει για τουλάχιστον τρία χρόνια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El whisky escocés debe madurar durante al menos tres años."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El whisky escocés debe madurar durante al menos tres años."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skotlantilaisen viskin tulee kypsyä vähintään kolme vuotta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le whisky écossais doit mûrir pendant au moins trois ans."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le whisky écossais doit mûrir pendant au moins trois ans."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "וויסקי סקוטי חייב להתבגר לפחות שלוש שנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॉच व्हिस्की को कम से कम तीन साल तक परिपक्व होना चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
