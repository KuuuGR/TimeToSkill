    "perspective.rice_cooking.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rice cooks on the stove in about twenty minutes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطهى الأرز على الموقد في حوالي عشرين دقيقة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'arròs es cuina als fogons en uns vint minuts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rýže se vaří na sporáku asi za dvacet minut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ris koger på komfuret på cirka tyve minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reis gart auf dem Herd in etwa zwanzig Minuten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ρύζι ψήνεται στη σόμπα σε περίπου είκοσι λεπτά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El arroz se cuece en la estufa en unos veinte minutos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El arroz se cuece en la estufa en unos veinte minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Riisi kypsyy liedellä noin kahdessakymmenessä minuutissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le riz cuit sur la cuisinière en une vingtaine de minutes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le riz cuit sur la cuisinière en une vingtaine de minutes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אורז מתבשל על הכיריים תוך כעשרים דקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चूल्हे पर चावल लगभग बीस मिनट में पक जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Riža se kuha na štednjaku dvadesetak minuta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rizs körülbelül húsz perc alatt megsül a tűzhelyen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasi dimasak di atas kompor dalam waktu sekitar dua puluh menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riso cuoce sul fuoco in circa venti minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お米はコンロで約20分で炊き上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밥은 약 20분 안에 스토브에서 요리됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasi masak di atas dapur dalam kira-kira dua puluh minit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ris koker på komfyren på omtrent tjue minutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rijst kookt in ongeveer twintig minuten op het fornuis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryż gotuje się na kuchence w około dwadzieścia minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arroz cozinha no fogão em cerca de vinte minutos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O arroz cozinha no fogão em cerca de vinte minutos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Orezul se gătește pe aragaz în aproximativ douăzeci de minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рис варится на плите примерно двадцать минут."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryža sa uvarí na sporáku asi za dvadsať minút."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ris kokar på spisen på cirka tjugo minuter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หุงข้าวบนเตาในเวลาประมาณยี่สิบนาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirinç ocakta yaklaşık yirmi dakikada pişer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рис вариться на плиті приблизно двадцять хвилин."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cơm chín trên bếp trong khoảng hai mươi phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "米饭在炉子上煮大约二十分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "米飯在爐子上煮大約二十分鐘。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Rice cooks on the stove in about twenty minutes."
          }
        },
        "en-CA": {
          "stringUnit": {
