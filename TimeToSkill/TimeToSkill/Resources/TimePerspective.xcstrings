            "value": "New Horizons dosiahli Pluto asi za deväť a pol roka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "New Horizons nådde Pluto på ungefär nio och ett halvt år."
          }
        },
        "th": {
          "stringUnit": {
