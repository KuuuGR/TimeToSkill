    "perspective.movie.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watching a feature film usually takes about two hours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستغرق مشاهدة الفيلم الروائي عادةً حوالي ساعتين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Veure un llargmetratge sol durar unes dues hores."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledování celovečerního filmu obvykle trvá asi dvě hodiny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At se en spillefilm tager normalt omkring to timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ansehen eines Spielfilms dauert normalerweise etwa zwei Stunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η παρακολούθηση μιας ταινίας μεγάλου μήκους διαρκεί συνήθως περίπου δύο ώρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver una película suele durar unas dos horas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver una película suele durar unas dos horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitkän elokuvan katsominen kestää yleensä noin kaksi tuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarder un long métrage prend généralement environ deux heures."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarder un long métrage prend généralement environ deux heures."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צפייה בסרט עלילתי אורכת בדרך כלל כשעתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक फीचर फिल्म देखने में आमतौर पर लगभग दो घंटे लगते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gledanje igranog filma obično traje oko dva sata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy játékfilm megtekintése általában körülbelül két órát vesz igénybe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menonton film layar lebar biasanya memakan waktu sekitar dua jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La visione di un lungometraggio dura solitamente circa due ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長編映画を観るには通常約 2 時間かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장편 영화를 보는 데는 보통 두 시간 정도 걸립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menonton filem cereka biasanya mengambil masa kira-kira dua jam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å se en spillefilm tar vanligvis rundt to timer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bekijken van een speelfilm duurt doorgaans ongeveer twee uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglądanie filmu fabularnego zajmuje zwykle około dwóch godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistir a um longa-metragem geralmente leva cerca de duas horas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistir a um longa-metragem geralmente leva cerca de duas horas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizionarea unui lungmetraj durează de obicei aproximativ două ore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотр художественного фильма обычно занимает около двух часов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozeranie celovečerného filmu zvyčajne trvá približne dve hodiny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att se en långfilm tar vanligtvis cirka två timmar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การชมภาพยนตร์มักใช้เวลาประมาณสองชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun metrajlı bir filmi izlemek genellikle yaklaşık iki saat sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зазвичай перегляд художнього фільму займає близько двох годин."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem một bộ phim truyện thường mất khoảng hai giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观看一部故事片通常需要两个小时左右。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀看一部長片通常需要兩個小時左右。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Watching a feature film usually takes about two hours."
          }
        },
        "en-CA": {
          "stringUnit": {
