    "perspective.pizza_delivery.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizza is often delivered within about 30 minutes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غالبًا ما يتم تسليم البيتزا في غضون 30 دقيقة تقريبًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La pizza sovint es lliura en uns 30 minuts."
