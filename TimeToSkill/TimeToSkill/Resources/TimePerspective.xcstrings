    "perspective.camino_de_santiago.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking a legendary historic pilgrimage trail takes about one week."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق المشي على طريق الحج التاريخي الأسطوري حوالي أسبوع واحد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminar per un llegendari camí de pelegrinatge històric dura aproximadament una setmana."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Procházka legendární historickou poutní stezkou trvá asi týden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At gå en legendarisk historisk pilgrimssti tager omkring en uge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wanderung auf einem legendären historischen Pilgerweg dauert etwa eine Woche."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περπάτημα σε ένα θρυλικό ιστορικό μονοπάτι προσκυνήματος διαρκεί περίπου μία εβδομάδα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorrer un legendario e histórico sendero de peregrinación lleva aproximadamente una semana."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorrer un legendario e histórico sendero de peregrinación lleva aproximadamente una semana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Legendaarisen historiallisen pyhiinvaellusreitin käveleminen kestää noin viikon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourir un chemin de pèlerinage historique légendaire prend environ une semaine."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourir un chemin de pèlerinage historique légendaire prend environ une semaine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הליכה בשביל עלייה לרגל היסטורי אגדי נמשכת כשבוע אחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक प्रसिद्ध ऐतिहासिक तीर्थयात्रा मार्ग पर चलने में लगभग एक सप्ताह का समय लगता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pješačenje legendarnom povijesnom hodočasničkom stazom traje oko tjedan dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legendás történelmi zarándokút bejárása körülbelül egy hétig tart."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan di jalur ziarah bersejarah yang legendaris membutuhkan waktu sekitar satu minggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorrere un leggendario sentiero di pellegrinaggio storico dura circa una settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "伝説の歴史的な巡礼道を歩くには約 1 週間かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전설적인 역사 순례길을 걷는 데는 약 일주일이 걸립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan di denai ziarah bersejarah yang legenda mengambil masa kira-kira satu minggu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å gå en legendarisk historisk pilegrimssti tar omtrent en uke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het lopen van een legendarisch historisch pelgrimspad duurt ongeveer een week."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spacer legendarnym historycznym szlakiem pielgrzymkowym trwa około tygodnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorrer uma lendária trilha de peregrinação histórica leva cerca de uma semana."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorrer uma lendária trilha de peregrinação histórica leva cerca de uma semana."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plimbarea pe un traseu istoric legendar de pelerinaj durează aproximativ o săptămână."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогулка по легендарному историческому паломническому маршруту занимает около недели."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prechádzka legendárnym historickým pútnickým chodníkom trvá približne jeden týždeň."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att gå en legendarisk historisk pilgrimsled tar ungefär en vecka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเดินตามเส้นทางแสวงบุญทางประวัติศาสตร์ในตำนานจะใช้เวลาประมาณหนึ่งสัปดาห์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efsanevi tarihi hac yolunu yürümek yaklaşık bir hafta sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогулянка легендарною історичною стежкою паломництва займає близько тижня."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đi bộ trên con đường hành hương lịch sử huyền thoại mất khoảng một tuần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走一条传奇的历史朝圣之路大约需要一周的时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
