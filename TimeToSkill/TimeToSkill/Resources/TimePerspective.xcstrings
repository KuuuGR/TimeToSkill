    "perspective.giant_sequoia_youth.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A giant sequoia takes about eighty years to become well established."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستغرق شجرة السكويا العملاقة حوالي ثمانين عامًا حتى تصبح راسخة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sequoia gegant triga uns vuitanta anys a consolidar-se."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekvoji obrovské trvá asi osmdesát let, než se usadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En kæmpe sequoia tager omkring firs år at blive veletableret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es dauert etwa achtzig Jahre, bis sich ein Riesenmammutbaum gut etabliert hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια γιγάντια σεκόγια χρειάζεται περίπου ογδόντα χρόνια για να εδραιωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una secuoya gigante tarda unos ochenta años en consolidarse."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una secuoya gigante tarda unos ochenta años en consolidarse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jättimäisen sekvoian vakiintuminen kestää noin kahdeksankymmentä vuotta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un séquoia géant met environ quatre-vingts ans à s’établir."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un séquoia géant met environ quatre-vingts ans à s’établir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לסקויה ענקית לוקח כשמונים שנה להתבסס היטב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक विशाल सिकोइया को अच्छी तरह से स्थापित होने में लगभग अस्सी साल लगते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Divovskoj sekvoji treba oko osamdeset godina da se dobro ustali."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy óriás sequoia körülbelül nyolcvan évbe telik, amíg megerősödik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sequoia raksasa membutuhkan waktu sekitar delapan puluh tahun untuk menjadi kokoh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sequoia gigante impiega circa ottant'anni per stabilizzarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャイアントセコイアがしっかりと根付くには約80年かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자이언트 세쿼이아가 잘 자리잡기까지는 약 80년이 걸립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sequoia gergasi mengambil masa kira-kira lapan puluh tahun untuk menjadi mantap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En gigantisk sequoia tar omtrent åtti år å bli godt etablert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het duurt ongeveer tachtig jaar voordat een gigantische sequoia zich goed heeft gevestigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gigantyczna sekwoja potrzebuje około osiemdziesięciu lat, aby dobrze się zakorzenić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sequóia gigante leva cerca de oitenta anos para se estabelecer bem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sequóia gigante leva cerca de oitenta anos para se estabelecer bem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sequoia gigant durează aproximativ optzeci de ani pentru a deveni bine stabilit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гигантской секвойе требуется около восьмидесяти лет, чтобы прижиться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekvoji obrovskej trvá asi osemdesiat rokov, kým sa dobre etabluje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En gigantisk sequoia tar ungefär åttio år att bli väletablerad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้นซีคัวญ่ายักษ์ใช้เวลาประมาณแปดสิบปีจึงจะเติบโตได้ดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dev bir sekoyanın iyice yerleşmesi yaklaşık seksen yıl alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гігантській секвойї потрібно близько вісімдесяти років, щоб добре прижитися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cây sequoia khổng lồ phải mất khoảng tám mươi năm để phát triển tốt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一棵巨大的红杉大约需要八十年才能长成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一棵巨大的紅杉大約需要八十年才能長成。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A giant sequoia takes about eighty years to become well established."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A giant sequoia takes about eighty years to become well established."
          }
        },
        "en-GB": {
          "stringUnit": {
